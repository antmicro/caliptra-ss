     (caliptra_ss_top_tb.caliptra_ss_dut.fc_intr_otp_error   & ~caliptra_ss_top_tb.caliptra_ss_dut.mci_top_i.i_mci_reg_top.mci_reg_hwif_out.internal_agg_error_non_fatal_mask.mask_agg_error_non_fatal23) |
     (caliptra_ss_top_tb.caliptra_ss_dut.i3c_escalated_reset & ~caliptra_ss_top_tb.caliptra_ss_dut.mci_top_i.i_mci_reg_top.mci_reg_hwif_out.internal_agg_error_non_fatal_mask.mask_agg_error_non_fatal24) |
     (caliptra_ss_top_tb.caliptra_ss_dut.i3c_peripheral_reset & ~caliptra_ss_top_tb.caliptra_ss_dut.mci_top_i.i_mci_reg_top.mci_reg_hwif_out.internal_agg_error_non_fatal_mask.mask_agg_error_non_fatal25)
    ) |=> ##2 caliptra_ss_top_tb.caliptra_ss_dut.cptra_ss_all_error_non_fatal_o)
  ) else $display("SVA ERROR: AGG all_error_non_fatal is not set correctly");
  mci_fw_error_fatal_cold_rst_check: assert property (
    @(posedge caliptra_ss_top_tb.core_clk)
    (~caliptra_ss_top_tb.caliptra_ss_dut.cptra_ss_pwrgood_i |-> (caliptra_ss_top_tb.caliptra_ss_dut.mci_top_i.i_mci_reg_top.mci_reg_hwif_out.FW_ERROR_FATAL=='h0))
  ) else $display("SVA ERROR: MCI FW ERROR FATAL is expected to reset on cold reset");
  mci_fw_error_fatal_warm_rst_check: assert property (
    @(posedge caliptra_ss_top_tb.core_clk)
    disable iff (!caliptra_ss_top_tb.caliptra_ss_dut.cptra_ss_pwrgood_i)
    ((~caliptra_ss_top_tb.caliptra_ss_dut.cptra_ss_rst_b_i & caliptra_ss_top_tb.caliptra_ss_dut.cptra_ss_pwrgood_i) |-> ($stable(caliptra_ss_top_tb.caliptra_ss_dut.mci_top_i.i_mci_reg_top.mci_reg_hwif_out.FW_ERROR_FATAL)[*5]))
  ) else $display("SVA ERROR: MCI FW ERROR FATAL is expected to remain unchanged on warm reset");
  mci_fw_error_non_fatal_cold_rst_check: assert property (
    @(posedge caliptra_ss_top_tb.core_clk)
    (~caliptra_ss_top_tb.caliptra_ss_dut.cptra_ss_pwrgood_i |-> (caliptra_ss_top_tb.caliptra_ss_dut.mci_top_i.i_mci_reg_top.mci_reg_hwif_out.FW_ERROR_NON_FATAL=='h0))
  ) else $display("SVA ERROR: MCI FW ERROR NON FATAL is expected to reset on cold reset");
  mci_fw_error_non_fatal_warm_rst_check: assert property (
    @(posedge caliptra_ss_top_tb.core_clk)
    disable iff (!caliptra_ss_top_tb.caliptra_ss_dut.cptra_ss_pwrgood_i)
    ((~caliptra_ss_top_tb.caliptra_ss_dut.cptra_ss_rst_b_i & caliptra_ss_top_tb.caliptra_ss_dut.cptra_ss_pwrgood_i) |-> ($stable(caliptra_ss_top_tb.caliptra_ss_dut.mci_top_i.i_mci_reg_top.mci_reg_hwif_out.FW_ERROR_NON_FATAL)[*5]))
  ) else $display("SVA ERROR: MCI FW ERROR NON FATAL is expected to remain unchanged on warm reset");
  function dec_lc_state_e decode_lc_state(lc_state_e lc_state);
    unique case (lc_state)
      LcStRaw:           return DecLcStRaw;
      LcStTestUnlocked0: return DecLcStTestUnlocked0;
      LcStTestLocked0:   return DecLcStTestLocked0;
      LcStTestUnlocked1: return DecLcStTestUnlocked1;
      LcStTestLocked1:   return DecLcStTestLocked1;
      LcStTestUnlocked2: return DecLcStTestUnlocked2;
      LcStTestLocked2:   return DecLcStTestLocked2;
      LcStTestUnlocked3: return DecLcStTestUnlocked3;
      LcStTestLocked3:   return DecLcStTestLocked3;
      LcStTestUnlocked4: return DecLcStTestUnlocked4;
      LcStTestLocked4:   return DecLcStTestLocked4;
      LcStTestUnlocked5: return DecLcStTestUnlocked5;
      LcStTestLocked5:   return DecLcStTestLocked5;
      LcStTestUnlocked6: return DecLcStTestUnlocked6;
      LcStTestLocked6:   return DecLcStTestLocked6;
      LcStTestUnlocked7: return DecLcStTestUnlocked7;
      LcStDev:           return DecLcStDev;
      LcStProd:          return DecLcStProd;
      LcStProdEnd:       return DecLcStProdEnd;
      LcStRma:           return DecLcStRma;
      default:           return DecLcStScrap;
    endcase
  endfunction
  generate
  dec_lc_state_e dec_lc_state;
  assign dec_lc_state = decode_lc_state(lc_state_e'(caliptra_ss_top_tb.caliptra_ss_dut.u_otp_ctrl.otp_lc_data_o.state));
  for (genvar i = 0; i < NumPart-1; i++) begin
  end
  endgenerate
  logic [NumPartWidth-1:0] part_idx;
  assign part_idx = caliptra_ss_top_tb.caliptra_ss_dut.u_otp_ctrl.u_otp_ctrl_dai.part_idx;
  logic        part_may_have_digest, part_has_digest;
  int unsigned part_digest_word_addr;
  logic [21:0] raw_part_digest_value;
  logic        dai_addr_below_digest;
  logic        dai_access_error;
  assign part_may_have_digest  = PartInfo[part_idx].hw_digest || PartInfo[part_idx].sw_digest;
  assign part_digest_word_addr = otp_ctrl_part_pkg::digest_addrs[part_idx] / 2;
  assign raw_part_digest_value =
    caliptra_ss_top_tb.u_otp.u_prim_ram_1p_adv.u_mem.mem[part_digest_word_addr];
  assign part_has_digest       = part_may_have_digest && (raw_part_digest_value != 0);
  assign dai_addr_below_digest = (caliptra_ss_top_tb.caliptra_ss_dut.u_otp_ctrl.dai_addr >= PartInfo[part_idx].offset) &&
                                 (caliptra_ss_top_tb.caliptra_ss_dut.u_otp_ctrl.dai_addr < otp_ctrl_part_pkg::digest_addrs[part_idx]);
  assign dai_access_error = otp_err_e'(caliptra_ss_top_tb.caliptra_ss_dut.u_otp_ctrl.part_error[DaiIdx]) == AccessError;
  function bit is_zeroized(int part_idx);
    logic [ScrmblBlockWidth-1:0] zero_marker;
    if (part_idx < 0 || part_idx >= NumPart) begin
      return 0;  
    end else if (!PartInfo[part_idx].zeroizable) begin
      return 0;  
    end else begin
      zero_marker = {caliptra_ss_top_tb.u_otp.u_prim_ram_1p_adv.u_mem.mem[otp_ctrl_part_pkg::zero_addrs[part_idx]/2][15:0],
                     caliptra_ss_top_tb.u_otp.u_prim_ram_1p_adv.u_mem.mem[otp_ctrl_part_pkg::zero_addrs[part_idx]/2+1][15:0],
                     caliptra_ss_top_tb.u_otp.u_prim_ram_1p_adv.u_mem.mem[otp_ctrl_part_pkg::zero_addrs[part_idx]/2+2][15:0],
                     caliptra_ss_top_tb.u_otp.u_prim_ram_1p_adv.u_mem.mem[otp_ctrl_part_pkg::zero_addrs[part_idx]/2+3][15:0]};
      return (otp_ctrl_pkg::check_zeroized_valid(zero_marker));
    end
  endfunction : is_zeroized
  function bit data_and_ecc_zeroized(int part_idx, bit [OtpByteAddrWidth-1:0] addr);
    if (part_idx < 0 || part_idx >= NumPart) begin
      return 0;  
    end else if (!PartInfo[part_idx].zeroizable) begin
      return 0;  
    end else if (addr < PartInfo[part_idx].offset ||
                 addr > otp_ctrl_part_pkg::zero_addrs[part_idx]) begin
      return 0;  
    end else begin
      if (PartInfo[part_idx].secret) begin
        return &{caliptra_ss_top_tb.u_otp.u_prim_ram_1p_adv.u_mem.mem[addr/2],
                caliptra_ss_top_tb.u_otp.u_prim_ram_1p_adv.u_mem.mem[addr/2+1],
                caliptra_ss_top_tb.u_otp.u_prim_ram_1p_adv.u_mem.mem[addr/2+2],
                caliptra_ss_top_tb.u_otp.u_prim_ram_1p_adv.u_mem.mem[addr/2+3]};
      end else begin
        return &{caliptra_ss_top_tb.u_otp.u_prim_ram_1p_adv.u_mem.mem[addr/2],
                 caliptra_ss_top_tb.u_otp.u_prim_ram_1p_adv.u_mem.mem[addr/2+1]};
      end
    end
  endfunction : data_and_ecc_zeroized
  logic [OtpByteAddrWidth-1:0] past_dai_addr;
  logic [NumPartWidth-1:0]     past_part_idx;
  always_ff @(posedge caliptra_ss_top_tb.caliptra_ss_dut.u_otp_ctrl.clk_i) begin
    if (caliptra_ss_top_tb.caliptra_ss_dut.u_otp_ctrl.dai_req) begin
      past_dai_addr <= caliptra_ss_top_tb.caliptra_ss_dut.u_otp_ctrl.dai_addr;
      past_part_idx <= part_idx;
    end
  end
endmodule
`begin_keywords "1800-2023"
module rom #(
     parameter DEPTH      = 64
    ,parameter DATA_WIDTH = 32
    ,parameter ADDR_WIDTH = $clog2(DEPTH)
    )
    (
    input  logic                       clk_i,
    input  logic                       cs_i,
    input  logic                       we_i,
    input  logic [ADDR_WIDTH-1:0]      addr_i,
    input  logic [DATA_WIDTH-1:0]      wdata_i,
    output logic [DATA_WIDTH-1:0]      rdata_o
    );
    localparam NUM_BYTES = DATA_WIDTH/8 + ((DATA_WIDTH % 8) ? 1 : 0);
    logic [7:0] ram [DEPTH][NUM_BYTES-1:0];
    always @(posedge clk_i) begin
        if (cs_i & we_i) begin
            for (int i = 0; i < NUM_BYTES; i++) begin
                ram[addr_i][i] <= wdata_i[i*8 +: 8];
            end
        end
        if (cs_i & ~we_i) begin
            for (int i = 0; i < NUM_BYTES; i++) begin
                rdata_o[i*8 +: 8] <= ram[addr_i][i];
            end
        end
    end
endmodule
