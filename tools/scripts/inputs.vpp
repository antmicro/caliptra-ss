    output_lost_o,
    output_lost_we_o,
    output_valid_o,
    output_valid_we_o,
    input_ready_o,
    input_ready_we_o
  });
  logic [NumOutBufBits-1:0] out, out_buf;
  assign out = {
    ctrl_we,
    ctrl_gcm_we,
    gcm_init_done,
    alert,
    data_in_we,
    data_out_sel,
    data_out_we,
    data_in_prev_sel,
    data_in_prev_we,
    state_in_sel,
    add_state_in_sel,
    add_state_out_sel,
    ctr_inc32,
    ctr_incr,
    cipher_in_valid,
    cipher_out_ready,
    cipher_crypt_out_buf,
