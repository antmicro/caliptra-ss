    error: 1'b1
  };
  typedef enum logic [7:0] {
    ErrNone = 8'h 00,
    ErrKeyNotValid = 8'h 01,
    ErrSwPushedMsgFifo = 8'h 02,
    ErrSwIssuedCmdInAppActive = 8'h 03,
    ErrWaitTimerExpired = 8'h 04,
    ErrIncorrectEntropyMode = 8'h 05,
