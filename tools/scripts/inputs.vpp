package controller_pkg;
  parameter int unsigned I2cAcqByteIdWidth = 3;
  typedef enum logic [I2cAcqByteIdWidth-1:0] {
    AcqData      = 3'b000,
    AcqStart     = 3'b001,
    AcqStop      = 3'b010,
    AcqRestart   = 3'b011,
    AcqNack      = 3'b100,
    AcqNackStart = 3'b101,
    AcqNackStop  = 3'b110
  } i2c_acq_byte_id_e;
  parameter int unsigned FmtFifoWidth = 8 + 5;
  parameter int unsigned RxFifoWidth = 8;
  parameter int unsigned TxFifoWidth = 8;
  parameter int unsigned IbiFifoWidth = 8;
  parameter int unsigned AcqFifoWidth = I2cAcqByteIdWidth + 8;
  parameter int I2CFifoDepth = 64;
  localparam int I2CFifoDepthWidth = $clog2(I2CFifoDepth + 1);
  typedef struct packed {logic err_0;} i3c_err_t;
  typedef struct packed {logic irq_0;} i3c_irq_t;
  typedef enum logic {
    Write = 1'b0,
    Read  = 1'b1
  } cmd_transfer_dir_e;
  typedef struct packed {
    logic [4:0] __rsvd63_59;
    logic [7:0] autocmd_hdr_code;
    logic [2:0] autocmd_mode;
    logic [7:0] autocmd_value;
    logic [7:0] autocmd_mask;
    logic device;
    logic [1:0] dev_nack_retry_cnt;
    logic [2:0] ring_id;
    logic [1:0] __rsvd25_24;
    logic [7:0] dynamic_address;
    logic ts;
    logic crr_reject;
    logic ibi_reject;
    logic ibi_payload;
    logic [4:0] __rsvd11_7;
    logic [6:0] static_address;
  } dat_entry_t;
endpackage
`begin_keywords "1800-2023"
package i3c_pkg;
  localparam logic [6:0] TE0_RSVD_ADDR_W [7] = '{
    7'h3E,   
    7'h5E,   
    7'h6E,   
    7'h76,   
    7'h7A,   
    7'h7C,   
    7'h7F    
  };
  localparam logic [6:0] TE0_RSVD_ADDR_R = 7'h7E;   
  function automatic logic is_te0_rsvd_addr_err(
    input logic [6:0] addr,
    input logic       rnw
  );
    if (addr == TE0_RSVD_ADDR_R && rnw) begin
      return 1'b1;
    end
    if (!rnw) begin
      for (int i = 0; i < 7; i++) begin
        if (addr == TE0_RSVD_ADDR_W[i]) begin
          return 1'b1;
        end
      end
    end
    return 1'b0;
  endfunction : is_te0_rsvd_addr_err
  function automatic logic is_i3c_rsvd_addr(
    input logic [6:0] addr
  );
    return addr inside {[7'h00:7'h07], 7'h3E, 7'h5E, 7'h6E, 7'h76, [7'h78:7'h7F]};
  endfunction : is_i3c_rsvd_addr
  localparam int unsigned RespErrIdWidth = 4;
  localparam int unsigned DatAw = $clog2(128);
  localparam int unsigned DctAw = $clog2(128);
