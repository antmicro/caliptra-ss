module css_mcu0_el2_dec_gpr_ctl
import css_mcu0_el2_pkg::*;
#(
parameter css_mcu0_el2_param_t pt = 2291'
 )  (
    input logic [4:0]  raddr0,        
    input logic [4:0]  raddr1,
    input logic        wen0,          
    input logic [4:0]  waddr0,        
    input logic [31:0] wd0,           
    input logic        wen1,          
    input logic [4:0]  waddr1,        
    input logic [31:0] wd1,           
    input logic        wen2,          
    input logic [4:0]  waddr2,        
    input logic [31:0] wd2,           
    input logic        clk,
    input logic        rst_l,
    output logic [31:0] rd0,          
    output logic [31:0] rd1,
    input  logic        scan_mode
);
   logic [31:1] [31:0] gpr_out;       
   logic [31:1] [31:0] gpr_in;
   logic [31:1] w0v,w1v,w2v;
   logic [31:1] gpr_wr_en;
   assign gpr_wr_en[31:1] = (w0v[31:1] | w1v[31:1] | w2v[31:1]);
   for ( genvar j=1; j<32; j++ )  begin : gpr
      css_mcu0_rvdffe #(32) gprff (.*, .en(gpr_wr_en[j]), .din(gpr_in[j][31:0]), .dout(gpr_out[j][31:0]));
   end : gpr
   always_comb begin
      rd0[31:0] = 32'b0;
      rd1[31:0] = 32'b0;
      w0v[31:1] = 31'b0;
      w1v[31:1] = 31'b0;
      w2v[31:1] = 31'b0;
      gpr_in[31:1] = '0;
      for (int j=1; j<32; j++ )  begin
         rd0[31:0] |= ({32{(raddr0[4:0]== 5'(j))}} & gpr_out[j][31:0]);
         rd1[31:0] |= ({32{(raddr1[4:0]== 5'(j))}} & gpr_out[j][31:0]);
      end
     for (int j=1; j<32; j++ )  begin
         w0v[j]     = wen0  & (waddr0[4:0]== 5'(j) );
         w1v[j]     = wen1  & (waddr1[4:0]== 5'(j) );
         w2v[j]     = wen2  & (waddr2[4:0]== 5'(j) );
         gpr_in[j]  =    ({32{w0v[j]}} & wd0[31:0]) |
                         ({32{w1v[j]}} & wd1[31:0]) |
                         ({32{w2v[j]}} & wd2[31:0]);
     end
   end  
endmodule
