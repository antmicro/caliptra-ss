  assign prefix_1_we = addr_hit[9] & reg_we & !reg_error;
  assign prefix_1_wd = reg_wdata[31:0];
  assign prefix_2_we = addr_hit[10] & reg_we & !reg_error;
  assign prefix_2_wd = reg_wdata[31:0];
