`begin_keywords "1800-2023"
interface axi_mem_if #(parameter integer ADDR_WIDTH = 16, parameter integer DATA_WIDTH = 32) (input logic clk, input logic rst_b);
    typedef struct packed {
        logic [DATA_WIDTH-1:0]  data;
    } sram_data_t;
    typedef struct packed {
        logic cs;
        logic we;
        logic [ADDR_WIDTH-1:0] addr;
        sram_data_t wdata;
    } sram_req_t;
    typedef struct packed {
        sram_data_t rdata;
    } sram_resp_t;
    sram_req_t req;
    sram_resp_t resp;
    modport request (
        output  req,
        input   resp
    );
    modport response (
        input  req,
        output   resp
    );
endinterface
`begin_keywords "1800-2023"
module axi_mem #(
    parameter AW = 32,
    parameter DW = 64,
              BC = DW/8,        
              BW = $clog2(BC),  
    parameter UW = 32,          
    parameter IW = 1,           
              ID_NUM = 1 << IW,  
    parameter EX_EN = 0     
)
(
    input clk,
    input rst_n,
    axi_if.w_sub s_axi_w_if,
    axi_if.r_sub s_axi_r_if,
    axi_mem_if.request s_mem_req_if
);
logic          dv;
logic [AW-1:0] addr;  
logic          write;
logic [DW-1:0] wdata;  
logic [DW-1:0] rdata;  
logic          req_hold;
logic          rd_error;
logic          wr_error;
axi_sub #(
    .AW   (AW   ),
    .DW   (DW   ),
    .UW   (UW   ),
    .IW   (IW   ),
    .EX_EN(EX_EN),
    .C_LAT(1    )
) i_axi_sub (
    .clk  (clk     ),
    .rst_n(rst_n   ),
    .s_axi_w_if(s_axi_w_if),
    .s_axi_r_if(s_axi_r_if),
    .dv      (dv      ),
    .addr    (addr    ),  
    .write   (write   ),
    .user    (        ),
    .id      (        ),
    .wdata   (wdata   ),
    .wstrb   (        ),
    .rdata   (rdata   ),
    .last    (        ),
    .size    (        ),
    .hld     (req_hold),
    .rd_err  (rd_error),
    .wr_err  (wr_error)
);
assign req_hold = 1'b0;
assign rd_error = 1'b0;
assign wr_error = 1'b0;
assign s_mem_req_if.req.cs   = dv;
assign s_mem_req_if.req.we   = write;
assign s_mem_req_if.req.addr = addr[AW-1:BW];
