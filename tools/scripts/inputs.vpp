  ast_dif_t [NumAlerts-1:0] alerts_trig;
} ast_alert_rsp_t;
typedef enum logic {
  ImmAck = 0,
  SwAck  = 1
} ast_ack_mode_e;
typedef struct packed {
  logic     usb;
  logic     sys;
  logic     io;
  logic     aon;
} clks_osc_byp_t;
typedef enum logic [4-1:0] {
  ObsNon = 4'h0,   
  ObsAst = 4'h1,   
  ObsFla = 4'h2,   
  ObsOtp = 4'h3,   
  ObsOt0 = 4'h4,   
  ObsOt1 = 4'h5,   
  ObsOt2 = 4'h6,   
  ObsOt3 = 4'h7,   
  ObsRs0 = 4'h8,   
  ObsRs1 = 4'h9,   
  ObsRs2 = 4'hA,   
  ObsRs3 = 4'hB,   
  ObsRs4 = 4'hC,   
  ObsRs5 = 4'hD,   
  ObsRs6 = 4'hE,   
  ObsRs7 = 4'hF    
} ast_omdl_e;
typedef struct packed {
  logic [4-1:0]          obgsl;
  ast_omdl_e             obmsl;
