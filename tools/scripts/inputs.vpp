     mci_reg_hwif_out.AGG_ERROR_FATAL.agg_error_fatal11.value,mci_reg_hwif_out.AGG_ERROR_FATAL.agg_error_fatal10.value,mci_reg_hwif_out.AGG_ERROR_FATAL.agg_error_fatal9.value, mci_reg_hwif_out.AGG_ERROR_FATAL.agg_error_fatal8.value,
     mci_reg_hwif_out.AGG_ERROR_FATAL.agg_error_fatal7.value, mci_reg_hwif_out.AGG_ERROR_FATAL.agg_error_fatal6.value, mci_reg_hwif_out.AGG_ERROR_FATAL.agg_error_fatal5.value, mci_reg_hwif_out.AGG_ERROR_FATAL.agg_error_fatal4.value,
     mci_reg_hwif_out.AGG_ERROR_FATAL.agg_error_fatal3.value, mci_reg_hwif_out.AGG_ERROR_FATAL.agg_error_fatal2.value, mci_reg_hwif_out.AGG_ERROR_FATAL.agg_error_fatal1.value, mci_reg_hwif_out.AGG_ERROR_FATAL.agg_error_fatal0.value})  |
