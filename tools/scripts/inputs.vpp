always_comb security_state_debug_locked_edge = security_state_o.debug_locked ^ security_state_debug_locked_d;
always_ff @(posedge clk or negedge mci_rst_b) begin
    if (~mci_rst_b) begin
        scan_mode_f <= '0;
    end
