	ICCM_BANK_BITS         : 7'h02         ,
	ICCM_BANK_HI           : 9'h003        ,
	ICCM_BANK_INDEX_LO     : 9'h004        ,
	ICCM_BITS              : 9'h012        ,
	ICCM_ECC_WIDTH         : 7'h07         ,
	ICCM_ENABLE            : 5'h01         ,
	ICCM_ICACHE            : 5'h00         ,
	ICCM_INDEX_BITS        : 8'h0E         ,
	ICCM_NUM_BANKS         : 9'h004        ,
	ICCM_ONLY              : 5'h01         ,
	ICCM_REGION            : 8'h04         ,
	ICCM_SADR              : 36'h040000000  ,
	ICCM_SIZE              : 14'h0100       ,
	IFU_BUS_ID             : 5'h01         ,
	IFU_BUS_PRTY           : 6'h02         ,
	IFU_BUS_TAG            : 8'h03         ,
	INST_ACCESS_ADDR0      : 36'h000000000  ,
	INST_ACCESS_ADDR1      : 36'h000000000  ,
	INST_ACCESS_ADDR2      : 36'h000000000  ,
	INST_ACCESS_ADDR3      : 36'h000000000  ,
	INST_ACCESS_ADDR4      : 36'h000000000  ,
	INST_ACCESS_ADDR5      : 36'h000000000  ,
	INST_ACCESS_ADDR6      : 36'h000000000  ,
	INST_ACCESS_ADDR7      : 36'h000000000  ,
	INST_ACCESS_ENABLE0    : 5'h00         ,
	INST_ACCESS_ENABLE1    : 5'h00         ,
	INST_ACCESS_ENABLE2    : 5'h00         ,
	INST_ACCESS_ENABLE3    : 5'h00         ,
	INST_ACCESS_ENABLE4    : 5'h00         ,
	INST_ACCESS_ENABLE5    : 5'h00         ,
	INST_ACCESS_ENABLE6    : 5'h00         ,
	INST_ACCESS_ENABLE7    : 5'h00         ,
	INST_ACCESS_MASK0      : 36'h0FFFFFFFF  ,
	INST_ACCESS_MASK1      : 36'h0FFFFFFFF  ,
	INST_ACCESS_MASK2      : 36'h0FFFFFFFF  ,
	INST_ACCESS_MASK3      : 36'h0FFFFFFFF  ,
	INST_ACCESS_MASK4      : 36'h0FFFFFFFF  ,
	INST_ACCESS_MASK5      : 36'h0FFFFFFFF  ,
	INST_ACCESS_MASK6      : 36'h0FFFFFFFF  ,
	INST_ACCESS_MASK7      : 36'h0FFFFFFFF  ,
	LOAD_TO_USE_PLUS1      : 5'h00         ,
	LSU2DMA                : 5'h00         ,
	LSU_BUS_ID             : 5'h01         ,
	LSU_BUS_PRTY           : 6'h02         ,
	LSU_BUS_TAG            : 8'h03         ,
	LSU_NUM_NBLOAD         : 9'h004        ,
	LSU_NUM_NBLOAD_WIDTH   : 7'h02         ,
	LSU_SB_BITS            : 9'h012        ,
	LSU_STBUF_DEPTH        : 8'h04         ,
	NO_ICCM_NO_ICACHE      : 5'h00         ,
	PIC_2CYCLE             : 5'h00         ,
	PIC_BASE_ADDR          : 36'h060000000  ,
	PIC_BITS               : 9'h00F        ,
	PIC_INT_WORDS          : 8'h01         ,
	PIC_REGION             : 8'h06         ,
	PIC_SIZE               : 13'h0020       ,
	PIC_TOTAL_INT          : 12'h01F        ,
	PIC_TOTAL_INT_PLUS1    : 13'h0020       ,
	PMP_ENTRIES            : 11'h040        ,
	RET_STACK_SIZE         : 8'h08         ,
	SB_BUS_ID              : 5'h01         ,
	SB_BUS_PRTY            : 6'h02         ,
	SB_BUS_TAG             : 8'h01         ,
	SMEPMP                 : 4'h0          ,
	TIMER_LEGAL_EN         : 5'h01         ,
	USER_MODE              : 4'h0          
}
) (
    input veer_sram_error_injection_mode_t sram_error_injection_mode,
    el2_mem_if.veer_sram_sink el2_mem_export
);
    bit   [pt.ICCM_NUM_BANKS-1:0]          iccm_flip_bit;
    bit   [pt.DCCM_NUM_BANKS-1:0]          dccm_flip_bit;
    logic [pt.ICCM_NUM_BANKS-1:0] [39-1:0] iccm_sram_wdata_bitflip;
    logic [pt.DCCM_NUM_BANKS-1:0] [39-1:0] dccm_sram_wdata_bitflip;
    int ii,jj,kk,ll;
        always @(posedge el2_mem_export.clk) begin
            if ((~sram_error_injection_mode.iccm_single_bit_error && ~sram_error_injection_mode.iccm_double_bit_error)) begin
                iccm_sram_wdata_bitflip <= '{default:0};
            end
            else if (el2_mem_export.iccm_clken & el2_mem_export.iccm_wren_bank) begin
                for (kk = 0; kk < pt.ICCM_NUM_BANKS; kk++) begin
                    iccm_flip_bit[kk] <= ($urandom % 100) < 50;
                    iccm_sram_wdata_bitflip[kk] <= iccm_flip_bit[kk] ? get_bitflip_mask(sram_error_injection_mode.iccm_double_bit_error) : '0;
                end
            end
            if ((~sram_error_injection_mode.dccm_single_bit_error && ~sram_error_injection_mode.dccm_double_bit_error)) begin
                dccm_sram_wdata_bitflip <= '{default:0};
            end
            else if (el2_mem_export.dccm_clken & el2_mem_export.dccm_wren_bank) begin
                for (ll = 0; ll < pt.DCCM_NUM_BANKS; ll++) begin
                    dccm_flip_bit[ll] <= ($urandom % 100) < 50;
                    dccm_sram_wdata_bitflip[ll] <= dccm_flip_bit[ll] ? get_bitflip_mask(sram_error_injection_mode.dccm_double_bit_error) : '0;
                end
            end
        end
if (pt.DCCM_ENABLE == 1) begin: Gen_dccm_enable
localparam DCCM_INDEX_DEPTH = ((pt.DCCM_SIZE)*1024)/((pt.DCCM_BYTE_WIDTH)*(pt.DCCM_NUM_BANKS));   
for (genvar i=0; i<pt.DCCM_NUM_BANKS; i++) begin: dccm_loop
        el2_ram #(DCCM_INDEX_DEPTH,39)  ram (
                                  .ME  (el2_mem_export.dccm_clken[i]                                  ),
                                  .CLK (el2_mem_export.clk                                            ),
                                  .WE  (el2_mem_export.dccm_wren_bank[i]                              ),
                                  .ADR (el2_mem_export.dccm_addr_bank[i]                              ),
                                  .D   ({el2_mem_export.dccm_wr_ecc_bank[i][pt.DCCM_ECC_WIDTH-1:0],el2_mem_export.dccm_wr_data_bank[i][pt.DCCM_DATA_WIDTH-1:0]}  ^ dccm_sram_wdata_bitflip[i]),
                                  .Q   ({el2_mem_export.dccm_bank_ecc[i][pt.DCCM_ECC_WIDTH-1:0],el2_mem_export.dccm_bank_dout[i][pt.DCCM_DATA_WIDTH-1:0]}     ),
                                  .ROP (                                                              ),
                                  .TEST1   (1'b0   ), 
                                         .RME     (1'b0   ), 
                                         .RM      (4'b0000), 
                                         .LS      (1'b0   ), 
                                         .DS      (1'b0   ), 
                                         .SD      (1'b0   ), 
                                         .TEST_RNM(1'b0   ), 
                                         .BC1     (1'b0   ), 
                                         .BC2     (1'b0   ), 
                                  .*
                                  );
end : dccm_loop
end :Gen_dccm_enable
if (pt.ICCM_ENABLE) begin : Gen_iccm_enable
for (genvar i=0; i<pt.ICCM_NUM_BANKS; i++) begin: iccm_loop
    el2_ram #(.depth(1<<pt.ICCM_INDEX_BITS), .width(39)) iccm_bank (
                                     .ME  (el2_mem_export.iccm_clken[i]             ),
                                     .CLK (el2_mem_export.clk                       ),
                                     .WE  (el2_mem_export.iccm_wren_bank[i]         ),
                                     .ADR (el2_mem_export.iccm_addr_bank[i]         ),
                                     .D   ({el2_mem_export.iccm_bank_wr_ecc[i][pt.ICCM_ECC_WIDTH-1:0],el2_mem_export.iccm_bank_wr_data[i][31:0]} ^ iccm_sram_wdata_bitflip[i]),
                                     .Q   ({el2_mem_export.iccm_bank_ecc[i][pt.ICCM_ECC_WIDTH-1:0],el2_mem_export.iccm_bank_dout[i][31:0]}   ),
                                     .ROP (                                         ),
                                     .TEST1   (1'b0   ),
                                     .RME     (1'b0   ),
                                     .RM      (4'b0000),
                                     .LS      (1'b0   ),
                                     .DS      (1'b0   ),
                                     .SD      (1'b0   ) ,
                                     .TEST_RNM(1'b0   ),
                                     .BC1     (1'b0   ),
                                     .BC2     (1'b0   )
                                      );
end : iccm_loop
end : Gen_iccm_enable
endmodule
`begin_keywords "1800-2023"
`default_nettype none
module caliptra_top_tb_services
    import soc_ifc_pkg::*;
    import kv_defines_pkg::*;
    import caliptra_top_tb_pkg::*;
#(
    parameter UVM_TB = 0
) (
    input wire logic                   clk,
    input wire logic                   cptra_rst_b,
    el2_mem_if.veer_sram_sink          el2_mem_export,
    abr_mem_if.resp                    abr_memory_export,
    input  wire logic mbox_sram_cs,
    input  wire logic mbox_sram_we,
    input  wire logic [CPTRA_MBOX_ADDR_W-1:0] mbox_sram_addr,
    input  wire logic [CPTRA_MBOX_DATA_AND_ECC_W-1:0] mbox_sram_wdata,
    output wire logic [CPTRA_MBOX_DATA_AND_ECC_W-1:0] mbox_sram_rdata,
    input  wire logic imem_cs,
    input  wire logic [$clog2((98304 / (64/8)))-1:0] imem_addr,
    output logic [64-1:0] imem_rdata,
    output var security_state_t security_state,
    output logic scan_mode,
    output var   ras_test_ctrl_t ras_test_ctrl,
    output int   cycleCnt,
    output var   axi_complex_ctrl_t axi_complex_ctrl,
    output logic int_flag,
    output logic cycleCnt_smpl_en,
    output logic assert_hard_rst_flag,
    output logic assert_rst_flag,
    output logic deassert_hard_rst_flag,
    output logic deassert_rst_flag,
    output logic [0:16-1][31:0] cptra_uds_tb,
    output logic [0:8-1] [31:0] cptra_fe_tb,
    output logic [0:8-1][31:0] cptra_obf_key_tb,
    output logic [0:OCP_LOCK_HEK_NUM_DWORDS-1] [31:0] cptra_hek_tb,
    output logic axi_error_inj_en
);
endmodule
`begin_keywords "1800-2023"
module caliptra_top_tb_soc_bfm
import axi_pkg::*;
import soc_ifc_pkg::*;
import mbox_pkg::*;
import kv_defines_pkg::*;
import caliptra_top_tb_pkg::*; #(
    parameter SKIP_BRINGUP = 0
) (
    input logic core_clk,
    output logic                       cptra_pwrgood,
    output logic                       cptra_rst_b,
    output logic                       BootFSM_BrkPoint,
    input int                          cycleCnt,
    output logic [8-1:0][31:0]          cptra_obf_key,
    output logic [16-1:0][31:0]     cptra_csr_hmac_key,
    input  logic [0:16-1][31:0]          cptra_uds_rand,
    input  logic [0:8-1] [31:0]          cptra_fe_rand,
    input  logic [0:OCP_LOCK_HEK_NUM_DWORDS-1] [31:0]     cptra_hek_rand,
    input  logic [0:8-1][31:0]          cptra_obf_key_tb,
    axi_if m_axi_bfm_if,
    output logic [15:0] strap_ss_key_release_key_size,
    output logic [63:0] strap_ss_key_release_base_addr,
    output logic ss_ocp_lock_en,
    input logic ready_for_fuses,
    input logic ready_for_mb_processing,
    input logic mailbox_data_avail,
    input  var  ras_test_ctrl_t ras_test_ctrl,
    output logic [63:0] generic_input_wires,
    input logic cptra_error_fatal,
    input logic cptra_error_non_fatal,
    input logic int_flag,
    input logic cycleCnt_smpl_en,
    input logic assert_hard_rst_flag,
    input logic deassert_hard_rst_flag,
    input logic assert_rst_flag_from_service,
    input logic deassert_rst_flag_from_service
);
    localparam FW_NUM_DWORDS         = 256;
    int poll_count;
    logic [0:8-1][31:0]          cptra_obfkey_tb;
    logic [0:16-1][31:0]          cptra_uds_tb;
    logic [0:8-1][31:0]           cptra_fe_tb;
    logic [0:OCP_LOCK_HEK_NUM_DWORDS-1] [31:0]     cptra_hek_tb;
    axi_resp_e wresp, rresp;
    logic [32  -1:0] wdata, rdata;
    logic [32/8-1:0] wstrb_array[];
    logic [32  -1:0] wuser_array[];
    logic [32  -1:0] buser;
    logic [32  -1:0] rdata_array[];
    logic [32  -1:0] ruser_array[];
    axi_resp_e rresp_array[];
    int byte_count;
    int dw_count;
    logic [15:0] cptra_error_fatal_counter;
    logic [15:0] cptra_error_non_fatal_counter;
    logic cptra_error_fatal_dly_p;
    logic cptra_error_non_fatal_dly_p;
    logic rv_dma_resp_error;
    logic [32-1:0] soc_ifc_hw_error_wdata;
    process boot_and_cmd_flow;
    logic assert_rst_flag_from_fatal;
    logic assert_rst_flag;
    int   count_deassert_rst_flag_from_fatal;
    logic deassert_rst_flag_from_fatal;
    logic deassert_rst_flag;
    logic [31:0] fw_blob [];
    always@(negedge core_clk or negedge cptra_rst_b) begin
        if (!cptra_rst_b) begin
            cptra_error_fatal_counter     <= 16'h0;
            cptra_error_non_fatal_counter <= 16'h0;
        end
        else begin
            cptra_error_fatal_counter     <= cptra_error_fatal     ? (cptra_error_fatal_counter     + 16'h1) : 16'h0;
            cptra_error_non_fatal_counter <= cptra_error_non_fatal ? (cptra_error_non_fatal_counter + 16'h1) : 16'h0;
        end
    end
    always_comb cptra_error_fatal_dly_p     = cptra_error_fatal_counter     == 16'h0040;
    always_comb cptra_error_non_fatal_dly_p = cptra_error_non_fatal_counter == 16'h0040;
    always@(negedge core_clk) begin
        if (!cptra_pwrgood) begin
            count_deassert_rst_flag_from_fatal <= 0;
        end
        else if (assert_rst_flag_from_fatal || (!cptra_rst_b && |count_deassert_rst_flag_from_fatal)) begin
            count_deassert_rst_flag_from_fatal <= count_deassert_rst_flag_from_fatal + 1;
        end
        else begin
            count_deassert_rst_flag_from_fatal <= 0;
        end
    end
    always_comb deassert_rst_flag_from_fatal = count_deassert_rst_flag_from_fatal == 31;
    initial begin
        if ($test$plusargs("STRAP_SS_KEY_RELEASE_KEY_SIZE_MANUAL")) begin
            if (!$value$plusargs("STRAP_SS_KEY_RELEASE_KEY_SIZE_MANUAL=%h", strap_ss_key_release_key_size)) begin
                $error("Failed to get value for +STRAP_SS_KEY_RELEASE_KEY_SIZE_MANUAL");
            end
            $display("STRAP_SS_KEY_RELEASE_KEY_SIZE set manually to 0x%04x", strap_ss_key_release_key_size);
        end
        else if ($test$plusargs("STRAP_SS_KEY_RELEASE_KEY_SIZE_RAND_LOW")) begin
            strap_ss_key_release_key_size = $urandom_range(16'h4, 16'h40);
            strap_ss_key_release_key_size = strap_ss_key_release_key_size & ~16'h3;
            $display("STRAP_SS_KEY_RELEASE_KEY_SIZE randomized (0x4-0x40, DWORD aligned) to 0x%04x", strap_ss_key_release_key_size);
        end
        else if ($test$plusargs("STRAP_SS_KEY_RELEASE_KEY_SIZE_RAND_HIGH")) begin
            strap_ss_key_release_key_size = $urandom_range(16'h44, 16'hFFFF);
            strap_ss_key_release_key_size = strap_ss_key_release_key_size & ~16'h3;
            $display("STRAP_SS_KEY_RELEASE_KEY_SIZE randomized (>0x40, DWORD aligned) to 0x%04x", strap_ss_key_release_key_size);
        end
        else if ($test$plusargs("STRAP_SS_KEY_RELEASE_KEY_SIZE_RAND_ANY")) begin
            strap_ss_key_release_key_size = $urandom();
            strap_ss_key_release_key_size = strap_ss_key_release_key_size & ~16'h3;
            $display("STRAP_SS_KEY_RELEASE_KEY_SIZE randomized (any value, DWORD aligned) to 0x%04x", strap_ss_key_release_key_size);
        end
        else begin
            strap_ss_key_release_key_size = 16'h40;
            $display("STRAP_SS_KEY_RELEASE_KEY_SIZE set to default value 0x%04x", strap_ss_key_release_key_size);
        end
        if ($test$plusargs("CLP_OCP_LOCK_EN")) begin
            ss_ocp_lock_en = 1'b1;
        end
        else if ($test$plusargs("CLP_OCP_LOCK_DIS")) begin
            ss_ocp_lock_en = 1'b0;
        end
        else begin
            ss_ocp_lock_en = $urandom();
        end
        if ($test$plusargs("STRAP_SS_KEY_RELEASE_BASE_ADDR_RAND_SRAM")) begin
            logic [63:0] random_offset;
            random_offset = $urandom_range(64'h0, AXI_SRAM_SIZE_BYTES - 64 - 1);
            random_offset = random_offset & ~64'h3;
            strap_ss_key_release_base_addr = AXI_SRAM_BASE_ADDR + random_offset;
            $display("STRAP_SS_KEY_RELEASE_BASE_ADDR randomized within AXI SRAM to 0x%016x", strap_ss_key_release_base_addr);
        end
        else begin
            strap_ss_key_release_base_addr = AXI_SRAM_BASE_ADDR;
            $display("STRAP_SS_KEY_RELEASE_BASE_ADDR set to default value 0x%016x", strap_ss_key_release_base_addr);
        end
    end
    initial begin
        cptra_pwrgood = 1'b0;
        BootFSM_BrkPoint = $urandom_range(1,0);  
        cptra_rst_b = 1'b0;
        assert_rst_flag_from_fatal = 1'b0;
        m_axi_bfm_if.rst_mgr();
        if($test$plusargs("RAND_DOE_VALUES")) begin
            for (int dword = 0; dword < $bits(cptra_obf_key)/32; dword++) begin
                cptra_obf_key[dword] = cptra_obf_key_tb[dword];
            end
            cptra_uds_tb = cptra_uds_rand;
            cptra_fe_tb = cptra_fe_rand;
            cptra_hek_tb = cptra_hek_rand;
        end
        else begin
            if ($test$plusargs("SECOND_DOE_KAT")) begin
                cptra_obfkey_tb = 256'he1dd72419beccddff77c722d992cdcc87e9c7486f56ab406ea608d8c6aeb060c;
                cptra_uds_tb = 512'h32cd8a75b5e515bd7b0fe37a6de144696aeedb1f5e03225a71fc690f5b004ff593794db7a99ced97c376385149c4ecafd3afd70cb657a6f6434bfd911983f4ff;
                cptra_fe_tb = 256'h7dca6154c2510ae1c87b1b422b02b621bb06cac280023894fcff3406af08ee9b;
                cptra_hek_tb = 256'h7dca6154c2510ae1c87b1b422b02b621bb06cac280023894fcff3406af08ee9b;  
            end 
            else begin
                cptra_obfkey_tb = 256'h31358e8af34d6ac31c958bbd5c8fb33c334714bffb41700d28b07f11cfe891e7;
                cptra_uds_tb = 512'he4046d05385ab789c6a72866e08350f93f583e2a005ca0faecc32b5cfc323d461c76c107307654db5566a5bd693e227c144516246a752c329056d884daf3c89d;
                cptra_fe_tb = 256'hb32e2b171b63827034ebb0d1909f7ef1d51c5f82c1bb9bc26bc4ac4dccdee835;
                cptra_hek_tb = 256'hb32e2b171b63827034ebb0d1909f7ef1d51c5f82c1bb9bc26bc4ac4dccdee835;  
            end
            for (int dword = 0; dword < $bits(cptra_obf_key)/32; dword++) begin
                cptra_obf_key[dword] = cptra_obfkey_tb[dword];
            end
        end
        for (int dword = 0; dword < 16; dword++) begin
            cptra_csr_hmac_key[dword] = 32'h0b0b0b0b;
        end
        soc_ifc_hw_error_wdata = 'h0;
        generic_input_wires = 'h0;
        $display ("\n\n\n\n\n\n");
        repeat(15) @(posedge core_clk);
        $display("CLP: Waiting for cptra_rst_b deassertion\n");
        forever begin
            fork
                begin: BOOT_AND_CMD_FLOW
                    boot_and_cmd_flow = process::self();
                    @(posedge cptra_rst_b)
                    $display("CLP: Observed cptra_rst_b deassertion\n");
                    if (!SKIP_BRINGUP) begin: DO_BOOT_AND_CMD_FLOW
                    wait(ready_for_fuses == 1);
                    $display ("CLP: Ready for fuse download\n");
                    for (int rpt=0; rpt < 5; rpt++) @(posedge core_clk);
                    $display ("SoC: Writing obfuscated UDS to fuse bank\n");
                    for (int dw=0; dw < 16; dw++) begin
                        m_axi_bfm_if.axi_write_single(.addr((32'h30030200) + 4 * dw), .data(cptra_uds_tb[dw]), .resp(wresp), .resp_user(buser));
                    end
                    $display ("SoC: Writing obfuscated Field Entropy to fuse bank\n");
                    for (int dw=0; dw < 8; dw++) begin
                        m_axi_bfm_if.axi_write_single(.addr((32'h30030240) + 4 * dw), .data(cptra_fe_tb[dw]), .resp(wresp), .resp_user(buser));
                    end
                    $display ("SoC: Writing obfuscated HEK seed to fuse bank\n");
                    for (int dw=0; dw < OCP_LOCK_HEK_NUM_DWORDS; dw++) begin
                        m_axi_bfm_if.axi_write_single(.addr((32'h300303c0) + 4 * dw), .data(cptra_hek_tb[dw]), .resp(wresp), .resp_user(buser));
                    end
                    $display ("SoC: Writing SOC Stepping ID to fuse bank\n");
                    m_axi_bfm_if.axi_write_single(.addr((32'h30030348)), .data($urandom()), .resp(wresp), .resp_user(buser));
                    $display ("SoC: Writing fuse done register\n");
                    m_axi_bfm_if.axi_write_single(.addr((32'h300300b0)), .data(32'h00000001), .resp(wresp), .resp_user(buser));
                    assert (!cptra_error_non_fatal) else begin
                        $error("cptra_error_non_fatal observed during boot up");
                        $finish;
                    end
                    assert (!cptra_error_fatal) else begin
                        $error("cptra_error_fatal observed during boot up");
                        $finish;
                    end
                    if (BootFSM_BrkPoint) begin
                        $write ("SoC: Polling Flow Status...");
                        poll_count = 0;
                        do begin
                            m_axi_bfm_if.axi_read_single(.addr((32'h3003003c)), .data(rdata), .resp(rresp), .resp_user(buser));
                            poll_count++;
                        end while(rdata[(30)] == 1);
                        $display("\n  >>> SoC: Ready for Fuses deasserted after polling %d times\n", poll_count);
                        $display ("SoC: Writing BootGo register\n");
                        m_axi_bfm_if.axi_write_single(.addr((32'h300300b8)), .data(32'h00000001), .resp(wresp), .resp_user(buser));
                    end
                    else begin
                        $display("SoC: Breakpoint not set; skipping BOOTFSM_GO step\n");
                    end
                    $display ("CLP: ROM Flow in progress...\n");
                    wait(ready_for_mb_processing || ras_test_ctrl.error_injection_seen);
                    if (ready_for_mb_processing) begin
                        for (int rpt=0; rpt<5; rpt++) @(posedge core_clk);
                        $display ("CLP: Ready for firmware push\n");
                        $write ("SoC: Requesting mailbox lock...");
                        poll_count = 0;
                        do begin
                            m_axi_bfm_if.axi_read_single(.addr((32'h30020000)), .user(32'hFFFF_FFFF), .data(rdata), .resp(rresp), .resp_user(buser));
                            poll_count++;
                        end while (rdata[(0)] == 1);
                        $display ("\n  >>> SoC: Lock granted after polling %d times\n", poll_count);
                        $display ("SoC: Writing the Command Register\n");
                        m_axi_bfm_if.axi_write_single(.addr((32'h30020008)), .user(32'hFFFF_FFFF), .data(32'hBA5EBA11), .resp(wresp), .resp_user(buser));
                        $display ("SoC: Writing the Data Length Register\n");
                        m_axi_bfm_if.axi_write_single(.addr((32'h3002000c)), .user(32'hFFFF_FFFF), .data(FW_NUM_DWORDS*4), .resp(wresp), .resp_user(buser));
                        $display ("SoC: Writing the Firmware into Data-in Register\n");
                        fw_blob = new[FW_NUM_DWORDS];
                        wstrb_array = new[FW_NUM_DWORDS]('{default: {32/8{1'b1}}});
                        for (int dw=0; dw < FW_NUM_DWORDS; dw++)
                            fw_blob[dw] = $urandom();
                        m_axi_bfm_if.axi_write(.addr      ((32'h30020010)),
                                               .burst     (AXI_BURST_FIXED),
                                               .len       (FW_NUM_DWORDS-1),
                                               .user      (32'hFFFF_FFFF  ),
                                               .data      (fw_blob        ),
                                               .strb      (wstrb_array    ),
                                               .write_user(wuser_array    ),
                                               .resp      (wresp          ),
                                               .resp_user (buser          ));
                        $display ("SoC: Setting the Execute Register\n");
                        m_axi_bfm_if.axi_write_single(.addr((32'h30020018)), .user(32'hFFFF_FFFF), .data(32'h00000001), .resp(wresp), .resp_user(buser));
                        $display("SoC: Waiting for Response Data availability\n");
                        wait(mailbox_data_avail);
                        $display("SoC: Reading the Status Register...\n");
                        m_axi_bfm_if.axi_read_single(.addr((32'h3002001c)), .user(32'hFFFF_FFFF), .data(rdata), .resp(rresp), .resp_user(buser));
                        if (((rdata & (32'hf)) >> (0)) == DATA_READY) begin: READ_RESP_DATA
                            $display("SoC: Reading the Data Length Register...\n");
                            m_axi_bfm_if.axi_read_single(.addr((32'h3002000c)), .user(32'hFFFF_FFFF), .data(rdata), .resp(rresp), .resp_user(buser));
                            $display("SoC: Reading the Data Out Register\n");
                            for (int xfer4k = 0; xfer4k < rdata; xfer4k += 4096) begin
                                byte_count = (rdata - xfer4k) > 4096 ? 4096 : (rdata - xfer4k);
                                dw_count = byte_count/(32/8) + |byte_count[$clog2(32/8)-1:0];
                                rdata_array = new[dw_count];
                                rresp_array = new[dw_count];
                                ruser_array = new[dw_count];
                                m_axi_bfm_if.axi_read(.addr     ((32'h30020014)),
                                                      .burst    (AXI_BURST_FIXED),
                                                      .len      (dw_count-1     ),
                                                      .user     (32'hFFFF_FFFF  ),
                                                      .data     (rdata_array    ),
                                                      .resp     (rresp_array    ),
                                                      .resp_user(ruser_array    ));
                            end
                        end: READ_RESP_DATA
                        $display("SoC: Resetting the Execute Register\n");
                        m_axi_bfm_if.axi_write_single(.addr((32'h30020018)), .user(32'hFFFF_FFFF), .data(32'h0), .resp(wresp), .resp_user(buser));
                        @(negedge core_clk);
                        generic_input_wires = {$urandom, $urandom};  
                    end
                    if (ras_test_ctrl.error_injection_seen) begin
                        $display("SoC: Waiting to see cptra_error_fatal/non_fatal\n");
                        rv_dma_resp_error = 1'b0;
                    end
                    forever begin
                        if (cptra_error_fatal_dly_p) begin
                            $display("SoC: Observed cptra_error_fatal; reading Caliptra register\n");
                            m_axi_bfm_if.axi_read_single(.addr((32'h30030000)), .data(rdata), .resp(rresp), .resp_user(buser));
                            if (rdata[(0)]) begin
                                generic_input_wires = {32'h0, ICCM_FATAL_OBSERVED};
                            end
                            else if (rdata[(1)]) begin
                                generic_input_wires = {32'h0, DCCM_FATAL_OBSERVED};
                            end
                            else if (rdata[(2)]) begin
                                generic_input_wires = {32'h0, NMI_FATAL_OBSERVED};
                            end
                            else if (rdata[(3)]) begin
                                generic_input_wires = {32'h0, CRYPTO_ERROR_OBSERVED};
                            end
                            else begin
                                generic_input_wires = {32'h0, ERROR_NONE_SET};
                            end
                            soc_ifc_hw_error_wdata = rdata;
                            assert_rst_flag_from_fatal = 1;
                            wait(cptra_rst_b == 0);
                        end
                        else if (cptra_error_non_fatal_dly_p) begin
                            $display("SoC: Observed cptra_error_non_fatal; reading Caliptra register\n");
                            m_axi_bfm_if.axi_read_single(.addr((32'h30030004)), .data(rdata), .resp(rresp), .resp_user(buser));
                            if (rdata[(0)]) begin
                                generic_input_wires = {32'h0, PROT_NO_LOCK_NON_FATAL_OBSERVED};
                            end
                            else if (rdata[(1)]) begin
                                generic_input_wires = {32'h0, PROT_OOO_NON_FATAL_OBSERVED};
                            end
                            else if (rdata[(2)]) begin
                                generic_input_wires = {32'h0, MBOX_NON_FATAL_OBSERVED};
                            end
                            else begin
                                generic_input_wires = {32'h0, ERROR_NONE_SET};
                            end
                            $display("SoC: Observed cptra_error_non_fatal; writing to clear Caliptra register\n");
                            m_axi_bfm_if.axi_write_single(.addr((32'h30030004)), .data(rdata), .resp(wresp), .resp_user(buser));
                        end
                        else if (soc_ifc_hw_error_wdata) begin
                            $display("SoC: Observed cptra_error_fatal; writing to clear Caliptra register\n");
                            m_axi_bfm_if.axi_write_single(.addr((32'h30030000)), .data(soc_ifc_hw_error_wdata), .resp(wresp), .resp_user(buser));
                            soc_ifc_hw_error_wdata = '0;
                        end
                        else if (ras_test_ctrl.do_no_lock_access) begin
                            fork
                                begin
                                    $display("SoC: Reading the Data Out Register without lock\n");
                                    dw_count = 1;
                                    rdata_array = new[dw_count];
                                    rresp_array = new[dw_count];
                                    ruser_array = new[dw_count];
                                    m_axi_bfm_if.axi_read(.addr     ((32'h30020014)),
                                                          .burst    (AXI_BURST_FIXED),
                                                          .len      (dw_count-1     ),
                                                          .user     (32'hFFFF_FFFF  ),
                                                          .data     (rdata_array    ),
                                                          .resp     (rresp_array    ),
                                                          .resp_user(ruser_array    ));
                                end
                            join
                        end
                        else if (ras_test_ctrl.do_ooo_access) begin
                            fork
                                begin
                                    $write ("SoC: Requesting mailbox lock...");
                                    poll_count = 0;
                                    do begin
                                        m_axi_bfm_if.axi_read_single(.addr((32'h30020000)), .user(32'hFFFF_FFFF), .data(rdata), .resp(rresp), .resp_user(buser));
                                        poll_count++;
                                    end while (rdata[(0)] == 1);
                                    $display ("\n  >>> SoC: Lock granted after polling %d times\n", poll_count);
                                    $display("SoC: Reading the Data Length Register...\n");
                                    m_axi_bfm_if.axi_read_single(.addr((32'h3002000c)), .user(32'hFFFF_FFFF), .data(rdata), .resp(rresp), .resp_user(buser));
                                    $display("SoC: Reading the Data Out Register\n");
                                    dw_count = 1;
                                    rdata_array = new[dw_count];
                                    rresp_array = new[dw_count];
                                    ruser_array = new[dw_count];
                                    m_axi_bfm_if.axi_read(.addr     ((32'h30020014)),
                                                          .burst    (AXI_BURST_FIXED),
                                                          .len      (dw_count-1     ),
                                                          .user     (32'hFFFF_FFFF  ),
                                                          .data     (rdata_array    ),
                                                          .resp     (rresp_array    ),
                                                          .resp_user(ruser_array    ));
                                end
                            join
                        end
                        else if (ras_test_ctrl.reset_generic_input_wires) begin
                            generic_input_wires = {32'h72746C76, ERROR_NONE_SET};  
                        end
                        else if (rv_dma_resp_error) begin
                            generic_input_wires = {32'h0, DMA_ERROR_OBSERVED};
                            rv_dma_resp_error = 1'b0;
                        end
                        else if (mailbox_data_avail) begin
                            $display("SoC: Reading the Data Length Register\n");
                            m_axi_bfm_if.axi_read_single(.addr((32'h3002000c)), .user(32'hFFFF_FFFF), .data(rdata), .resp(rresp), .resp_user(buser));
                            $display("SoC: Reading the Data Out Register\n");
                            for (int xfer4k = 0; xfer4k < rdata; xfer4k += 4096) begin
                                byte_count = (rdata - xfer4k) > 4096 ? 4096 : (rdata - xfer4k);
                                dw_count = byte_count/(32/8) + |byte_count[$clog2(32/8)-1:0];
                                rdata_array = new[dw_count];
                                rresp_array = new[dw_count];
                                ruser_array = new[dw_count];
                                m_axi_bfm_if.axi_read(.addr     ((32'h30020014)),
                                                      .burst    (AXI_BURST_FIXED ),
                                                      .len      (dw_count-1      ),
                                                      .user     (32'hFFFF_FFFF   ),
                                                      .data     (rdata_array     ),
                                                      .resp     (rresp_array     ),
                                                      .resp_user(ruser_array     ));
                            end
                            $display ("SoC: Writing the Mbox Status Register\n");
                            m_axi_bfm_if.axi_write_single(.addr((32'h3002001c)), .user(32'hFFFF_FFFF), .data(32'h1), .resp(wresp), .resp_user(buser));
                        end
                        @(posedge core_clk);
                    end
                    end: DO_BOOT_AND_CMD_FLOW
                    else begin: SKIP_BOOT_AND_CMD_FLOW
                        forever @(posedge core_clk);
                    end: SKIP_BOOT_AND_CMD_FLOW
                end: BOOT_AND_CMD_FLOW
                begin: CLK_GATE_FLOW
                    wait(cycleCnt_smpl_en);
                    for (int rpt=0; rpt<2000; rpt++) @(negedge core_clk);
                    if (int_flag) begin
                        $display("SoC (clk_gate_flow): Forcing soft_int = 1. cycleCnt [%d]\n", cycleCnt);

                        for (int rpt=0; rpt<2; rpt++) @(negedge core_clk);
                        $display("SoC (clk_gate_flow): Releasing soft_int = 1. cycleCnt [%d]\n", cycleCnt);

                    end
                    for (int rpt=0; rpt<5000; rpt++) @(negedge core_clk);
                    if (int_flag) begin
                        $display("SoC (clk_gate_flow): Forcing timer_int = 1. cycleCnt [%d]\n", cycleCnt);

                        for (int rpt=0; rpt<2; rpt++) @(negedge core_clk);
                        $display("SoC (clk_gate_flow): Releasing timer_int = 1. cycleCnt [%d]\n", cycleCnt);

                    end
                    for (int rpt=0; rpt<8000; rpt++) @(negedge core_clk);
                    if (int_flag) begin
                        $display("SoC (clk_gate_flow): Forcing soft_int = 1. cycleCnt [%d]\n", cycleCnt);

                        for (int rpt=0; rpt<2; rpt++) @(negedge core_clk);
                        $display("SoC (clk_gate_flow): Releasing soft_int = 1. cycleCnt [%d]\n", cycleCnt);

                    end
                    wait(cptra_rst_b == 0);
                end: CLK_GATE_FLOW
                begin: RESET_FLOW
                    @(negedge cptra_rst_b);
                    $display("CLP: Observed cptra_rst_b assertion\n");
                    if (boot_and_cmd_flow != null) boot_and_cmd_flow.kill();
                    assert_rst_flag_from_fatal = 1'b0;
                    m_axi_bfm_if.rst_mgr();
                end: RESET_FLOW
            join_any
        end
    end
    assign assert_rst_flag   =   assert_rst_flag_from_service ||   assert_rst_flag_from_fatal;
    assign deassert_rst_flag = deassert_rst_flag_from_service || deassert_rst_flag_from_fatal;
    always @(posedge core_clk) begin
        if (cycleCnt == 15 || deassert_hard_rst_flag) begin
            $display ("SoC: Asserting cptra_pwrgood and breakpoint. cycleCnt [%d] deassert_hard_rst_flag[%d]\n", cycleCnt, deassert_hard_rst_flag);
            cptra_pwrgood <= 1'b1;
        end
        else if (cycleCnt == 20 || deassert_rst_flag) begin
            $display ("SoC: De-Asserting cptra_rst_b. cycleCnt [%d] deassert_rst_flag[%d]\n", cycleCnt, deassert_rst_flag);
            cptra_rst_b <= 1'b1;
        end
        else if (assert_hard_rst_flag) begin
            cptra_pwrgood <= 'b0;
            cptra_rst_b <= 'b0;
        end
        else if (assert_rst_flag) begin
            cptra_rst_b <= 'b0;
        end
    end
task force_ahb_dma_read(input logic [31:0] address);
    #1ps;
endtask
task force_ahb_dma_loop_read(input logic [31:0] start_addr, input logic [19:0] count);
    automatic logic [31:0] addr;
    addr = start_addr;
    $display("[%t] AHB DMA FORCE LOOP READ: Start Address 0x%x Count 0x%x", $time, addr, count);
    if ($isunknown(start_addr) || $isunknown(addr))
        $error("[%t] Unknown signal found: start_addr 0x%x addr 0x%x", $time, start_addr, addr);
    repeat(count) begin
        force_ahb_dma_read(addr);
        addr += 4;
    end
endtask
initial begin
    forever @(posedge core_clk) begin
        if (ras_test_ctrl.dccm_read_burst.start)
            force_ahb_dma_loop_read(ras_test_ctrl.dccm_read_burst.addr, ras_test_ctrl.dccm_read_burst.count);
        if (ras_test_ctrl.iccm_read_burst.start)
            force_ahb_dma_loop_read(ras_test_ctrl.iccm_read_burst.addr, ras_test_ctrl.iccm_read_burst.count);
    end
end
endmodule
`begin_keywords "1800-2023"
`default_nettype none
module caliptra_top_tb_axi_complex import caliptra_top_tb_pkg::*; (
    input logic core_clk,
    input logic cptra_rst_b,
    axi_if m_axi_if,
    output logic recovery_data_avail,
    input var axi_complex_ctrl_t ctrl,
    input logic axi_error_inj_en
);
    import axi_pkg::*;
    import soc_ifc_pkg::*;
    logic [48-1:0] err_resp_start_addr;
    logic [48-1:0] err_resp_end_addr;
    logic err_resp_enable;
    logic cmdline_err_resp_enable;
    initial begin
        string err_resp_enable_str;
        cmdline_err_resp_enable = 1'b0;
        err_resp_start_addr = '0;
        err_resp_end_addr = '0;
        if ($value$plusargs("ERR_RESP_START_ADDR=%x", err_resp_start_addr)) begin
            if ($value$plusargs("ERR_RESP_END_ADDR=%x", err_resp_end_addr)) begin
                cmdline_err_resp_enable = 1'b1;
                $display("[%0t] TB: Err response injection enabled for address range 0x%09h to 0x%09h", $time, err_resp_start_addr, err_resp_end_addr);
            end else begin
                $error("TB: ERR_RESP_START_ADDR specified but ERR_RESP_END_ADDR missing. Err injection disabled.");
            end
        end
    end
    assign err_resp_enable = cmdline_err_resp_enable && axi_error_inj_en;
    function automatic logic addr_in_err_range(logic [48-1:0] addr);
        return err_resp_enable && (addr >= err_resp_start_addr) && (addr <= err_resp_end_addr);;
    endfunction
    axi_if #(
        .AW(AXI_SRAM_ADDR_WIDTH),
        .DW(CPTRA_AXI_DMA_DATA_WIDTH),
        .IW(CPTRA_AXI_DMA_ID_WIDTH),
        .UW(CPTRA_AXI_DMA_USER_WIDTH)
    ) axi_sram_if (.clk(core_clk), .rst_n(cptra_rst_b));
    logic axi_sram_if_bvalid_force;  
    axi_if #(
        .AW(AXI_FIFO_ADDR_WIDTH),
        .DW(CPTRA_AXI_DMA_DATA_WIDTH),
        .IW(CPTRA_AXI_DMA_ID_WIDTH),
        .UW(CPTRA_AXI_DMA_USER_WIDTH)
    ) axi_fifo_if (.clk(core_clk), .rst_n(cptra_rst_b));
    logic axi_fifo_if_bvalid_force;  
        logic [11:0] i_axi_sram_ar_dly_cnt;                                                                                                               
        bit AXI_SRAM_AR_DLY_past_shake_stall;                                                                                                    
        always@(posedge core_clk)                                                                                                           
            AXI_SRAM_AR_DLY_past_shake_stall <= axi_sram_if.arvalid && !axi_sram_if.arready;                                                                   
        initial begin: AXI_SRAM_AR_DLY                                                                                                             
            i_axi_sram_ar_dly_cnt = $urandom_range(7,0);                                                                                                  
            forever begin                                                                                                                   
                @(negedge core_clk)                                                                                                         
                if (ctrl.rand_delays) begin                                                                                                 
                    if (|i_axi_sram_ar_dly_cnt && !AXI_SRAM_AR_DLY_past_shake_stall) begin                                                                     
                        i_axi_sram_ar_dly_cnt = i_axi_sram_ar_dly_cnt - 1;                                                                                              
                        force axi_sram_if.arready = 1'b0;                                                                                          
                        force axi_sram_if.arvalid = 1'b0;                                                                                          
                    end                                                                                                                     
                    else begin                                                                                                              
                        i_axi_sram_ar_dly_cnt = $urandom_range(7,0);                                                                                      
                        release axi_sram_if.arready;                                                                                               
                        release axi_sram_if.arvalid;                                                                                               
                    end                                                                                                                     
                end                                                                                                                         
                else begin                                                                                                                  
                    release axi_sram_if.arready;                                                                                                   
                    release axi_sram_if.arvalid;                                                                                                   
                end                                                                                                                         
            end                                                                                                                             
        end: AXI_SRAM_AR_DLY                                                                                                                       
        logic [11:0] i_axi_sram_r_dly_cnt;                                                                                                               
        bit AXI_SRAM_R_DLY_past_shake_stall;                                                                                                    
        always@(posedge core_clk)                                                                                                           
            AXI_SRAM_R_DLY_past_shake_stall <= axi_sram_if.rvalid && !axi_sram_if.rready;                                                                   
        initial begin: AXI_SRAM_R_DLY                                                                                                             
            i_axi_sram_r_dly_cnt = $urandom_range(7,0);                                                                                                  
            forever begin                                                                                                                   
                @(negedge core_clk)                                                                                                         
                if (ctrl.rand_delays) begin                                                                                                 
                    if (|i_axi_sram_r_dly_cnt && !AXI_SRAM_R_DLY_past_shake_stall) begin                                                                     
                        i_axi_sram_r_dly_cnt = i_axi_sram_r_dly_cnt - 1;                                                                                              
                        force axi_sram_if.rready = 1'b0;                                                                                          
                        force axi_sram_if.rvalid = 1'b0;                                                                                          
                    end                                                                                                                     
                    else begin                                                                                                              
                        i_axi_sram_r_dly_cnt = $urandom_range(7,0);                                                                                      
                        release axi_sram_if.rready;                                                                                               
                        release axi_sram_if.rvalid;                                                                                               
                    end                                                                                                                     
                end                                                                                                                         
                else begin                                                                                                                  
                    release axi_sram_if.rready;                                                                                                   
                    release axi_sram_if.rvalid;                                                                                                   
                end                                                                                                                         
            end                                                                                                                             
        end: AXI_SRAM_R_DLY                                                                                                                       
        logic [11:0] i_axi_sram_aw_dly_cnt;                                                                                                               
        bit AXI_SRAM_AW_DLY_past_shake_stall;                                                                                                    
        always@(posedge core_clk)                                                                                                           
            AXI_SRAM_AW_DLY_past_shake_stall <= i_axi_sram.i_axi_sub.i_axi_sub_wr.axi_awvalid_q && !i_axi_sram.i_axi_sub.i_axi_sub_wr.axi_awready_q;                                                                   
        initial begin: AXI_SRAM_AW_DLY                                                                                                             
            i_axi_sram_aw_dly_cnt = $urandom_range(7,0);                                                                                                  
            forever begin                                                                                                                   
                @(negedge core_clk)                                                                                                         
                if (ctrl.rand_delays) begin                                                                                                 
                    if (|i_axi_sram_aw_dly_cnt && !AXI_SRAM_AW_DLY_past_shake_stall) begin                                                                     
                        i_axi_sram_aw_dly_cnt = i_axi_sram_aw_dly_cnt - 1;                                                                                              
                        force i_axi_sram.i_axi_sub.i_axi_sub_wr.axi_awready_q = 1'b0;                                                                                          
                        force i_axi_sram.i_axi_sub.i_axi_sub_wr.axi_awvalid_q = 1'b0;                                                                                          
                    end                                                                                                                     
                    else begin                                                                                                              
                        i_axi_sram_aw_dly_cnt = $urandom_range(7,0);                                                                                      
                        release i_axi_sram.i_axi_sub.i_axi_sub_wr.axi_awready_q;                                                                                               
                        release i_axi_sram.i_axi_sub.i_axi_sub_wr.axi_awvalid_q;                                                                                               
                    end                                                                                                                     
                end                                                                                                                         
                else begin                                                                                                                  
                    release i_axi_sram.i_axi_sub.i_axi_sub_wr.axi_awready_q;                                                                                                   
                    release i_axi_sram.i_axi_sub.i_axi_sub_wr.axi_awvalid_q;                                                                                                   
                end                                                                                                                         
            end                                                                                                                             
        end: AXI_SRAM_AW_DLY                                                                                                                       
        logic [11:0] i_axi_sram_w_dly_cnt;                                                                                                               
        bit AXI_SRAM_W_DLY_past_shake_stall;                                                                                                    
        always@(posedge core_clk)                                                                                                           
            AXI_SRAM_W_DLY_past_shake_stall <= i_axi_sram.i_axi_sub.i_axi_sub_wr.txn_wvalid && !i_axi_sram.i_axi_sub.i_axi_sub_wr.txn_wready;                                                                   
        initial begin: AXI_SRAM_W_DLY                                                                                                             
            i_axi_sram_w_dly_cnt = $urandom_range(7,0);                                                                                                  
            forever begin                                                                                                                   
                @(negedge core_clk)                                                                                                         
                if (ctrl.rand_delays) begin                                                                                                 
                    if (|i_axi_sram_w_dly_cnt && !AXI_SRAM_W_DLY_past_shake_stall) begin                                                                     
                        i_axi_sram_w_dly_cnt = i_axi_sram_w_dly_cnt - 1;                                                                                              
                        force i_axi_sram.i_axi_sub.i_axi_sub_wr.txn_wready = 1'b0;                                                                                          
                        force i_axi_sram.i_axi_sub.i_axi_sub_wr.txn_wvalid = 1'b0;                                                                                          
                    end                                                                                                                     
                    else begin                                                                                                              
                        i_axi_sram_w_dly_cnt = $urandom_range(7,0);                                                                                      
                        release i_axi_sram.i_axi_sub.i_axi_sub_wr.txn_wready;                                                                                               
                        release i_axi_sram.i_axi_sub.i_axi_sub_wr.txn_wvalid;                                                                                               
                    end                                                                                                                     
                end                                                                                                                         
                else begin                                                                                                                  
                    release i_axi_sram.i_axi_sub.i_axi_sub_wr.txn_wready;                                                                                                   
                    release i_axi_sram.i_axi_sub.i_axi_sub_wr.txn_wvalid;                                                                                                   
                end                                                                                                                         
            end                                                                                                                             
        end: AXI_SRAM_W_DLY                                                                                                                       
        logic [11:0] i_axi_sram_b_dly_cnt;                                                                                                               
        bit AXI_SRAM_B_DLY_past_shake_stall;                                                                                                    
        always@(posedge core_clk)                                                                                                           
            AXI_SRAM_B_DLY_past_shake_stall <= axi_sram_if_bvalid_force && !axi_sram_if.bready;                                                                   
        initial begin: AXI_SRAM_B_DLY                                                                                                             
            i_axi_sram_b_dly_cnt = $urandom_range(7,0);                                                                                                  
            forever begin                                                                                                                   
                @(negedge core_clk)                                                                                                         
                if (ctrl.rand_delays) begin                                                                                                 
                    if (|i_axi_sram_b_dly_cnt && !AXI_SRAM_B_DLY_past_shake_stall) begin                                                                     
                        i_axi_sram_b_dly_cnt = i_axi_sram_b_dly_cnt - 1;                                                                                              
                        force axi_sram_if.bready = 1'b0;                                                                                          
                        force axi_sram_if_bvalid_force = 1'b0;                                                                                          
                    end                                                                                                                     
                    else begin                                                                                                              
                        i_axi_sram_b_dly_cnt = $urandom_range(7,0);                                                                                      
                        release axi_sram_if.bready;                                                                                               
                        release axi_sram_if_bvalid_force;                                                                                               
                    end                                                                                                                     
                end                                                                                                                         
                else begin                                                                                                                  
                    release axi_sram_if.bready;                                                                                                   
                    release axi_sram_if_bvalid_force;                                                                                                   
                end                                                                                                                         
            end                                                                                                                             
        end: AXI_SRAM_B_DLY                                                                                                                       
        logic [11:0] i_axi_fifo_ar_dly_cnt;                                                                                                               
        bit AXI_FIFO_AR_DLY_past_shake_stall;                                                                                                    
        always@(posedge core_clk)                                                                                                           
            AXI_FIFO_AR_DLY_past_shake_stall <= axi_fifo_if.arvalid && !axi_fifo_if.arready;                                                                   
        initial begin: AXI_FIFO_AR_DLY                                                                                                             
            i_axi_fifo_ar_dly_cnt = $urandom_range(7,0);                                                                                                  
            forever begin                                                                                                                   
                @(negedge core_clk)                                                                                                         
                if (ctrl.rand_delays) begin                                                                                                 
                    if (|i_axi_fifo_ar_dly_cnt && !AXI_FIFO_AR_DLY_past_shake_stall) begin                                                                     
                        i_axi_fifo_ar_dly_cnt = i_axi_fifo_ar_dly_cnt - 1;                                                                                              
                        force axi_fifo_if.arready = 1'b0;                                                                                          
                        force axi_fifo_if.arvalid = 1'b0;                                                                                          
                    end                                                                                                                     
                    else begin                                                                                                              
                        i_axi_fifo_ar_dly_cnt = $urandom_range(7,0);                                                                                      
                        release axi_fifo_if.arready;                                                                                               
                        release axi_fifo_if.arvalid;                                                                                               
                    end                                                                                                                     
                end                                                                                                                         
                else begin                                                                                                                  
                    release axi_fifo_if.arready;                                                                                                   
                    release axi_fifo_if.arvalid;                                                                                                   
                end                                                                                                                         
            end                                                                                                                             
        end: AXI_FIFO_AR_DLY                                                                                                                       
        logic [11:0] i_axi_fifo_r_dly_cnt;                                                                                                               
        bit AXI_FIFO_R_DLY_past_shake_stall;                                                                                                    
        always@(posedge core_clk)                                                                                                           
            AXI_FIFO_R_DLY_past_shake_stall <= axi_fifo_if.rvalid && !axi_fifo_if.rready;                                                                   
        initial begin: AXI_FIFO_R_DLY                                                                                                             
            i_axi_fifo_r_dly_cnt = $urandom_range(7,0);                                                                                                  
            forever begin                                                                                                                   
                @(negedge core_clk)                                                                                                         
                if (ctrl.rand_delays) begin                                                                                                 
                    if (|i_axi_fifo_r_dly_cnt && !AXI_FIFO_R_DLY_past_shake_stall) begin                                                                     
                        i_axi_fifo_r_dly_cnt = i_axi_fifo_r_dly_cnt - 1;                                                                                              
                        force axi_fifo_if.rready = 1'b0;                                                                                          
                        force axi_fifo_if.rvalid = 1'b0;                                                                                          
                    end                                                                                                                     
                    else begin                                                                                                              
                        i_axi_fifo_r_dly_cnt = $urandom_range(7,0);                                                                                      
                        release axi_fifo_if.rready;                                                                                               
                        release axi_fifo_if.rvalid;                                                                                               
                    end                                                                                                                     
                end                                                                                                                         
                else begin                                                                                                                  
                    release axi_fifo_if.rready;                                                                                                   
                    release axi_fifo_if.rvalid;                                                                                                   
                end                                                                                                                         
            end                                                                                                                             
        end: AXI_FIFO_R_DLY                                                                                                                       
        logic [11:0] i_axi_fifo_aw_dly_cnt;                                                                                                               
        bit AXI_FIFO_AW_DLY_past_shake_stall;                                                                                                    
        always@(posedge core_clk)                                                                                                           
            AXI_FIFO_AW_DLY_past_shake_stall <= i_axi_fifo.i_axi_sub.i_axi_sub_wr.axi_awvalid_q && !i_axi_fifo.i_axi_sub.i_axi_sub_wr.axi_awready_q;                                                                   
        initial begin: AXI_FIFO_AW_DLY                                                                                                             
            i_axi_fifo_aw_dly_cnt = $urandom_range(7,0);                                                                                                  
            forever begin                                                                                                                   
                @(negedge core_clk)                                                                                                         
                if (ctrl.rand_delays) begin                                                                                                 
                    if (|i_axi_fifo_aw_dly_cnt && !AXI_FIFO_AW_DLY_past_shake_stall) begin                                                                     
                        i_axi_fifo_aw_dly_cnt = i_axi_fifo_aw_dly_cnt - 1;                                                                                              
                        force i_axi_fifo.i_axi_sub.i_axi_sub_wr.axi_awready_q = 1'b0;                                                                                          
                        force i_axi_fifo.i_axi_sub.i_axi_sub_wr.axi_awvalid_q = 1'b0;                                                                                          
                    end                                                                                                                     
                    else begin                                                                                                              
                        i_axi_fifo_aw_dly_cnt = $urandom_range(7,0);                                                                                      
                        release i_axi_fifo.i_axi_sub.i_axi_sub_wr.axi_awready_q;                                                                                               
                        release i_axi_fifo.i_axi_sub.i_axi_sub_wr.axi_awvalid_q;                                                                                               
                    end                                                                                                                     
                end                                                                                                                         
                else begin                                                                                                                  
                    release i_axi_fifo.i_axi_sub.i_axi_sub_wr.axi_awready_q;                                                                                                   
                    release i_axi_fifo.i_axi_sub.i_axi_sub_wr.axi_awvalid_q;                                                                                                   
                end                                                                                                                         
            end                                                                                                                             
        end: AXI_FIFO_AW_DLY                                                                                                                       
        logic [11:0] i_axi_fifo_w_dly_cnt;                                                                                                               
        bit AXI_FIFO_W_DLY_past_shake_stall;                                                                                                    
        always@(posedge core_clk)                                                                                                           
            AXI_FIFO_W_DLY_past_shake_stall <= i_axi_fifo.i_axi_sub.i_axi_sub_wr.txn_wvalid && !i_axi_fifo.i_axi_sub.i_axi_sub_wr.txn_wready;                                                                   
        initial begin: AXI_FIFO_W_DLY                                                                                                             
            i_axi_fifo_w_dly_cnt = $urandom_range(7,0);                                                                                                  
            forever begin                                                                                                                   
                @(negedge core_clk)                                                                                                         
                if (ctrl.rand_delays) begin                                                                                                 
                    if (|i_axi_fifo_w_dly_cnt && !AXI_FIFO_W_DLY_past_shake_stall) begin                                                                     
                        i_axi_fifo_w_dly_cnt = i_axi_fifo_w_dly_cnt - 1;                                                                                              
                        force i_axi_fifo.i_axi_sub.i_axi_sub_wr.txn_wready = 1'b0;                                                                                          
                        force i_axi_fifo.i_axi_sub.i_axi_sub_wr.txn_wvalid = 1'b0;                                                                                          
                    end                                                                                                                     
                    else begin                                                                                                              
                        i_axi_fifo_w_dly_cnt = $urandom_range(7,0);                                                                                      
                        release i_axi_fifo.i_axi_sub.i_axi_sub_wr.txn_wready;                                                                                               
                        release i_axi_fifo.i_axi_sub.i_axi_sub_wr.txn_wvalid;                                                                                               
                    end                                                                                                                     
                end                                                                                                                         
                else begin                                                                                                                  
                    release i_axi_fifo.i_axi_sub.i_axi_sub_wr.txn_wready;                                                                                                   
                    release i_axi_fifo.i_axi_sub.i_axi_sub_wr.txn_wvalid;                                                                                                   
                end                                                                                                                         
            end                                                                                                                             
        end: AXI_FIFO_W_DLY                                                                                                                       
        logic [11:0] i_axi_fifo_b_dly_cnt;                                                                                                               
        bit AXI_FIFO_B_DLY_past_shake_stall;                                                                                                    
        always@(posedge core_clk)                                                                                                           
            AXI_FIFO_B_DLY_past_shake_stall <= axi_fifo_if_bvalid_force && !axi_fifo_if.bready;                                                                   
        initial begin: AXI_FIFO_B_DLY                                                                                                             
            i_axi_fifo_b_dly_cnt = $urandom_range(7,0);                                                                                                  
            forever begin                                                                                                                   
                @(negedge core_clk)                                                                                                         
                if (ctrl.rand_delays) begin                                                                                                 
                    if (|i_axi_fifo_b_dly_cnt && !AXI_FIFO_B_DLY_past_shake_stall) begin                                                                     
                        i_axi_fifo_b_dly_cnt = i_axi_fifo_b_dly_cnt - 1;                                                                                              
                        force axi_fifo_if.bready = 1'b0;                                                                                          
                        force axi_fifo_if_bvalid_force = 1'b0;                                                                                          
                    end                                                                                                                     
                    else begin                                                                                                              
                        i_axi_fifo_b_dly_cnt = $urandom_range(7,0);                                                                                      
                        release axi_fifo_if.bready;                                                                                               
                        release axi_fifo_if_bvalid_force;                                                                                               
                    end                                                                                                                     
                end                                                                                                                         
                else begin                                                                                                                  
                    release axi_fifo_if.bready;                                                                                                   
                    release axi_fifo_if_bvalid_force;                                                                                                   
                end                                                                                                                         
            end                                                                                                                             
        end: AXI_FIFO_B_DLY                                                                                                                       
    logic inject_read_err;
    logic inject_write_err;
    logic inject_write_err_pending;  
    logic [48-1:0] read_addr_reg;
    logic [48-1:0] write_addr_reg;
    logic err_addr_detected;
    logic err_addr_detected_1d;
    assign err_addr_detected = inject_read_err || inject_write_err ? 1'b1 : err_addr_detected_1d;
    always_ff@(posedge core_clk or negedge cptra_rst_b) begin
        if (!cptra_rst_b) begin
            read_addr_reg <= '0;
            write_addr_reg <= '0;
            inject_read_err <= 1'b0;
            inject_write_err <= 1'b0;
            inject_write_err_pending <= 1'b0;
            err_addr_detected_1d <= 1'b0;
        end else begin
            err_addr_detected_1d <= err_addr_detected;
            if (m_axi_if.arvalid && m_axi_if.arready) begin
                read_addr_reg <= m_axi_if.araddr;
                inject_read_err <= (addr_in_err_range(m_axi_if.araddr) && (err_addr_detected_1d == 0));
                if (addr_in_err_range(m_axi_if.araddr) && (err_addr_detected_1d == 0)) begin
                    $display("[%0t] TB: Injecting read err for address 0x%08h",$time, m_axi_if.araddr);
                end
            end
            if (m_axi_if.awvalid && m_axi_if.awready) begin
                write_addr_reg <= m_axi_if.awaddr;
                inject_write_err_pending <= (addr_in_err_range(m_axi_if.awaddr) && (err_addr_detected_1d == 0));
                if (addr_in_err_range(m_axi_if.awaddr) && (err_addr_detected_1d == 0)) begin
                    $display("[%0t] TB: Injecting write err for address 0x%08h",$time, m_axi_if.awaddr);
                end
            end
            if (inject_write_err_pending && m_axi_if.wvalid && m_axi_if.wready && m_axi_if.wlast) begin
                inject_write_err <= 1'b1;
                inject_write_err_pending <= 1'b0;
                $display("[%0t] TB: Write err response ready after wlast for address 0x%08h",$time, write_addr_reg);
            end
            if (m_axi_if.rvalid && m_axi_if.rready && m_axi_if.rlast) begin
                inject_read_err <= 1'b0;
            end
            if (m_axi_if.bvalid && m_axi_if.bready) begin
                inject_write_err <= 1'b0;
            end
        end
    end
    logic [1:0] sram_r_active;
    logic       sram_ar_hshake;
    logic       sram_rlast_hshake;
    logic [2:0] sram_w_active;
    logic       sram_aw_hshake;
    logic       sram_b_hshake;
    logic [1:0] fifo_r_active;
    logic       fifo_ar_hshake;
    logic       fifo_rlast_hshake;
    logic [2:0] fifo_w_active;
    logic       fifo_aw_hshake;
    logic       fifo_b_hshake;
    always_comb begin
        m_axi_if.arready          = (addr_in_err_range(m_axi_if.araddr) && (err_addr_detected_1d == 0))? 1'b1 :
                                    (m_axi_if.araddr[48-1:AXI_SRAM_ADDR_WIDTH] == 
                                     AXI_SRAM_BASE_ADDR[48-1:AXI_SRAM_ADDR_WIDTH]) ? 
                                     axi_sram_if.arready :
                                    (m_axi_if.araddr[48-1:AXI_FIFO_ADDR_WIDTH] == 
                                     AXI_FIFO_BASE_ADDR[48-1:AXI_FIFO_ADDR_WIDTH]) ? 
                                     axi_fifo_if.arready : 1'b0;
        m_axi_if.rdata            = sram_r_active ? axi_sram_if.rdata :
                                    fifo_r_active ? axi_fifo_if.rdata :
                                                    '0;
        m_axi_if.rresp            = inject_read_err ? axi_pkg::AXI_RESP_SLVERR:
                                    sram_r_active ? axi_sram_if.rresp :
                                    fifo_r_active ? axi_fifo_if.rresp :
                                                    axi_pkg::AXI_RESP_OKAY;
        m_axi_if.rid              = sram_r_active ? axi_sram_if.rid   :
                                    fifo_r_active ? axi_fifo_if.rid   :
                                                    '0;
        m_axi_if.ruser            = sram_r_active ? axi_sram_if.ruser :
                                    fifo_r_active ? axi_fifo_if.ruser :
                                                    '0;
        m_axi_if.rlast            = sram_r_active ? axi_sram_if.rlast :
                                    fifo_r_active ? axi_fifo_if.rlast :
                                                    '0;
        m_axi_if.rvalid           = sram_r_active ? axi_sram_if.rvalid :
                                    fifo_r_active ? axi_fifo_if.rvalid :
                                                    '0;
        m_axi_if.awready          = (addr_in_err_range(m_axi_if.awaddr) && (err_addr_detected_1d == 0)) ? 1'b1 :
                                    (m_axi_if.awaddr[48-1:AXI_SRAM_ADDR_WIDTH] == 
                                     AXI_SRAM_BASE_ADDR[48-1:AXI_SRAM_ADDR_WIDTH]) ? 
                                     axi_sram_if.awready :
                                    (m_axi_if.awaddr[48-1:AXI_FIFO_ADDR_WIDTH] == 
                                     AXI_FIFO_BASE_ADDR[48-1:AXI_FIFO_ADDR_WIDTH]) ? 
                                     axi_fifo_if.awready : 1'b0;
        m_axi_if.wready           = (inject_write_err || inject_write_err_pending) ? 1'b1 :
                                    sram_w_active ? axi_sram_if.wready :
                                    fifo_w_active ? axi_fifo_if.wready :
                                                    1'b0;
        m_axi_if.bresp            = inject_write_err ? axi_pkg::AXI_RESP_SLVERR :
                                    sram_w_active ? axi_sram_if.bresp :
                                    fifo_w_active ? axi_fifo_if.bresp :
                                                    axi_pkg::AXI_RESP_OKAY;
        m_axi_if.bid              = sram_w_active ? axi_sram_if.bid :
                                    fifo_w_active ? axi_fifo_if.bid :
                                                    '0;
        m_axi_if.buser            = sram_w_active ? axi_sram_if.buser :
                                    fifo_w_active ? axi_fifo_if.buser :
                                                    '0;
        m_axi_if.bvalid           = inject_write_err ? 1'b1 :
                                    sram_w_active ? axi_sram_if_bvalid_force :
                                    fifo_w_active ? axi_fifo_if_bvalid_force :
                                                    '0;
    end
    always_comb begin
        sram_ar_hshake    = axi_sram_if.arvalid && axi_sram_if.arready;
        sram_rlast_hshake = axi_sram_if.rvalid  && axi_sram_if.rready && axi_sram_if.rlast;
    end
    always_ff@(posedge core_clk or negedge cptra_rst_b) begin
        if (!cptra_rst_b) begin
            sram_r_active <= 2'b0;;
        end
        else begin
            case ({sram_ar_hshake,sram_rlast_hshake}) inside
                2'b00:
                    sram_r_active <= sram_r_active;
                2'b01:
                    if (sram_r_active)
                        sram_r_active <= sram_r_active - 2'b1;
                    else
                        $fatal("Read data with last, but no reads outstanding!");
                2'b10:
                    sram_r_active <= sram_r_active + 2'b1;
                2'b11:
                    sram_r_active <= sram_r_active;
            endcase
        end
    end
    always_comb begin
        sram_aw_hshake    = axi_sram_if.awvalid      && axi_sram_if.awready;
        sram_b_hshake     = axi_sram_if_bvalid_force && axi_sram_if.bready;
    end
    always_ff@(posedge core_clk or negedge cptra_rst_b) begin
        if (!cptra_rst_b) begin
            sram_w_active <= 3'b0;
        end
        else begin
            case ({sram_aw_hshake,sram_b_hshake}) inside
                2'b00:
                    sram_w_active <= sram_w_active;
                2'b01:
                    if (sram_w_active)
                        sram_w_active <= sram_w_active - 3'b1;
                    else
                        $fatal("Write response, but no writes outstanding!");
                2'b10:
                    sram_w_active <= sram_w_active + 3'b1;
                2'b11:
                    sram_w_active <= sram_w_active;
            endcase
        end
    end
    assign axi_sram_if.arvalid       = m_axi_if.arvalid
                                        && (m_axi_if.araddr[48-1:AXI_SRAM_ADDR_WIDTH]
                                            == AXI_SRAM_BASE_ADDR[48-1:AXI_SRAM_ADDR_WIDTH])  ;
    assign axi_sram_if.araddr        = m_axi_if.araddr[AXI_SRAM_ADDR_WIDTH-1:0];
    assign axi_sram_if.arburst       = m_axi_if.arburst;
    assign axi_sram_if.arsize        = m_axi_if.arsize ;
    assign axi_sram_if.arlen         = m_axi_if.arlen  ;
    assign axi_sram_if.aruser        = m_axi_if.aruser ;
    assign axi_sram_if.arid          = m_axi_if.arid   ;
    assign axi_sram_if.arlock        = m_axi_if.arlock ;
    assign axi_sram_if.rready        = sram_r_active ? m_axi_if.rready : '0;
    assign axi_sram_if.awvalid       = m_axi_if.awvalid && 
                                       !(addr_in_err_range(m_axi_if.awaddr) && (err_addr_detected_1d == 0))&&
                                       m_axi_if.awaddr[48-1:AXI_SRAM_ADDR_WIDTH] == 
                                       AXI_SRAM_BASE_ADDR[48-1:AXI_SRAM_ADDR_WIDTH];
    assign axi_sram_if.awaddr        = m_axi_if.awaddr[AXI_SRAM_ADDR_WIDTH-1:0];
    assign axi_sram_if.awburst       = m_axi_if.awburst;
    assign axi_sram_if.awsize        = m_axi_if.awsize ;
    assign axi_sram_if.awlen         = m_axi_if.awlen  ;
    assign axi_sram_if.awuser        = m_axi_if.awuser ;
    assign axi_sram_if.awid          = m_axi_if.awid   ;
    assign axi_sram_if.awlock        = m_axi_if.awlock ;
    logic sram_w_blocked;
    assign sram_w_blocked = inject_write_err || inject_write_err_pending;
    assign axi_sram_if.wvalid        = (sram_w_active && !sram_w_blocked) ? m_axi_if.wvalid : '0;
    assign axi_sram_if.wdata         = (sram_w_active && !sram_w_blocked) ? m_axi_if.wdata  : '0;
    assign axi_sram_if.wstrb         = (sram_w_active && !sram_w_blocked) ? m_axi_if.wstrb  : '0;
    assign axi_sram_if.wuser         = (sram_w_active && !sram_w_blocked) ? m_axi_if.wuser  : '0;
    assign axi_sram_if.wlast         = (sram_w_active && !sram_w_blocked) ? m_axi_if.wlast  : '0;
    assign axi_sram_if.bready        = sram_w_active ? m_axi_if.bready : '0;
    assign axi_sram_if_bvalid_force  = axi_sram_if.bvalid;
    caliptra_axi_sram #(
        .AW   (AXI_SRAM_ADDR_WIDTH     ),
        .DW   (CPTRA_AXI_DMA_DATA_WIDTH),
        .UW   (CPTRA_AXI_DMA_USER_WIDTH),
        .IW   (CPTRA_AXI_DMA_ID_WIDTH  ),
        .EX_EN(0                       )
    ) i_axi_sram (
        .clk(core_clk),
        .rst_n(cptra_rst_b),
        .s_axi_w_if(axi_sram_if.w_sub),
        .s_axi_r_if(axi_sram_if.r_sub)
    );
    initial i_axi_sram.i_sram.ram = '{default:'{default:8'h00}};
    always_comb begin
        fifo_ar_hshake    = axi_fifo_if.arvalid && axi_fifo_if.arready;
        fifo_rlast_hshake = axi_fifo_if.rvalid  && axi_fifo_if.rready && axi_fifo_if.rlast;
    end
    always_ff@(posedge core_clk or negedge cptra_rst_b) begin
        if (!cptra_rst_b) begin
            fifo_r_active <= 2'b0;;
        end
        else begin
            case ({fifo_ar_hshake,fifo_rlast_hshake}) inside
                2'b00:
                    fifo_r_active <= fifo_r_active;
                2'b01:
                    if (fifo_r_active)
                        fifo_r_active <= fifo_r_active - 2'b1;
                    else
                        $fatal("Read data with last, but no reads outstanding!");
                2'b10:
                    fifo_r_active <= fifo_r_active + 2'b1;
                2'b11:
                    fifo_r_active <= fifo_r_active;
            endcase
        end
    end
    always_comb begin
        fifo_aw_hshake    = axi_fifo_if.awvalid      && axi_fifo_if.awready;
        fifo_b_hshake     = axi_fifo_if_bvalid_force && axi_fifo_if.bready;
    end
    always_ff@(posedge core_clk or negedge cptra_rst_b) begin
        if (!cptra_rst_b) begin
            fifo_w_active <= 3'b0;
        end
        else begin
            case ({fifo_aw_hshake,fifo_b_hshake}) inside
                2'b00:
                    fifo_w_active <= fifo_w_active;
                2'b01:
                    if (fifo_w_active)
                        fifo_w_active <= fifo_w_active - 3'b1;
                    else
                        $fatal("Write response, but no writes outstanding!");
                2'b10:
                    fifo_w_active <= fifo_w_active + 3'b1;
                2'b11:
                    fifo_w_active <= fifo_w_active;
            endcase
        end
    end
    logic [31:0] fifo_aw_hshake_count, fifo_b_hshake_count;
    logic [31:0] fifo_b_hshake_count_expected;
    logic [11:0] awlen_active;
    logic awlen_busy;
    int awlen_active_q [$];
    always@(posedge core_clk or negedge cptra_rst_b) begin
        if (!cptra_rst_b) begin
            fifo_aw_hshake_count <= '0;
            fifo_b_hshake_count  <= '0;
        end
        else begin
            fifo_aw_hshake_count <= fifo_aw_hshake_count + (fifo_aw_hshake ? 32'h1 : 32'h0);
            fifo_b_hshake_count  <= fifo_b_hshake_count  + (fifo_b_hshake  ? 32'h1 : 32'h0);
        end
    end
    assign axi_fifo_if.arvalid       = m_axi_if.arvalid && m_axi_if.araddr[48-1:AXI_FIFO_ADDR_WIDTH] == AXI_FIFO_BASE_ADDR[48-1:AXI_FIFO_ADDR_WIDTH];
    assign axi_fifo_if.araddr        = m_axi_if.araddr[AXI_FIFO_ADDR_WIDTH-1:0];
    assign axi_fifo_if.arburst       = m_axi_if.arburst;
    assign axi_fifo_if.arsize        = m_axi_if.arsize ;
    assign axi_fifo_if.arlen         = m_axi_if.arlen  ;
    assign axi_fifo_if.aruser        = m_axi_if.aruser ;
    assign axi_fifo_if.arid          = m_axi_if.arid   ;
    assign axi_fifo_if.arlock        = m_axi_if.arlock ;
    assign axi_fifo_if.rready        = fifo_r_active ? m_axi_if.rready : '0;
    assign axi_fifo_if.awvalid       = m_axi_if.awvalid && 
                                       !(addr_in_err_range(m_axi_if.awaddr) && (err_addr_detected_1d == 0)) &&
                                       m_axi_if.awaddr[48-1:AXI_FIFO_ADDR_WIDTH] == 
                                       AXI_FIFO_BASE_ADDR[48-1:AXI_FIFO_ADDR_WIDTH];
    assign axi_fifo_if.awaddr        = m_axi_if.awaddr[AXI_FIFO_ADDR_WIDTH-1:0];
    assign axi_fifo_if.awburst       = m_axi_if.awburst;
    assign axi_fifo_if.awsize        = m_axi_if.awsize ;
    assign axi_fifo_if.awlen         = m_axi_if.awlen  ;
    assign axi_fifo_if.awuser        = m_axi_if.awuser ;
    assign axi_fifo_if.awid          = m_axi_if.awid   ;
    assign axi_fifo_if.awlock        = m_axi_if.awlock ;
    logic fifo_w_blocked;
    assign fifo_w_blocked = inject_write_err || inject_write_err_pending;
    assign axi_fifo_if.wvalid        = (fifo_w_active && !fifo_w_blocked) ? m_axi_if.wvalid : '0;
    assign axi_fifo_if.wdata         = (fifo_w_active && !fifo_w_blocked) ? m_axi_if.wdata  : '0;
    assign axi_fifo_if.wstrb         = (fifo_w_active && !fifo_w_blocked) ? m_axi_if.wstrb  : '0;
    assign axi_fifo_if.wuser         = (fifo_w_active && !fifo_w_blocked) ? m_axi_if.wuser  : '0;
    assign axi_fifo_if.wlast         = (fifo_w_active && !fifo_w_blocked) ? m_axi_if.wlast  : '0;
    assign axi_fifo_if.bready        = fifo_w_active ? m_axi_if.bready : '0;
    assign axi_fifo_if_bvalid_force  = axi_fifo_if.bvalid;
    caliptra_top_tb_axi_fifo #(
        .AW(AXI_FIFO_ADDR_WIDTH     ),
        .DW(CPTRA_AXI_DMA_DATA_WIDTH),
        .UW(CPTRA_AXI_DMA_USER_WIDTH),          
        .IW(CPTRA_AXI_DMA_ID_WIDTH  ),          
        .DEPTH(AXI_FIFO_SIZE_BYTES  )
    ) i_axi_fifo (
        .clk  (core_clk   ),
        .rst_n(cptra_rst_b),
        .s_axi_w_if(axi_fifo_if.w_sub),
        .s_axi_r_if(axi_fifo_if.r_sub),
        .auto_push            (ctrl.fifo_auto_push       ),
        .auto_pop             (ctrl.fifo_auto_pop        ),
        .fifo_clear           (ctrl.fifo_clear           ),
        .en_recovery_emulation(ctrl.en_recovery_emulation),
        .recovery_data_avail  (recovery_data_avail       ),
        .dma_gen_done         (ctrl.dma_gen_done         ),
        .dma_gen_block_size   (ctrl.dma_gen_block_size   )
    );
endmodule
`begin_keywords "1800-2023"
module caliptra_top_tb_axi_fifo #(
    parameter AW = 32,
    parameter DW = 64,
              BC = DW/8,        
              BW = $clog2(BC),  
    parameter UW = 32,          
    parameter IW = 1,           
              ID_NUM = 1 << IW, 
    parameter DEPTH = 16
)
(
    input clk,
    input rst_n,
    axi_if.w_sub s_axi_w_if,
    axi_if.r_sub s_axi_r_if,
    input  logic auto_push,
    input  logic auto_pop,
    input  logic fifo_clear,
    input  logic en_recovery_emulation,
    output logic recovery_data_avail,
    input  logic dma_gen_done,
    input  logic [99:0] [11:0] dma_gen_block_size
);
    import axi_pkg::*;
    localparam FIFO_BC = DEPTH;  
    localparam FIFO_BW = caliptra_prim_util_pkg::vbits((FIFO_BC/BC)+1);  
    int RECOVERY_BURST_TEST_SIZE;
    logic          dv;
    logic [AW-1:0] addr;  
    logic          write;
    logic [DW-1:0] wdata;  
    logic [DW-1:0] rdata;  
    logic          hold;
    logic          rd_error;
    logic          wr_error;
    logic               fifo_w_ready;
    logic               fifo_w_valid;
    logic [DW-1:0]      fifo_w_data;
    logic               fifo_r_ready;
    logic               fifo_r_valid;
    logic [DW-1:0]      fifo_r_data;
    logic [FIFO_BW-1:0] fifo_depth;
    logic               fifo_full, fifo_full_r;
    logic               fifo_empty, fifo_empty_r;
    logic [11:0] stall_down_count;
    logic [31:0] rand_w_data;
    logic        rand_w_valid;
    logic        rand_r_ready;
    axi_sub #(
        .AW   (AW),
        .DW   (DW),
        .UW   (UW),
        .IW   (IW),
        .EX_EN(0 ),
        .C_LAT(0 )
    ) i_axi_sub (
        .clk  (clk     ),
        .rst_n(rst_n   ),
        .s_axi_w_if(s_axi_w_if),
        .s_axi_r_if(s_axi_r_if),
        .dv      (dv      ),
        .addr    (addr    ),  
        .write   (write   ),
        .user    (        ),
        .id      (        ),
        .wdata   (wdata   ),
        .wstrb   (        ),
        .rdata   (rdata   ),
        .last    (        ),
        .size    (        ),
        .hld     (hold    ),
        .rd_err  (rd_error),
        .wr_err  (wr_error)
    );
    assign rd_error = 1'b0;
    assign wr_error = 1'b0;
    caliptra_prim_fifo_sync #(
      .Width            (DW  ),
      .Pass             (1'b0),  
      .Depth            (FIFO_BC/BC),
      .OutputZeroIfEmpty(1'b1),  
      .Secure           (1'b0)   
    ) i_fifo (
      .clk_i   (clk     ),
      .rst_ni  (rst_n   ),
      .clr_i   (fifo_clear),
      .wvalid_i(fifo_w_valid  ),
      .wready_o(fifo_w_ready  ),
      .wdata_i (fifo_w_data   ),
      .rvalid_o(fifo_r_valid),
      .rready_i(fifo_r_ready),
      .rdata_o (fifo_r_data ),
      .full_o  (fifo_full ),
      .depth_o (fifo_depth),
      .err_o   (          )
    );
    always_comb fifo_empty = fifo_depth == 0;
    always_ff @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            fifo_full_r  <= 1'b0;
            fifo_empty_r <= 1'b1;
        end
        else begin
            fifo_full_r  <= fifo_full;
            fifo_empty_r <= fifo_empty;
        end
    end
    always_comb begin
        fifo_w_valid = (dv &&  write) || rand_w_valid;
        fifo_r_ready = (dv && !write) || rand_r_ready;
        hold = write ? !fifo_w_ready : !fifo_r_valid;
        rdata = fifo_r_data;
        fifo_w_data = rand_w_valid ? rand_w_data : wdata;
    end
    initial begin
            stall_down_count = $urandom_range(7,0);
    end
    always@(posedge clk) begin
        if (auto_pop || auto_push) begin
            if (|stall_down_count)
                stall_down_count <= stall_down_count - 1;
            else
                stall_down_count <= $urandom_range(7,0);
            rand_w_data <= $urandom;
        end
        rand_w_valid <= !fifo_clear && rst_n && ((auto_push && (stall_down_count == 0)) || (rand_w_valid && !fifo_w_ready));  
        rand_r_ready <=                rst_n &&  (auto_pop  && (stall_down_count == 0)) && fifo_r_valid;
    end
    bit recovery_data_avail_in_not_empty;
    bit recovery_data_avail_in_thresh;
    bit recovery_data_avail_in_pulse;
    bit mode_not_empty;
    bit mode_thresh;
    bit mode_pulse;
    int thresh;
    logic en_recovery_emulation_d, en_recovery_emulation_p;
    logic recovery_data_avail_d, recovery_data_avail_p;
    logic [FIFO_BW-1:0] fifo_writes_since_avail;
    int fifo_writes_since_recovery_emu_start;
    int fifo_reads_since_recovery_emu_start;
    int recovery_data_avail_deassert_at_fifo_read_count;
    initial begin
        if ($test$plusargs("CLP_DMA_TB_MODE_NOT_EMPTY")) begin
            mode_not_empty = 1;
        end
        else if ($test$plusargs("CLP_DMA_TB_MODE_THRESH")) begin
            mode_thresh = 1;
        end
        else if ($test$plusargs("CLP_DMA_TB_MODE_PULSE")) begin
            mode_pulse = 1;
        end
        else begin
            mode_not_empty = 1;
        end
        $display("Randomized mode to %s", mode_pulse ? "mode_pulse" : mode_thresh ? "mode_thresh" : mode_not_empty ? "mode_not_empty" : "null");
        begin
            RECOVERY_BURST_TEST_SIZE = 256;  
        end
    end
    assign recovery_data_avail = recovery_data_avail_in_not_empty | recovery_data_avail_in_thresh | recovery_data_avail_in_pulse;
    assign recovery_data_avail_in_not_empty = !fifo_empty & mode_not_empty;
    assign recovery_data_avail_in_thresh = (fifo_depth >= thresh) & mode_thresh;
    assign en_recovery_emulation_p = en_recovery_emulation && !en_recovery_emulation_d;
    assign recovery_data_avail_p = recovery_data_avail && !recovery_data_avail_d;
    always_ff@(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            fifo_writes_since_recovery_emu_start <= '0;
            fifo_reads_since_recovery_emu_start  <= '0;
            recovery_data_avail_deassert_at_fifo_read_count <= '0;
        end
        else if (!en_recovery_emulation) begin
            fifo_writes_since_recovery_emu_start <= '0;
            fifo_reads_since_recovery_emu_start  <= '0;
            recovery_data_avail_deassert_at_fifo_read_count <= '0;
        end
        else begin
            fifo_writes_since_recovery_emu_start <= fifo_writes_since_recovery_emu_start + 32'(fifo_w_valid && fifo_w_ready);
            fifo_reads_since_recovery_emu_start  <= fifo_reads_since_recovery_emu_start  + 32'(fifo_r_valid && fifo_r_ready);
            recovery_data_avail_deassert_at_fifo_read_count <= recovery_data_avail_p && ~|recovery_data_avail_deassert_at_fifo_read_count ? 1 :
                                                               recovery_data_avail_p                                                      ? (recovery_data_avail_deassert_at_fifo_read_count + RECOVERY_BURST_TEST_SIZE/BC) :
                                                                                                                                             recovery_data_avail_deassert_at_fifo_read_count;
        end
    end
    always_ff@(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            en_recovery_emulation_d <= 1'b0;
            recovery_data_avail_d   <= 1'b0;
        end
        else begin
            en_recovery_emulation_d <= en_recovery_emulation;
            recovery_data_avail_d   <= recovery_data_avail_in_pulse && en_recovery_emulation;
        end
    end
    always_ff@(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            recovery_data_avail_in_pulse <= 1'b0;
        end
        else if (!en_recovery_emulation || !mode_pulse) begin
            recovery_data_avail_in_pulse <= 1'b0;
        end
        else if (fifo_writes_since_avail >= RECOVERY_BURST_TEST_SIZE/BC) begin
            recovery_data_avail_in_pulse <= 1'b1;
            if (recovery_data_avail_in_pulse == 1'b0)
                $display("SoC [%t]: Set recovery_data_avail_in_pulse", $time);
        end
        else if (fifo_r_valid && fifo_r_ready && (fifo_reads_since_recovery_emu_start == (recovery_data_avail_deassert_at_fifo_read_count - 1))) begin
            recovery_data_avail_in_pulse <= 1'b0;
        end
    end
    always_ff@(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            fifo_writes_since_avail <= '0;
        end
        else if (!en_recovery_emulation)
            fifo_writes_since_avail <= '0;
        else begin
            case ({(fifo_w_valid && fifo_w_ready),recovery_data_avail_p}) inside
                2'b00: fifo_writes_since_avail <= fifo_writes_since_avail;
                2'b01: fifo_writes_since_avail <= fifo_writes_since_avail - RECOVERY_BURST_TEST_SIZE/BC;
                2'b10: fifo_writes_since_avail <= fifo_writes_since_avail + 1;
                2'b11: fifo_writes_since_avail <= fifo_writes_since_avail - RECOVERY_BURST_TEST_SIZE/BC + 1;
            endcase
        end
    end
endmodule
`begin_keywords "1800-2023"
`begin_keywords "1800-2023"
module caliptra_top_cov_props();
endmodule
`begin_keywords "1800-2023"
module caliptra_top_cov_bind;
endmodule
`begin_keywords "1800-2023"
module jtagdpi #(
  parameter string Name = "jtag0",  
  parameter int ListenPort = 44853  
)(
  input  logic clk_i,
  input  logic rst_ni,
  output logic jtag_tck,
  output logic jtag_tms,
  output logic jtag_tdi,
  input  logic jtag_tdo,
  output logic jtag_trst_n,
  output logic jtag_srst_n
);
  import "DPI-C"
  function chandle jtagdpi_create(input string name, input int listen_port);
  import "DPI-C"
  function void jtagdpi_tick(input chandle ctx, output bit tck, output bit tms,
                             output bit tdi, output bit trst_n,
                             output bit srst_n, input bit tdo);
  import "DPI-C"
  function void jtagdpi_close(input chandle ctx);
  chandle ctx;
  initial begin
    ctx = jtagdpi_create(Name, ListenPort);
  end
  final begin
    jtagdpi_close(ctx);
    ctx = null;
  end
  always_ff @(posedge clk_i, negedge rst_ni) begin
    jtagdpi_tick(ctx, jtag_tck, jtag_tms, jtag_tdi, jtag_trst_n, jtag_srst_n,
                 jtag_tdo);
  end
endmodule
`begin_keywords "1800-2023"
module caliptra_ss_top_sva
  import otp_ctrl_pkg::*;
  import otp_ctrl_part_pkg::*;
  import otp_ctrl_reg_pkg::*;
  import lc_ctrl_pkg::*;
  import lc_ctrl_state_pkg::*;
  import caliptra_prim_mubi_pkg::*;
  ();
  logic dai_for_secret_partition;
  assign dai_for_secret_partition = (caliptra_ss_top_tb.caliptra_ss_dut.u_otp_ctrl.u_fuse_ctrl_filter.core_axi_wr_req.awvalid) &&
                                    (caliptra_ss_top_tb.caliptra_ss_dut.u_otp_ctrl.u_fuse_ctrl_filter.core_axi_wr_req.awaddr ==
                                     (32'h70000080)) &&
                                    (caliptra_ss_top_tb.caliptra_ss_dut.u_otp_ctrl.dai_addr + 7 >= SecretManufPartitionOffset &&
                                     caliptra_ss_top_tb.caliptra_ss_dut.u_otp_ctrl.dai_addr < SwManufPartitionOffset);
  logic user_other_than_caliptra;
  assign user_other_than_caliptra = (caliptra_ss_top_tb.caliptra_ss_dut.u_otp_ctrl.u_fuse_ctrl_filter.core_axi_wr_req.awuser !=
                                     caliptra_ss_top_tb.cptra_ss_strap_caliptra_dma_axi_user_i);
  logic unpriv_dai_access;
  assign unpriv_dai_access = dai_for_secret_partition && user_other_than_caliptra;
  logic dai_read_req, dai_write_req, dai_zeroize_req;
  assign dai_read_req    = caliptra_ss_top_tb.caliptra_ss_dut.u_otp_ctrl.dai_req && (caliptra_ss_top_tb.caliptra_ss_dut.u_otp_ctrl.dai_cmd == {DaiRead});
  assign dai_write_req   = caliptra_ss_top_tb.caliptra_ss_dut.u_otp_ctrl.dai_req && (caliptra_ss_top_tb.caliptra_ss_dut.u_otp_ctrl.dai_cmd == {DaiWrite});
  assign dai_zeroize_req = caliptra_ss_top_tb.caliptra_ss_dut.u_otp_ctrl.dai_req && (caliptra_ss_top_tb.caliptra_ss_dut.u_otp_ctrl.dai_cmd == {DaiZeroize});
  cascade_wdt_t1_pet: assert property (
    @(posedge caliptra_ss_top_tb.core_clk)
    (caliptra_ss_top_tb.caliptra_ss_dut.mci_top_i.i_mci_wdt_top.timer1_restart && caliptra_ss_top_tb.caliptra_ss_dut.mci_top_i.i_mci_wdt_top.timer1_en && !caliptra_ss_top_tb.caliptra_ss_dut.mci_top_i.i_mci_wdt_top.timer2_en && !caliptra_ss_top_tb.caliptra_ss_dut.mci_top_i.i_mci_wdt_top.t1_timeout) |=> (caliptra_ss_top_tb.caliptra_ss_dut.mci_top_i.i_mci_wdt_top.i_wdt.timer1_count == 'h0)
  )
  else $display("SVA ERROR: [Cascade] WDT Timer1 did not restart on pet");
  cascade_wdt_t2_pet: assert property (
    @(posedge caliptra_ss_top_tb.core_clk)
    (caliptra_ss_top_tb.caliptra_ss_dut.mci_top_i.i_mci_wdt_top.timer2_restart && !caliptra_ss_top_tb.caliptra_ss_dut.mci_top_i.i_mci_wdt_top.timer2_en && !caliptra_ss_top_tb.caliptra_ss_dut.mci_top_i.i_mci_wdt_top.t2_timeout) |=> (caliptra_ss_top_tb.caliptra_ss_dut.mci_top_i.i_mci_wdt_top.i_wdt.timer2_count == 'h0)
  )
  else $display("SVA ERROR: [Cascade] WDT Timer2 did not restart on pet");
  cascade_wdt_t1_service: assert property (
    @(posedge caliptra_ss_top_tb.core_clk)
    (caliptra_ss_top_tb.caliptra_ss_dut.mci_top_i.i_mci_wdt_top.i_wdt.wdt_timer1_timeout_serviced_qual && caliptra_ss_top_tb.caliptra_ss_dut.mci_top_i.i_mci_wdt_top.timer1_en && !caliptra_ss_top_tb.caliptra_ss_dut.mci_top_i.i_mci_wdt_top.timer2_en && !caliptra_ss_top_tb.caliptra_ss_dut.mci_top_i.i_mci_wdt_top.t2_timeout) |=> (caliptra_ss_top_tb.caliptra_ss_dut.mci_top_i.i_mci_wdt_top.i_wdt.timer1_count == 'h0)
  )
  else $display("SVA ERROR: [Cascade] WDT Timer1 did not restart after interrupt service");
  cascade_wdt_t2_service: assert property (
    @(posedge caliptra_ss_top_tb.core_clk)
    (caliptra_ss_top_tb.caliptra_ss_dut.mci_top_i.i_mci_wdt_top.i_wdt.wdt_timer2_timeout_serviced_qual && !caliptra_ss_top_tb.caliptra_ss_dut.mci_top_i.i_mci_wdt_top.timer2_en) |=> (caliptra_ss_top_tb.caliptra_ss_dut.mci_top_i.i_mci_wdt_top.i_wdt.timer2_count == 'h0)
  )
  else $display("SVA ERROR: [Cascade] WDT Timer2 did not restart after interrupt service");
  independent_wdt_t1_pet: assert property (
    @(posedge caliptra_ss_top_tb.core_clk)
    (caliptra_ss_top_tb.caliptra_ss_dut.mci_top_i.i_mci_wdt_top.timer1_restart && caliptra_ss_top_tb.caliptra_ss_dut.mci_top_i.i_mci_wdt_top.timer1_en && caliptra_ss_top_tb.caliptra_ss_dut.mci_top_i.i_mci_wdt_top.timer2_en && !caliptra_ss_top_tb.caliptra_ss_dut.mci_top_i.i_mci_wdt_top.t1_timeout) |=> (caliptra_ss_top_tb.caliptra_ss_dut.mci_top_i.i_mci_wdt_top.i_wdt.timer1_count == 'h0)
  )
  else $display("SVA ERROR: [Independent] WDT Timer1 did not restart on pet");
  independent_wdt_t2_pet: assert property (
    @(posedge caliptra_ss_top_tb.core_clk)
    (caliptra_ss_top_tb.caliptra_ss_dut.mci_top_i.i_mci_wdt_top.timer2_restart && caliptra_ss_top_tb.caliptra_ss_dut.mci_top_i.i_mci_wdt_top.timer2_en && !caliptra_ss_top_tb.caliptra_ss_dut.mci_top_i.i_mci_wdt_top.t2_timeout) |=> (caliptra_ss_top_tb.caliptra_ss_dut.mci_top_i.i_mci_wdt_top.i_wdt.timer2_count == 'h0)
  )
  else $display("SVA ERROR: [Independent] WDT Timer2 did not restart on pet");
  independent_wdt_t1_service: assert property (
    @(posedge caliptra_ss_top_tb.core_clk)
