        .WIDTH(WIDTH)
    ) add_inst_0 (
        .clk(clk),
        .reset_n(reset_n),
        .zeroize(zeroize),
        .sub(1'b0),
        .u(opu_i),
        .v(opv_i),
        .rnd(rnd_i[3:0]),
        .rnd_24bit({rnd_i[0][9:0], rnd_i[4]}),
        .res(add_res)
    );
    always_comb begin
        for (int i = 0; i < WIDTH; i++) begin
            add_res_unpacked[i][0] = add_res[0][i];
            add_res_unpacked[i][1] = add_res[1][i];
        end
    end
    abr_delay_masked_shares #(
        .WIDTH(WIDTH),
        .N(MLKEM_MASKED_MULT_LATENCY-1)  
    ) add_res_delay_inst (
        .clk(clk),
        .rst_n(reset_n),
        .zeroize(zeroize),
        .input_reg(add_res_unpacked),
        .delayed_reg(add_res_unpacked_reg)
    );
    always_comb begin
        for (int i = 0; i < WIDTH; i++) begin
            add_res_reg[0][i] = add_res_unpacked_reg[i][0];
            add_res_reg[1][i] = add_res_unpacked_reg[i][1];
        end
    end
    ntt_mlkem_masked_BFU_add_sub #(
        .WIDTH(WIDTH)
    ) sub_inst_0 (
        .clk(clk),
        .reset_n(reset_n),
        .zeroize(zeroize),
        .sub(1'b1),
        .u(opu_i),
        .v(opv_i),
        .rnd(rnd_i[4:1]),  
        .rnd_24bit({rnd_i[1][9:0], rnd_i[0]}),
        .res(sub_res)  
    );
    always_ff @(posedge clk or negedge reset_n) begin
        if (!reset_n) begin
            for (int i = 0; i < MLKEM_MASKED_ADD_SUB_LATENCY; i++) begin
                w_reg[i] <= 'h0;
            end
        end
        else if (zeroize) begin
            for (int i = 0; i < MLKEM_MASKED_ADD_SUB_LATENCY; i++) begin
                w_reg[i] <= 'h0;
            end
        end
        else begin
            w_reg <= {opw_i, w_reg[MLKEM_MASKED_ADD_SUB_LATENCY-1:1]};
        end
    end
    ntt_mlkem_masked_BFU_mult #(
        .WIDTH(WIDTH)
    ) mult_inst_0 (
        .clk(clk),
        .reset_n(reset_n),
        .zeroize(zeroize),
        .u(sub_res),
        .v(w_reg[0]),
        .rnd({rnd_i[0], rnd_i[1], rnd_i[2], rnd_i[3], rnd_i[4]}),
        .rnd_24bit({rnd_i[4][9:0], rnd_i[0]}),
        .res(mul_res)
    );
    always_ff @(posedge clk or negedge reset_n) begin
        if (!reset_n) begin
            u_o_reg <= 'h0;
        end
        else if (zeroize) begin
            u_o_reg <= 'h0;
        end
        else begin
            u_o_reg <= add_res_reg;
        end
    end
    always_comb begin
        u_o = u_o_reg;
        v_o = mul_res;
    end 
