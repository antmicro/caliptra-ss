output logic ROP                 
);                                          
reg [(44-1):0] ram_core [(64-1):0];   
always @(posedge CLK) begin                 
   if (ME && WE) begin ram_core[ADR] <= D & WEM | ~WEM & ram_core[ADR]; Q <= 'x; end  
   if (ME && ~WE) Q <= ram_core[ADR];          
end                                         
assign ROP = ME;                            
endmodule
