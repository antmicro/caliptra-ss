        .rst_n(rst_n),
        .s_axi_if(s_axi_w_if),
        .dv   (w_dv   ),
        .addr (w_addr ),
        .user (w_user ),
        .id   (w_id   ),
        .wdata(w_wdata),
        .wstrb(w_wstrb),
        .wsize(w_size ),
        .last (w_last ),
        .hld  (w_hld  ),
        .err  (w_err  )
    );
    axi_sub_rd #(
        .AW(AW),
        .DW(DW),
        .UW(UW),
        .IW(IW),
        .C_LAT(C_LAT)
    ) i_axi_sub_rd (
        .clk  (clk  ),
        .rst_n(rst_n),
        .s_axi_if(s_axi_r_if),
        .dv   (r_dv   ),
        .addr (r_addr ),
        .user (r_user ),
        .id   (r_id   ),
        .size (r_size ),
        .last (r_last ),
        .hld  (r_hld  ),
        .err  (r_err  ),
        .rdata(r_rdata)
    );
    axi_sub_arb #(
        .AW(AW),
        .DW(DW),
        .UW(UW),
        .IW(IW),
        .C_LAT(C_LAT)
    ) i_axi_sub_arb (
