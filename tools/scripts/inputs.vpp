    CCC_BCAST_ENEC      = 8'h00,   
    CCC_BCAST_DISEC     = 8'h01,   
    CCC_BCAST_ENTAS0    = 8'h02,   
    CCC_BCAST_ENTAS1    = 8'h03,   
    CCC_BCAST_ENTAS2    = 8'h04,   
    CCC_BCAST_ENTAS3    = 8'h05,   
    CCC_BCAST_RSTDAA    = 8'h06,   
    CCC_BCAST_ENTDAA    = 8'h07,   
    CCC_BCAST_DEFTGTS   = 8'h08,   
    CCC_BCAST_SETMWL    = 8'h09,   
    CCC_BCAST_SETMRL    = 8'h0A,   
    CCC_BCAST_ENTTM     = 8'h0B,   
    CCC_BCAST_SETBUSCON = 8'h0C,   
    CCC_BCAST_ENDXFER   = 8'h12,   
    CCC_BCAST_ENTHDR0   = 8'h20,   
    CCC_BCAST_ENTHDR1   = 8'h21,   
    CCC_BCAST_ENTHDR2   = 8'h22,   
    CCC_BCAST_ENTHDR3   = 8'h23,   
    CCC_BCAST_ENTHDR4   = 8'h24,   
    CCC_BCAST_ENTHDR5   = 8'h25,   
    CCC_BCAST_ENTHDR6   = 8'h26,   
    CCC_BCAST_ENTHDR7   = 8'h27,   
    CCC_BCAST_SETXTIME  = 8'h28,   
    CCC_BCAST_SETAASA   = 8'h29,   
    CCC_BCAST_RSTACT    = 8'h2A,   
    CCC_BCAST_DEFGRPA   = 8'h2B,   
    CCC_BCAST_RSTGRPA   = 8'h2C,   
    CCC_BCAST_MLANE     = 8'h2D,   
    CCC_DIRECT_ENEC     = 8'h80,   
