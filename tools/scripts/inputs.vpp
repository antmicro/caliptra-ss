module ntt_twiddle_lookup 
    import ntt_defines_pkg::*;
#(
    parameter ADDR_WIDTH = 7,
    parameter DATA_WIDTH = 24,
    parameter KYBER_DATA_WIDTH = 12
)
(
    input mode_t mode,
    input wire [ADDR_WIDTH-1:0] raddr,
    input wire mlkem,
    output logic [(3*DATA_WIDTH)-1:0] rdata
