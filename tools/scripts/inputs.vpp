   output logic [1:0]                iccm_rd_ecc_double_err,  
   output logic                      iccm_dma_rd_ecc_single_err,  
   output logic                      iccm_dma_rd_ecc_double_err,  
   output logic                      ic_error_start,          
   output logic                      ifu_async_error_start,   
   output logic                      iccm_dma_sb_error,       
   output logic [1:0]                ic_fetch_val_f,          
   output logic [31:0]               ic_data_f,               
   output logic [63:0]               ic_premux_data,          
   output logic                      ic_sel_premux_data,      
   input  el2_cache_debug_pkt_t     dec_tlu_ic_diag_pkt ,        
   input  logic                      dec_tlu_core_ecc_disable,    
   output logic                      ifu_ic_debug_rd_data_valid,  
   output logic                      iccm_buf_correct_ecc,
   output logic                      iccm_correction_state,
   input  logic                      ifu_pmp_error,
   input  logic         scan_mode
   );
 localparam   NUM_OF_BEATS = 8 ;
   logic [31:3]    ifu_ic_req_addr_f;
   logic           uncacheable_miss_in ;
   logic           uncacheable_miss_ff;
   logic           bus_ifu_wr_en     ;
