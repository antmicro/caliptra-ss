    output logic dec_i0_branch_d,       
    output logic dec_i0_select_pc_d,   
    output logic [31:1] dec_i0_pc_d,              
    output logic [ 3:0] dec_i0_rs1_bypass_en_d,   
    output logic [ 3:0] dec_i0_rs2_bypass_en_d,   
    output logic [31:0] dec_i0_result_r,   
    output el2_lsu_pkt_t lsu_p,            
    output logic         dec_qual_lsu_d,   
    output el2_mul_pkt_t mul_p,            
    output el2_div_pkt_t div_p,            
    output logic         dec_div_cancel,   
    output logic [11:0] dec_lsu_offset_d,   
    output logic        dec_csr_ren_d,     
    output logic [31:0] dec_csr_rddata_d,  
    output logic dec_tlu_flush_lower_r,   
    output logic dec_tlu_flush_lower_wb,
    output logic [31:1] dec_tlu_flush_path_r,   
    output logic        dec_tlu_i0_kill_writeb_r,     
    output logic dec_tlu_fence_i_r,   
    output logic [31:1] pred_correct_npc_x,   
    output el2_br_tlu_pkt_t dec_tlu_br0_r_pkt,   
    output logic dec_tlu_perfcnt0,   
    output logic dec_tlu_perfcnt1,   
    output logic dec_tlu_perfcnt2,   
    output logic dec_tlu_perfcnt3,   
    output el2_predict_pkt_t dec_i0_predict_p_d,   
    output logic [pt.BHT_GHR_SIZE-1:0] i0_predict_fghr_d,   
    output logic [pt.BTB_ADDR_HI:pt.BTB_ADDR_LO] i0_predict_index_d,   
    output logic [pt.BTB_BTAG_SIZE-1:0] i0_predict_btag_d,   
    output logic [$clog2(pt.BTB_SIZE)-1:0] dec_fa_error_index,   
    output logic dec_lsu_valid_raw_d,
    output logic [31:0] dec_tlu_mrac_ff,   
    output logic [1:0] dec_data_en,   
    output logic [1:0] dec_ctl_en,
    input logic [15:0] ifu_i0_cinst,   
    output el2_trace_pkt_t trace_rv_trace_pkt,   
    output el2_pmp_cfg_pkt_t        pmp_pmpcfg [pt.PMP_ENTRIES],
    output logic             [31:0] pmp_pmpaddr[pt.PMP_ENTRIES],
    output logic priv_mode,
    output logic priv_mode_eff,
    output logic priv_mode_ns,
    output el2_mseccfg_pkt_t mseccfg,
    output logic dec_tlu_external_ldfwd_disable,   
    output logic dec_tlu_sideeffect_posted_disable,   
    output logic dec_tlu_core_ecc_disable,   
    output logic dec_tlu_bpred_disable,   
    output logic dec_tlu_wb_coalescing_disable,   
    output logic [2:0] dec_tlu_dma_qos_prty,   
    output logic dec_tlu_misc_clk_override,    
    output logic dec_tlu_ifu_clk_override,     
    output logic dec_tlu_lsu_clk_override,     
    output logic dec_tlu_bus_clk_override,     
    output logic dec_tlu_pic_clk_override,     
    output logic dec_tlu_picio_clk_override,   
    output logic dec_tlu_dccm_clk_override,    
    output logic dec_tlu_icm_clk_override,     
    output logic dec_tlu_i0_commit_cmt,   
    input  logic scan_mode                
);
  logic dec_tlu_dec_clk_override;   
  logic clk_override;
  logic dec_ib0_valid_d;
  logic dec_pmu_instr_decoded;
  logic dec_pmu_decode_stall;
  logic dec_pmu_presync_stall;
  logic dec_pmu_postsync_stall;
  logic dec_tlu_wr_pause_r;   
  logic [4:0] dec_i0_rs1_d;
  logic [4:0] dec_i0_rs2_d;
  logic [31:0] dec_i0_instr_d;
  logic dec_tlu_trace_disable;
  logic dec_tlu_pipelining_disable;
  logic [4:0] dec_i0_waddr_r;
  logic dec_i0_wen_r;
  logic [31:0] dec_i0_wdata_r;
  logic dec_csr_wen_r;   
  logic [11:0] dec_csr_rdaddr_r;   
  logic [11:0] dec_csr_wraddr_r;   
  logic [31:0] dec_csr_wrdata_r;   
  logic [11:0] dec_csr_rdaddr_d;   
  logic dec_csr_legal_d;   
  logic dec_csr_wen_unq_d;   
  logic dec_csr_any_unq_d;   
  logic dec_csr_stall_int_ff;   
  el2_trap_pkt_t dec_tlu_packet_r;
  logic dec_i0_pc4_d;
