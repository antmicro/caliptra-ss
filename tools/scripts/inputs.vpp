  #(
    parameter SRAM_LATENCY = 1
  )
(
  input logic clk_i,
  abr_mem_if.resp abr_memory_export
);
  logic [ABR_MEM_W1_DATA_W-1:0] w1_mem_rdata_o [SRAM_LATENCY:1]; 
  abr_1r1w_ram 
  #( .DEPTH(ABR_MEM_W1_DEPTH), 
     .DATA_WIDTH(ABR_MEM_W1_DATA_W)) 
   abr_w1_mem_inst
   (
      .clk_i(clk_i),
      .we_i(abr_memory_export.w1_mem_we_i),
      .waddr_i(abr_memory_export.w1_mem_waddr_i),
      .wdata_i(abr_memory_export.w1_mem_wdata_i),
      .re_i(abr_memory_export.w1_mem_re_i),
      .raddr_i(abr_memory_export.w1_mem_raddr_i),
      .rdata_o(w1_mem_rdata_o[1])
   );
   generate
     if (SRAM_LATENCY > 1) begin : w1_memgen_lat
       for (genvar g_i = 2; g_i <= SRAM_LATENCY; g_i = g_i + 1) begin : w1_memgen_lat_stages
         always_ff @(posedge clk_i) begin
           w1_mem_rdata_o[g_i] <= w1_mem_rdata_o[g_i-1];
         end
       end
     end
   endgenerate
   assign abr_memory_export.w1_mem_rdata_o = w1_mem_rdata_o[SRAM_LATENCY];
