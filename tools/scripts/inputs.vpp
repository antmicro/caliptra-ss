   assign iccm_ready           = ifc_dma_access_q_ok ;
   logic [1:0]        iccm_ecc_word_enable;
    if (pt.ICCM_ENABLE == 1 ) begin: iccm_enabled
         logic  [3:2] dma_mem_addr_ff  ;
         logic  iccm_dma_rden    ;
         logic  iccm_dma_ecc_error_in;
