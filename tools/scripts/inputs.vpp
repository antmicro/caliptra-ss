  assign event_cs_cmd_req_done = sw_sts_ack;
  assign event_cs_entropy_req = entropy_src_hw_if_o.es_req;
  assign event_cs_hw_inst_exc = |hw_exception_sts;
  assign cmd_entropy_avail = entropy_src_hw_if_i.es_ack;
