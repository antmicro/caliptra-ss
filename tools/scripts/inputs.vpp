    input_ready_we
  };
  caliptra_prim_buf #(
    .Width(NumOutBufBits)
  ) u_caliptra_prim_buf_out (
    .in_i(out),
    .out_o(out_buf)
  );
  assign {ctrl_we_o,
          ctrl_gcm_we_o,
          gcm_init_done_o,
          alert_o,
          data_in_we_o,
          data_out_sel_o,
