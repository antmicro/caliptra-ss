   output logic                            lsu_imprecise_error_load_any,   
   output logic                            lsu_imprecise_error_store_any,  
   output logic [31:0]                     lsu_imprecise_error_addr_any,   
   output logic                               lsu_nonblock_load_valid_m,       
   output logic [pt.LSU_NUM_NBLOAD_WIDTH-1:0] lsu_nonblock_load_tag_m,         
   output logic                               lsu_nonblock_load_inv_r,         
   output logic [pt.LSU_NUM_NBLOAD_WIDTH-1:0] lsu_nonblock_load_inv_tag_r,     
   output logic                               lsu_nonblock_load_data_valid,    
   output logic                               lsu_nonblock_load_data_error,    
   output logic [pt.LSU_NUM_NBLOAD_WIDTH-1:0] lsu_nonblock_load_data_tag,      
   output logic [31:0]                        lsu_nonblock_load_data,          
   output logic                            lsu_pmu_load_external_m,         
   output logic                            lsu_pmu_store_external_m,        
   output logic                            lsu_pmu_misaligned_m,            
   output logic                            lsu_pmu_bus_trxn,                
   output logic                            lsu_pmu_bus_misaligned,          
   output logic                            lsu_pmu_bus_error,               
   output logic                            lsu_pmu_bus_busy,                
   input                                   el2_trigger_pkt_t [3:0] trigger_pkt_any,  
   output logic [3:0]                      lsu_trigger_match_m,                       
   output logic                            dccm_wren,        
   output logic                            dccm_rden,        
   output logic [pt.DCCM_BITS-1:0]         dccm_wr_addr_lo,  
   output logic [pt.DCCM_BITS-1:0]         dccm_wr_addr_hi,  
   output logic [pt.DCCM_BITS-1:0]         dccm_rd_addr_lo,  
   output logic [pt.DCCM_BITS-1:0]         dccm_rd_addr_hi,  
   output logic [pt.DCCM_FDATA_WIDTH-1:0]  dccm_wr_data_lo,  
   output logic [pt.DCCM_FDATA_WIDTH-1:0]  dccm_wr_data_hi,  
   input logic [pt.DCCM_FDATA_WIDTH-1:0]   dccm_rd_data_lo,  
   input logic [pt.DCCM_FDATA_WIDTH-1:0]   dccm_rd_data_hi,  
