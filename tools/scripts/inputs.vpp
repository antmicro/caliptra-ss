`begin_keywords "1800-2023"
module el2_ram #(depth=4096, width=39) (
input logic [$clog2(depth)-1:0] ADR,
input logic [(width-1):0] D,
output logic [(width-1):0] Q,
input logic WE,              
input logic ME,              
input logic CLK,             
input logic TEST1,           
input logic RME,             
input logic  [3:0] RM,       
input logic LS,              
input logic DS,              
input logic SD,              
input logic TEST_RNM,        
input logic BC1,             
input logic BC2,             
output logic ROP
);
reg [(width-1):0] ram_core [(depth-1):0];
always @(posedge CLK) begin
   if (ME && WE) begin ram_core[ADR] <= D; Q <= 'x; end
   if (ME && ~WE) Q <= ram_core[ADR];
end
endmodule
module ram_32768x39(               
   input logic [$clog2(32768)-1:0] ADR,     
   input logic [(39-1):0] D,             
   output logic [(39-1):0] Q,            
input logic WE,              
input logic ME,              
input logic CLK,             
input logic TEST1,           
input logic RME,             
input logic  [3:0] RM,       
input logic LS,              
input logic DS,              
input logic SD,              
input logic TEST_RNM,        
input logic BC1,             
input logic BC2,             
output logic ROP                 
);                                          
reg [(39-1):0] ram_core [(32768-1):0];   
always @(posedge CLK) begin                 
   if (ME && WE) begin ram_core[ADR] <= D; Q <= 'x; end  
   if (ME && ~WE) Q <= ram_core[ADR];       
end                                         
assign ROP = ME;                            
endmodule
