package prim_generic_otp_pkg;
  parameter int CmdWidth = 7;
  parameter int ErrWidth = 3;
  typedef enum logic [CmdWidth-1:0] {
    Read     = 7'b1111010,
    Write    = 7'b1001001,
    ReadRaw  = 7'b1010100,
    WriteRaw = 7'b1100111,
