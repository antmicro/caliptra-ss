      .s_cpuif_rd_data(s_cpuif_rd_data),
      .s_cpuif_wr_ack(s_cpuif_wr_ack),   
      .s_cpuif_wr_err(s_cpuif_wr_err),
      .hwif_in (hwif_in),
      .hwif_out(hwif_out_o)
  );
