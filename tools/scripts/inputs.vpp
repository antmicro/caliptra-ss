module abr_masked_OR
(
    input wire clk,
    input wire rst_n,
    input wire zeroize,
    input wire rnd,
    input wire [1:0] x,
    input wire [1:0] y,
    output logic [1:0] z
);
    logic inv_x0, inv_y0;
    logic [1:0] z_int;
    always_comb begin
        inv_x0 = x[0] ^ 1'b1;
        inv_y0 = y[0] ^ 1'b1;    
    end
    abr_masked_AND and_inst0 (
        .clk(clk),
        .rst_n(rst_n),
        .zeroize(zeroize),
        .x({x[1], inv_x0}),
        .y({y[1], inv_y0}),
        .rnd(rnd),
        .c(z_int)
    );
    always_comb z[0] = z_int[0];
    always_comb z[1] = z_int[1] ^ 1'b1;
endmodule
