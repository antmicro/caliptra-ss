    parameter EX_EN = 0,    
    parameter C_LAT = 0     
) (
    input clk,
    input rst_n,
    axi_if.w_sub s_axi_w_if,
    axi_if.r_sub s_axi_r_if,
    output logic          dv,
    output logic [AW-1:0] addr,  
    output logic          write,
    output logic [UW-1:0] user,
    output logic [IW-1:0] id,
    output logic [DW-1:0] wdata,  
    output logic [BC-1:0] wstrb,  
    output logic [2:0]    size,
    input  logic [DW-1:0] rdata,  
    output logic          last,  
    input  logic          hld,
    input  logic          rd_err,
    input  logic          wr_err
);
    logic          r_dv;
    logic [AW-1:0] r_addr;   
    logic [UW-1:0] r_user;
    logic [IW-1:0] r_id;
    logic [2:0]    r_size;
    logic          r_last;   
    logic          r_hld;
    logic          r_err;
    logic [DW-1:0] r_rdata;  
    logic          w_dv;
    logic [AW-1:0] w_addr;   
    logic [UW-1:0] w_user;
    logic [IW-1:0] w_id;
    logic [DW-1:0] w_wdata;  
    logic [BC-1:0] w_wstrb;  
