`begin_keywords "1800-2023"
module abr_1r1w_ram #(
     parameter DEPTH      = 64
    ,parameter DATA_WIDTH = 32
    ,parameter ADDR_WIDTH = $clog2(DEPTH)
    )
    (
    input  logic                       clk_i,
    input  logic                       we_i,
    input  logic [ADDR_WIDTH-1:0]      waddr_i,
    input  logic [DATA_WIDTH-1:0]      wdata_i,
    input  logic                       re_i,
    input  logic [ADDR_WIDTH-1:0]      raddr_i,
    output logic [DATA_WIDTH-1:0]      rdata_o
    );
    logic [DEPTH-1:0][DATA_WIDTH-1:0] ram;
    always @(posedge clk_i) begin
        if (we_i) begin
            ram[waddr_i] <= wdata_i;
        end
    end
    always @(posedge clk_i) begin
        if (re_i) begin
            rdata_o <= ram[raddr_i];
        end else begin
            rdata_o <= '0;
        end
    end
endmodule
`begin_keywords "1800-2023"
module abr_1r1w_be_ram #(
     parameter DEPTH      = 64
    ,parameter DATA_WIDTH = 32
    ,parameter STROBE_WIDTH = 8
    ,localparam ADDR_WIDTH = $clog2(DEPTH)
    )
    (
    input  logic                           clk_i,
    input  logic                           we_i,
    input  logic [(DATA_WIDTH/STROBE_WIDTH)-1:0]      wstrobe_i,
    input  logic [ADDR_WIDTH-1:0]          waddr_i,
    input  logic [(DATA_WIDTH/STROBE_WIDTH)-1:0][STROBE_WIDTH-1:0] wdata_i,
    input  logic                           re_i,
    input  logic [ADDR_WIDTH-1:0]          raddr_i,
    output logic [DATA_WIDTH-1:0]          rdata_o
    );
   logic [(DATA_WIDTH/STROBE_WIDTH)-1:0][STROBE_WIDTH-1:0] ram [DEPTH-1:0];
    always @(posedge clk_i) begin
        if (we_i) begin
            for (int i = 0; i < (DATA_WIDTH/STROBE_WIDTH); i++) begin
                if (wstrobe_i[i])
                    ram[waddr_i][i] <= wdata_i[i];
            end
        end
    end
    always @(posedge clk_i) begin
        if (re_i) begin
            rdata_o <= ram[raddr_i];
        end else begin
            rdata_o <= '0;
        end
    end
endmodule
`begin_keywords "1800-2023"
module abr_1r1w_512x4_ram #(
     parameter DEPTH      = 512
    ,parameter DATA_WIDTH = 4
    ,parameter ADDR_WIDTH = $clog2(DEPTH)
    )
    (
    input  logic                       clk_i,
    input  logic                       we_i,
    input  logic [ADDR_WIDTH-1:0]      waddr_i,
    input  logic [DATA_WIDTH-1:0]      wdata_i,
    input  logic                       re_i,
    input  logic [ADDR_WIDTH-1:0]      raddr_i,
    output logic [DATA_WIDTH-1:0]      rdata_o
    );
    logic [DEPTH-1:0][DATA_WIDTH-1:0] ram;
    always @(posedge clk_i) begin
        if (we_i) begin
            ram[waddr_i] <= wdata_i;
        end
    end
    always @(posedge clk_i) begin
        if (re_i) begin
            rdata_o <= ram[raddr_i];
        end
    end
endmodule
`begin_keywords "1800-2023"
module abr_ram_regout #(
     parameter DEPTH      = 64
    ,parameter DATA_WIDTH = 32
    ,parameter NUM_RD_PORTS = 1
    ,parameter NUM_WR_PORTS = 1
    ,parameter ADDR_WIDTH = $clog2(DEPTH)
    )
    (
    input  logic                                    clk_i,
    input  logic                                    zeroize_i,
    input  logic [NUM_WR_PORTS-1:0]                 we_i,
    input  logic [NUM_WR_PORTS-1:0][ADDR_WIDTH-1:0] waddr_i,
    input  logic [NUM_WR_PORTS-1:0][DATA_WIDTH-1:0] wdata_i,
    input  logic [NUM_RD_PORTS-1:0]                 re_i,
    input  logic [NUM_RD_PORTS-1:0][ADDR_WIDTH-1:0] raddr_i,
    output logic [NUM_RD_PORTS-1:0][DATA_WIDTH-1:0] rdata_o,
    output logic [DEPTH-1:0][DATA_WIDTH-1:0]        reg_o
    );
    logic [DEPTH-1:0][DATA_WIDTH-1:0] ram;
    always @(posedge clk_i) begin
        if (zeroize_i) begin
            ram <= '0;
        end
        else begin
            for (int port = 0; port < NUM_WR_PORTS; port++) begin
                if (we_i[port]) begin
                    ram[waddr_i[port]] <= wdata_i[port];
                end
            end
        end
    end
    always @(posedge clk_i) begin
        for (int port = 0; port < NUM_RD_PORTS; port++) begin
            if (re_i[port]) begin
                rdata_o[port] <= ram[raddr_i[port]];
            end
        end
    end
    assign reg_o = ram;
endmodule
`begin_keywords "1800-2023"
    module abr_clk_gate (
        input logic clk,
        input logic en,
        output clk_cg
    );
        logic en_lat;
        always_latch begin
            if(!clk) begin
                en_lat = en;
            end
        end
        assign clk_cg = clk && en_lat;
    endmodule
`begin_keywords "1800-2023"
module abr_2ff_sync  #( parameter WIDTH=1,
                             parameter RST_VAL=0)
    (
    input logic clk,
    input logic rst_b,
    input logic [WIDTH-1:0] din,
    output logic [WIDTH-1:0] dout
);
logic din_ff;
always_ff@(posedge clk or negedge rst_b) begin
    if(!rst_b) begin
        dout <= RST_VAL;
        din_ff <= RST_VAL;
    end
    else begin 
        din_ff <= din;
        dout <= din_ff;
    end
end
endmodule
`begin_keywords "1800-2023"
module abr_piso_multi #(
  parameter int NUM_MODES = 5,
  parameter int PISO_BUFFER_W = 1344,
  parameter int PISO_PTR_W = $clog2(PISO_BUFFER_W),
  parameter int PISO_ACT_INPUT_RATE = 1088,
  parameter int PISO_ACT_OUTPUT_RATE = 80,
  parameter int INPUT_RATES [NUM_MODES] = '{1088, 1088, 1088, 1088, 1088},
  parameter int OUTPUT_RATES[NUM_MODES] = '{80, 80, 80, 80, 80}
)(
  input  logic                          clk,
  input  logic                          rst_b,
  input  logic                          zeroize,
  input  logic [$clog2(NUM_MODES)-1:0]  mode,
  input  logic                          valid_i,
  output logic                          hold_o,
  input  logic [PISO_ACT_INPUT_RATE-1:0] data_i,
  output logic                          valid_o,
  input  logic                          hold_i,
  output logic [PISO_ACT_OUTPUT_RATE-1:0] data_o
);
  localparam BUFFER_W_DELTA = PISO_BUFFER_W - PISO_ACT_INPUT_RATE;
  logic [PISO_BUFFER_W-1:0] buffer, buffer_d;
  logic [PISO_PTR_W-1:0] buffer_wr_ptr, buffer_wr_ptr_d;
  logic [PISO_PTR_W-1:0] buffer_rw_ptr;
  logic [PISO_PTR_W-1:0] current_input_rate, current_output_rate;
  logic wr_ptr_overflow;
  logic [PISO_BUFFER_W-1:0] buffer_wdata;
  logic [PISO_BUFFER_W-1:0] buffer_wdata_mask;
  logic buffer_wr, buffer_rd;
  logic update_buffer;
  always_comb begin
    current_input_rate  = INPUT_RATES[mode][PISO_PTR_W-1:0];
    current_output_rate = OUTPUT_RATES[mode][PISO_PTR_W-1:0];
  end
  always_comb hold_o  = buffer_rd ? buffer_wr_ptr > PISO_PTR_W'(PISO_BUFFER_W[PISO_PTR_W-1:0] - current_input_rate + current_output_rate):
                                    buffer_wr_ptr > PISO_PTR_W'(PISO_BUFFER_W[PISO_PTR_W-1:0] - current_input_rate);
  always_comb data_o  = buffer[PISO_ACT_OUTPUT_RATE-1:0];
  always_comb valid_o = buffer_wr_ptr >= current_output_rate;
  always_comb buffer_wr = valid_i & ~hold_o;
  always_comb buffer_rd = valid_o & ~hold_i;
  always_comb update_buffer = buffer_rd | buffer_wr;
  always_ff @(posedge clk or negedge rst_b) begin
    if (!rst_b) begin
      buffer <= '0;
      buffer_wr_ptr <= '0;
    end else if (zeroize) begin
      buffer <= '0;
      buffer_wr_ptr <= '0;
    end else if (update_buffer) begin
      buffer <= buffer_d;
      buffer_wr_ptr <= buffer_wr_ptr_d;
    end
  end
  always_comb begin
    wr_ptr_overflow = 1'b0;
    unique case ({buffer_rd, buffer_wr})
      2'b00 : buffer_wr_ptr_d = buffer_wr_ptr;
      2'b01 : {wr_ptr_overflow, buffer_wr_ptr_d} = buffer_wr_ptr + current_input_rate;
      2'b10 : {wr_ptr_overflow, buffer_wr_ptr_d} = buffer_wr_ptr - current_output_rate;
      2'b11 : {wr_ptr_overflow, buffer_wr_ptr_d} = buffer_wr_ptr + (current_input_rate - current_output_rate);
      default : buffer_wr_ptr_d = buffer_wr_ptr;
    endcase
  end
  always_comb buffer_rw_ptr = buffer_wr_ptr - current_output_rate;
  always_comb begin
    buffer_wdata = '0;
    buffer_wdata_mask = '1;
    buffer_wdata_mask = PISO_BUFFER_W'(buffer_wdata_mask >> (PISO_BUFFER_W[PISO_PTR_W-1:0] - current_input_rate));
    buffer_wdata = {{BUFFER_W_DELTA{1'b0}}, data_i} & buffer_wdata_mask;
  end
  always_comb begin
    unique case ({buffer_rd, buffer_wr})
      2'b00 : buffer_d = buffer;
      2'b10 : buffer_d = PISO_BUFFER_W'(buffer >> current_output_rate);
      2'b01 : buffer_d = PISO_BUFFER_W'(buffer_wdata << buffer_wr_ptr) | buffer;
      2'b11 : buffer_d = PISO_BUFFER_W'(buffer_wdata << (buffer_rw_ptr)) |
                         PISO_BUFFER_W'(buffer >> current_output_rate);
      default : buffer_d = buffer;
    endcase
  end
endmodule
`begin_keywords "1800-2023"
module abr_piso
  #( parameter PISO_BUFFER_W    = 1344
    ,parameter PISO_PTR_W = $clog2(PISO_BUFFER_W)
    ,parameter PISO_INPUT_RATE = 1088
    ,parameter PISO_OUTPUT_RATE = 80
  )
  (
    input logic                          clk,
    input logic                          rst_b,
    input logic                          zeroize,
    input  logic                             valid_i,
    output logic                             hold_o,
    input  logic [PISO_INPUT_RATE-1:0]   data_i,
    output logic                             valid_o,
    input  logic                             hold_i,
    output logic [PISO_OUTPUT_RATE-1:0]  data_o
  );
  parameter BUFFER_W_DELTA = PISO_BUFFER_W - PISO_INPUT_RATE;
  logic [PISO_BUFFER_W-1:0] buffer, buffer_d;
  logic [PISO_PTR_W-1:0] buffer_wr_ptr, buffer_wr_ptr_d;
  logic [PISO_PTR_W-1:0] current_input_rate, current_output_rate;
  logic buffer_wr, buffer_rd;
  logic update_buffer;
  always_comb current_input_rate = PISO_INPUT_RATE;
  always_comb current_output_rate = PISO_OUTPUT_RATE;
  always_comb hold_o = buffer_wr_ptr > (PISO_BUFFER_W[PISO_PTR_W-1:0] - current_input_rate);
  always_comb data_o = buffer[PISO_OUTPUT_RATE-1:0];
  always_comb valid_o = buffer_wr_ptr >= current_output_rate;
  always_comb buffer_wr = valid_i & ~hold_o;
  always_comb buffer_rd = valid_o & ~hold_i;
  always_comb update_buffer = buffer_rd | buffer_wr;
  always_ff @(posedge clk or negedge rst_b) begin
    if (!rst_b) begin
      buffer <= '0;
      buffer_wr_ptr <= '0;
    end else if (zeroize) begin
      buffer <= '0;
      buffer_wr_ptr <= '0;
    end else if (update_buffer) begin
      buffer <= buffer_d;
      buffer_wr_ptr <= buffer_wr_ptr_d;
    end 
  end
  always_comb begin
    unique case ({buffer_rd, buffer_wr}) 
      2'b00 : buffer_wr_ptr_d = buffer_wr_ptr;
      2'b01 : buffer_wr_ptr_d = buffer_wr_ptr + current_input_rate;
      2'b10 : buffer_wr_ptr_d = buffer_wr_ptr - current_output_rate;
      2'b11 : buffer_wr_ptr_d = buffer_wr_ptr + (current_input_rate - current_output_rate);
      default : buffer_wr_ptr_d = buffer_wr_ptr;
    endcase
  end
  logic [PISO_BUFFER_W-1:0] buffer_wdata;
  logic [PISO_BUFFER_W-1:0] buffer_wdata_mask;
  always_comb begin
    buffer_wdata = '0;
    buffer_wdata_mask = '1;
    buffer_wdata_mask = PISO_BUFFER_W'(buffer_wdata_mask >> (PISO_BUFFER_W[PISO_PTR_W-1:0] - current_input_rate));
    buffer_wdata = {{BUFFER_W_DELTA{1'b0}},data_i} & buffer_wdata_mask;
  end
  always_comb begin
    unique case ({buffer_rd, buffer_wr})
      2'b00 : buffer_d = buffer;
      2'b10 : buffer_d = PISO_BUFFER_W'(buffer >> current_output_rate);
      2'b01 : buffer_d = PISO_BUFFER_W'(buffer_wdata << buffer_wr_ptr) | buffer;
      2'b11 : buffer_d = PISO_BUFFER_W'(buffer_wdata << (buffer_wr_ptr - current_output_rate)) | PISO_BUFFER_W'(buffer >> current_output_rate);
      default : buffer_d = buffer;
    endcase
  end
endmodule
`begin_keywords "1800-2023"
module abr_sample_buffer
  #(
   parameter NUM_WR = 5
  ,parameter NUM_RD  = 4
  ,parameter BUFFER_DATA_W = 32
  ,localparam BUFFER_DEPTH = (NUM_WR + NUM_RD)
  ,localparam BUF_W = BUFFER_DEPTH*BUFFER_DATA_W
  )
  (
  input logic clk,
  input logic rst_b,
  input logic zeroize,
  input  logic [NUM_WR-1:0]                    data_valid_i,
  input  logic [NUM_WR-1:0][BUFFER_DATA_W-1:0] data_i,
  output logic                                 buffer_full_o,
  output logic                                 data_valid_o,
  output logic [NUM_RD-1:0][BUFFER_DATA_W-1:0] data_o
  );
  logic buffer_rd, buffer_wr;
  logic update_buffer;
  logic [BUFFER_DEPTH-1:0][BUFFER_DATA_W-1:0] buffer_wr_data, buffer_wr_data_shift;
  logic [BUFFER_DEPTH-1:0] buffer_wr_valid, buffer_wr_valid_shift;
  logic [BUFFER_DEPTH-1:0] buffer_valid, buffer_valid_d, buffer_valid_shift;
  logic [BUFFER_DEPTH-1:0][BUFFER_DATA_W-1:0] buffer, buffer_d, buffer_shift;
  logic [$clog2(BUFFER_DEPTH):0] num_valid;
  generate
    if (NUM_WR == NUM_RD)  always_comb buffer_full_o = '0;
    else                   always_comb buffer_full_o = buffer_valid[(BUFFER_DEPTH-(NUM_WR-NUM_RD))];
  endgenerate
  always_comb buffer_rd = buffer_valid[NUM_RD-1]; 
  always_comb buffer_wr = (|data_valid_i) & ~buffer_full_o;
  always_comb update_buffer = buffer_rd | buffer_wr;
  always_comb begin
    num_valid = '0;
    for (int i = 0; i < BUFFER_DEPTH; i++) begin
      if (buffer_valid[i] == 1'b1) num_valid += 1'b1;
    end
  end
  logic [$clog2(BUFFER_DEPTH)-1:0] sample_wr_ptr;
  always_comb begin
    sample_wr_ptr = '0;
    buffer_wr_data = '0;
    buffer_wr_valid = '0;
    for (int sample = 0; sample < NUM_WR; sample++) begin
      if (data_valid_i[sample]) begin
        buffer_wr_data[sample_wr_ptr] = data_i[sample][BUFFER_DATA_W-1:0];
        buffer_wr_valid[sample_wr_ptr] = 1'b1;
        sample_wr_ptr += 1;
      end
    end
    buffer_wr_data_shift = buffer_rd ? buffer_wr_data << (num_valid - NUM_RD)*BUFFER_DATA_W : 
                                       buffer_wr_data << (num_valid)*BUFFER_DATA_W;
    buffer_wr_valid_shift = buffer_wr ?
                            (buffer_rd ? buffer_wr_valid << (num_valid - NUM_RD) :
                                         buffer_wr_valid << (num_valid)) : '0;
  end
  always_comb begin
    buffer_shift = buffer_rd ? BUF_W'(buffer >> (NUM_RD*BUFFER_DATA_W)) : buffer;
    buffer_valid_shift = buffer_rd ? BUFFER_DEPTH'(buffer_valid >> NUM_RD) : buffer_valid;
    buffer_d = buffer_shift | buffer_wr_data_shift;
    buffer_valid_d = buffer_valid_shift | buffer_wr_valid_shift;
  end
  always_ff @(posedge clk or negedge rst_b) begin
    if (!rst_b) begin
      buffer <= '0;
      buffer_valid <= '0;
    end else if (zeroize) begin
      buffer <= '0;
      buffer_valid <= '0;
    end else if (update_buffer) begin
      buffer <= buffer_d;
      buffer_valid <= buffer_valid_d;
    end 
  end
  always_comb data_valid_o = buffer_rd & ~zeroize;
  always_comb data_o = buffer[NUM_RD-1:0];
endmodule
`begin_keywords "1800-2023"
module abr_msg_buffer
  #(
   parameter NUM_WR = 5
  ,parameter NUM_RD  = 4
  ,parameter BUFFER_DATA_W = 32
  ,localparam BUFFER_DEPTH = (NUM_WR + NUM_RD)
  ,localparam BUF_W = BUFFER_DEPTH*BUFFER_DATA_W
  )
  (
  input logic clk,
  input logic rst_b,
  input logic flush,
  input  logic [NUM_WR-1:0]                    data_valid_i,
  input  logic [NUM_WR-1:0][BUFFER_DATA_W-1:0] data_i,
  output logic                                 buffer_full_o,
  output logic [NUM_RD-1:0]                    data_valid_o,
  input  logic                                 data_hold_i,
  output logic [NUM_RD-1:0][BUFFER_DATA_W-1:0] data_o
  );
  logic buffer_rd, buffer_wr;
  logic update_buffer;
  logic [BUFFER_DEPTH-1:0][BUFFER_DATA_W-1:0] buffer_wr_data, buffer_wr_data_shift;
  logic [BUFFER_DEPTH-1:0] buffer_wr_valid, buffer_wr_valid_shift;
  logic [BUFFER_DEPTH-1:0] buffer_valid, buffer_valid_d, buffer_valid_shift;
  logic [BUFFER_DEPTH-1:0][BUFFER_DATA_W-1:0] buffer, buffer_d, buffer_shift;
  logic [$clog2(BUFFER_DEPTH):0] num_valid;
  generate
    if (NUM_WR <= NUM_RD) always_comb buffer_full_o = buffer_valid[BUFFER_DEPTH-NUM_WR] & ~buffer_rd;
    else                  always_comb buffer_full_o = buffer_rd ? buffer_valid[(BUFFER_DEPTH-(NUM_WR-NUM_RD))] :
                                                      buffer_valid[BUFFER_DEPTH-NUM_WR];
  endgenerate
  always_comb buffer_rd = ~data_hold_i & (buffer_valid[NUM_RD-1] | (flush & buffer_valid[0])); 
  always_comb buffer_wr = (|data_valid_i) & ~buffer_full_o;
  always_comb update_buffer = buffer_rd | buffer_wr;
  always_comb begin
    num_valid = '0;
    for (int i = 0; i < BUFFER_DEPTH; i++) begin
      if (buffer_valid[i] == 1'b1) num_valid += 1'b1;
    end
  end
  always_comb begin
    buffer_wr_data = '0;
    buffer_wr_valid = '0;
    for (int sample = 0; sample < NUM_WR; sample++) begin
      buffer_wr_data[sample] = data_valid_i[sample] ? data_i[sample][BUFFER_DATA_W-1:0] : '0;
      buffer_wr_valid[sample] = data_valid_i[sample];
    end
  end
  always_comb begin
    buffer_wr_data_shift = buffer_rd ? buffer_wr_data << (num_valid - NUM_RD)*BUFFER_DATA_W : 
                                       buffer_wr_data << (num_valid)*BUFFER_DATA_W;
    buffer_wr_valid_shift = buffer_wr ?
                            (buffer_rd ? buffer_wr_valid << (num_valid - NUM_RD) :
                                         buffer_wr_valid << (num_valid)) : '0;
  end
  always_comb begin
    buffer_shift = buffer_rd ? BUF_W'(buffer >> (NUM_RD*BUFFER_DATA_W)) : buffer;
    buffer_valid_shift = buffer_rd ? BUFFER_DEPTH'(buffer_valid >> NUM_RD) : buffer_valid;
    buffer_d = buffer_shift | buffer_wr_data_shift;
    buffer_valid_d = buffer_valid_shift | buffer_wr_valid_shift;
  end
  always_ff @(posedge clk or negedge rst_b) begin
    if (!rst_b) begin
      buffer <= '0;
      buffer_valid <= '0;
    end else if (update_buffer) begin
      buffer <= buffer_d;
      buffer_valid <= buffer_valid_d;
    end 
  end
  always_comb data_valid_o = buffer_valid[NUM_RD-1:0];
  always_comb data_o = buffer[NUM_RD-1:0];
endmodule
`begin_keywords "1800-2023"
module abr_rd_lat_buffer
  #(
   parameter WR_WIDTH = 128
  ,parameter RD_WIDTH = 64
  ,parameter BUFFER_DEPTH = WR_WIDTH + RD_WIDTH
  )
  (
  input logic clk,
  input logic rst_b,
  input logic zeroize,
  input  logic                data_valid_i,
  input  logic [WR_WIDTH-1:0] data_i,
  output logic                data_valid_o,
  output logic [RD_WIDTH-1:0] data_o
  );
  logic buffer_rd, buffer_wr;
  logic update_buffer;
  logic [BUFFER_DEPTH-1:0] buffer, buffer_d, buffer_shift, buffer_wr_data_shift;
  logic [$clog2(BUFFER_DEPTH):0] wr_ptr, wr_ptr_d;
  logic [$clog2(BUFFER_DEPTH):0] rw_ptr;
  always_comb buffer_rd = wr_ptr >= RD_WIDTH;
  always_comb buffer_wr = data_valid_i;
  always_comb update_buffer = buffer_rd | buffer_wr;
  always_comb begin
    if (buffer_wr & buffer_rd)
      wr_ptr_d = wr_ptr + WR_WIDTH - RD_WIDTH;
    else if (buffer_wr)
      wr_ptr_d = wr_ptr + WR_WIDTH;
    else if (buffer_rd)
      wr_ptr_d = wr_ptr - RD_WIDTH;
    else
      wr_ptr_d = wr_ptr;
  end
  always_comb rw_ptr = (wr_ptr - RD_WIDTH);
  always_comb begin
    buffer_wr_data_shift = buffer_wr & buffer_rd ? BUFFER_DEPTH'(data_i << rw_ptr) : 
                           buffer_wr             ? BUFFER_DEPTH'(data_i << wr_ptr) : '0;
    buffer_shift = buffer_rd ? BUFFER_DEPTH'(buffer >> RD_WIDTH) : buffer;
    buffer_d = buffer_shift | buffer_wr_data_shift;
  end
  always_ff @(posedge clk or negedge rst_b) begin
    if (!rst_b) begin
      buffer <= '0;
      wr_ptr <= '0;
    end else if (zeroize) begin
      buffer <= '0;
      wr_ptr <= '0;
    end else if (update_buffer) begin
      buffer <= buffer_d;
      wr_ptr <= wr_ptr_d;
    end 
  end
  always_comb data_valid_o = buffer_rd & ~zeroize;
  always_comb data_o = buffer[RD_WIDTH-1:0];
endmodule
`begin_keywords "1800-2023"
package abr_ahb_defines_pkg;
  parameter ABR_H_OKAY=1'b0;
  parameter ABR_H_ERROR=1'b1;
endpackage
`begin_keywords "1800-2023"
module abr_ahb_slv_sif 
  import abr_ahb_defines_pkg::*; 
  #(
    parameter AHB_DATA_WIDTH = 64
   ,parameter CLIENT_DATA_WIDTH = 32
   ,parameter AHB_ADDR_WIDTH = 32
   ,parameter CLIENT_ADDR_WIDTH = AHB_ADDR_WIDTH
   )
   (
    input logic hclk,
    input logic hreset_n,
    input logic [AHB_ADDR_WIDTH-1:0] haddr_i,
    input logic [AHB_DATA_WIDTH-1:0] hwdata_i,
    input logic hsel_i,
    input logic hwrite_i,
    input logic hready_i,
    input logic [1:0] htrans_i,
    input logic [2:0] hsize_i,
    output logic hresp_o,
    output logic hreadyout_o,
    output logic [AHB_DATA_WIDTH-1:0] hrdata_o,
    output logic                         dv,
    input  logic                         hld,
    input  logic                         err,
    output logic                         write,
    output logic [CLIENT_DATA_WIDTH-1:0] wdata,
    output logic [CLIENT_ADDR_WIDTH-1:0] addr,
    input  logic [CLIENT_DATA_WIDTH-1:0] rdata
   );
logic err_f;
localparam BITS_WDATA = $bits(wdata);
generate 
    if ((AHB_DATA_WIDTH == 32) & (CLIENT_DATA_WIDTH == 32)) begin
        always_comb begin
            unique case (hsize_i) inside
                3'b000:   
                    wdata = {{BITS_WDATA-8{1'b0}},hwdata_i[7:0]};
                3'b001:   
                    wdata = {{BITS_WDATA-16{1'b0}},hwdata_i[15:0]};
                3'b010:   
                    wdata = hwdata_i[31:0];
                default:  
                wdata = hwdata_i[31:0];
            endcase
        end
        always_comb hrdata_o = rdata;
    end else if ((AHB_DATA_WIDTH == 64) & (CLIENT_DATA_WIDTH == 32)) begin
        always_comb begin
            unique case (hsize_i) inside
                3'b000:   
                    wdata = addr[2] ? {{BITS_WDATA-8{1'b0}},hwdata_i[39:32]} : {{BITS_WDATA-8{1'b0}},hwdata_i[7:0]};
                3'b001:   
                    wdata = addr[2] ? {{BITS_WDATA-16{1'b0}},hwdata_i[47:32]} : {{BITS_WDATA-16{1'b0}},hwdata_i[15:0]};
                3'b010:   
                    wdata = addr[2] ? hwdata_i[63:32] : hwdata_i[31:0];
                default:  
                wdata = addr[2] ? hwdata_i[63:32] : hwdata_i[31:0];
            endcase
        end
        always_comb hrdata_o = addr[2] ? {rdata, 32'b0} : {32'b0, rdata};
    end else if ((AHB_DATA_WIDTH == 64) & (CLIENT_DATA_WIDTH == 64)) begin
        always_comb begin
            unique case (hsize_i) inside
                3'b000:   
                    wdata = {{BITS_WDATA-8{1'b0}},hwdata_i[7:0]};
                3'b001:   
                    wdata = {{BITS_WDATA-16{1'b0}},hwdata_i[15:0]};
                3'b010:   
                    wdata = addr[2]? hwdata_i[63:32] : hwdata_i[31:0];
                3'b011:  
                    wdata = hwdata_i;
                default:  
                    wdata = hwdata_i;
            endcase
        end
        always_comb hrdata_o = rdata;
    end 
endgenerate
    always_ff @(posedge hclk or negedge hreset_n) begin
        if(!hreset_n) begin
            dv <= 1'b0;
            write <= 1'b0;
            addr <= '0;
            err_f <= '0;
        end
        else begin
            err_f <= err;
            if (hready_i) begin
                dv <= hsel_i & htrans_i inside {2'b10, 2'b11};
            end
            if(hready_i & hsel_i) begin
                addr <= haddr_i[CLIENT_ADDR_WIDTH-1:0];
                write <= hwrite_i & |htrans_i;
            end
        end
    end
always_comb begin : response_block
    hreadyout_o = 1'b1;
    hresp_o = ABR_H_OKAY;
    if (err & ~err_f) begin
        hreadyout_o = 1'b0;
        hresp_o = ABR_H_ERROR;
    end else if (hld) begin
        hreadyout_o = 1'b0;
        hresp_o = ABR_H_OKAY;
    end else if (err_f) begin
        hreadyout_o = 1'b1;
        hresp_o = ABR_H_ERROR;
    end
end
endmodule
`begin_keywords "1800-2023"
 module abr_masked_AND
    (
        input wire clk,              
        input wire rst_n,            
        input wire zeroize,          
        input wire [1:0] x,          
        input wire [1:0] y,          
        input wire rnd,              
        output logic [1:0] c         
    );
    logic [3:0] calculation;
    logic [3:0] resharing;
    always_comb begin
        calculation[0] = x[0] & y[0];  
        calculation[1] = x[0] & y[1];  
        calculation[2] = x[1] & y[0];  
        calculation[3] = x[1] & y[1];  
    end
    always_ff @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            for (int i = 0; i < 4; i++) begin
                resharing[i] <= 1'b0;
            end
        end
        else if (zeroize) begin
            for (int i = 0; i < 4; i++) begin
                resharing[i] <= 1'b0;
            end
        end
        else begin
            resharing[0] <= calculation[0];          
            resharing[1] <= calculation[1] ^ rnd;    
            resharing[2] <= calculation[2] ^ rnd;    
            resharing[3] <= calculation[3];          
        end
    end
    always_comb begin
        c[0] = resharing[0] ^ resharing[1];      
        c[1] = resharing[2] ^ resharing[3];      
    end
endmodule: abr_masked_AND
`begin_keywords "1800-2023"
module abr_delay_masked_shares
#(
    parameter WIDTH = 46,   
    parameter N = 5         
)
(
    input  wire clk,
    input  wire rst_n,
    input  wire zeroize,
    input  wire [1:0] input_reg [WIDTH-1:0],  
    output logic [1:0] delayed_reg [WIDTH-1:0]  
);
    logic [N-1:0][WIDTH-1:0][1:0] shift_reg ;
    always_ff @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            for (int j = 0; j < N; j = j + 1) begin
                shift_reg[j] <= '0;
            end
        end
        else if (zeroize) begin
            for (int j = 0; j < N; j = j + 1) begin
                shift_reg[j] <= '0;
            end
        end
        else begin
            for (int j = 0; j < N-1; j = j + 1) begin
                shift_reg[j+1] <= shift_reg[j];
            end
            for (int i = 0; i < WIDTH; i = i + 1) begin
                shift_reg[0][i] <= input_reg[i];
            end
        end
    end
    always_comb begin
        for (int i = 0; i < WIDTH; i = i + 1) begin
            delayed_reg[i] = shift_reg[N-1][i];
        end
    end
endmodule: abr_delay_masked_shares
`begin_keywords "1800-2023"
module abr_masked_add_sub_mod_Boolean #(
    parameter WIDTH      = 23,
    parameter PRIME = 23'd8380417
    )
    (
    input wire           clk,
    input wire           rst_n,
    input wire           zeroize,
    input logic [3*WIDTH-1:0] rnd,
    input  wire        sub_i,
    input  wire  [1:0] opa_i_masked [WIDTH-1:0],
    input  wire  [1:0] opb_i_masked [WIDTH-1:0],
    output logic [1:0] res_o_masked [WIDTH-1:0]
);
    logic  [1:0] opa_i_masked_padded [WIDTH:0];
    logic  [1:0] opb_i_masked_padded [WIDTH:0];
    logic  [1:0] opa_2_masked_padded [WIDTH:0];
    logic  [1:0] prime [WIDTH:0];
    logic  [1:0] r0_c0 [WIDTH:0];
    logic  [1:0] r1_c1 [WIDTH:0];
    logic  [1:0] r0_c0_delayed [WIDTH:0];
    always_comb begin
        for (int i = 0; i < WIDTH; i = i + 1) begin
            opa_i_masked_padded[i]  = opa_i_masked[i];
            if (sub_i) begin
                opb_i_masked_padded[i][0]   = opb_i_masked[i][0];
                opb_i_masked_padded[i][1]   = ~opb_i_masked[i][1];
                prime[i]                    = {1'b0, PRIME[i]};
            end
            else begin
                opb_i_masked_padded[i]      = opb_i_masked[i];
                prime[i]                    = {1'b0, ~PRIME[i]};
            end
        end
        opa_i_masked_padded[WIDTH] = 2'b00;
        opb_i_masked_padded[WIDTH] = 2'b00;
        prime[WIDTH] = 2'b00;
    end
    always_comb begin
        for (int i = 0; i < WIDTH; i = i + 1) begin
            opa_2_masked_padded[i] = r0_c0[i];
        end
        opa_2_masked_padded[WIDTH] = 2'b00;
    end
    abr_masked_N_bit_Boolean_sub #(
        .WIDTH(WIDTH+1)
    ) r0_sub_or_add (
        .clk(clk),
        .rst_n(rst_n),
        .zeroize(zeroize),
        .sub_i(sub_i),
        .x(opa_i_masked_padded),
        .y(opb_i_masked_padded),
        .rnd(rnd[WIDTH:0]),
        .s(r0_c0)
    );
    abr_delay_masked_shares #(
        .WIDTH(WIDTH+1),
        .N(WIDTH+3)  
    ) delay_r0_c0 (
        .clk(clk),
        .rst_n(rst_n),
        .zeroize(zeroize),
        .input_reg(r0_c0),
        .delayed_reg(r0_c0_delayed)
    );
    abr_masked_N_bit_Boolean_sub #(
        .WIDTH(WIDTH+1)
    ) r1_sub_or_add (
        .clk(clk),
        .rst_n(rst_n),
        .zeroize(zeroize),
        .sub_i(~sub_i),
        .x(opa_2_masked_padded),
        .y(prime),
        .rnd(rnd[WIDTH:0]),
        .s(r1_c1)
    );
    abr_masked_MUX #(
        .WIDTH(WIDTH)
    ) r0_MUX_r0 (
        .clk(clk),
        .rst_n(rst_n),
        .zeroize(zeroize),
        .sub_i(sub_i),
        .carry0(r0_c0_delayed[WIDTH]),
        .carry1(r1_c1[WIDTH]),
        .r0(r0_c0_delayed[WIDTH-1:0]),
        .r1(r1_c1[WIDTH-1:0]),
        .rnd_xor(rnd[WIDTH*2-1:WIDTH]),
        .rnd_and(rnd[WIDTH*3-1:2*WIDTH]),
        .res_o_masked(res_o_masked)
    );
endmodule: abr_masked_add_sub_mod_Boolean
`begin_keywords "1800-2023"
module abr_masked_MUX #(
    parameter WIDTH = 23
)(
    input wire                  clk,          
    input wire                  rst_n,        
    input wire                  zeroize,      
    input wire                  sub_i,        
    input wire  [1:0]           carry0,       
    input wire  [1:0]           carry1,       
    input wire  [1:0]           r0 [WIDTH-1:0],  
    input wire  [1:0]           r1 [WIDTH-1:0],  
    input wire  [WIDTH-1:0]     rnd_xor,      
    input wire  [WIDTH-1:0]     rnd_and,      
    output logic [1:0]          res_o_masked [WIDTH-1:0]  
);
    logic [1:0] s;
    logic [1:0] c0c1;
    logic [1:0] xy [WIDTH-1:0];
    logic [1:0] xyk [WIDTH-1:0];
    logic [1:0] xy_and_s [WIDTH-1:0];
    logic [1:0] r1_k [WIDTH-1:0];
    logic [1:0] r1_delayed [WIDTH-1:0];
    always_comb begin
        if (sub_i) begin
            s = carry0;
            c0c1 = 2'h0; /*verilator */
        end
        else begin
            c0c1 = carry0 ^ carry1;
            s[0] = ~c0c1[0];
            s[1] = c0c1[1];
        end
    end
    always_comb begin /*verilator */
        for (int i = 0; i < WIDTH; i++) begin
            xy[i] = r0[i] ^ r1[i];
            xyk[i][0] = xy[i][0] ^ rnd_xor[i];
            xyk[i][1] = xy[i][1] ^ rnd_xor[i];
            r1_k[i][0] = r1[i][0] ^ rnd_xor[i];
            r1_k[i][1] = r1[i][1] ^ rnd_xor[i];
        end
    end
    genvar i_AND;
    generate
        for (i_AND = 0; i_AND < WIDTH; i_AND = i_AND + 1) begin : gen_DOM_AND
            abr_masked_AND and_gate_inst (
                .clk(clk),
                .rst_n(rst_n),
                .zeroize(zeroize),
                .x(xyk[i_AND]),
                .y(s),
                .rnd(rnd_and[i_AND]),
                .c(xy_and_s[i_AND])
            );
        end
    endgenerate
    abr_delay_masked_shares #(
        .WIDTH(WIDTH),
        .N(1)  
    ) delay_r1_k (
        .clk(clk),
        .rst_n(rst_n),
        .zeroize(zeroize),
        .input_reg(r1_k),
        .delayed_reg(r1_delayed)
    );
    always_ff @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            for (int i = 0; i < WIDTH; i++) begin
                res_o_masked[i] <= 2'b0;
            end
        end
        else if (zeroize) begin
            for (int i = 0; i < WIDTH; i++) begin
                res_o_masked[i] <= 2'b0;
            end
        end
        else begin
            for (int i = 0; i < WIDTH; i++) begin
                res_o_masked[i] <= xy_and_s[i] ^ r1_delayed[i];
            end
        end
    end
endmodule: abr_masked_MUX
`begin_keywords "1800-2023"
module abr_masked_N_bit_Boolean_sub #(
    parameter WIDTH = 8  
)(
    input wire clk,                     
    input wire rst_n,                   
    input wire zeroize,                 
    input wire sub_i,
    input wire [1:0] x [WIDTH-1:0],     
    input wire [1:0] y [WIDTH-1:0],     
    input wire [WIDTH-1:0] rnd,         
    output logic [1:0] s [WIDTH-1:0]
);
    logic  [WIDTH:0] [1:0] carry;  
    logic  [WIDTH-1:0] [1:0] sum;  
    logic  [WIDTH-1:0][WIDTH-1:0][1:0] x_reg;  
    logic  [WIDTH-1:0][WIDTH-1:0][1:0] y_reg;  
    logic  [WIDTH-1:0][WIDTH-1:0][1:0] sum_reg;  
    logic [1:0] the_last_sum;
    assign carry[0] = sub_i ? 2'b01 : 2'b00;
    genvar g_i;
    generate
        for (g_i = 0; g_i < WIDTH; g_i = g_i + 1) begin : gen_full_adders
            always_ff @(posedge clk or negedge rst_n) begin
                if (!rst_n) begin
                    x_reg[g_i] <= '0;
                    y_reg[g_i] <= '0;
                end
                else if (zeroize) begin
                    x_reg[g_i] <= '0;
                    y_reg[g_i] <= '0;
                end
                else begin
                    for (int j = 0; j < WIDTH; j = j + 1) begin
                        if (j == 0) begin
                            x_reg[g_i][j] <= x[g_i];
                            y_reg[g_i][j] <= y[g_i];
                        end
                        else begin
                            x_reg[g_i][j] <= x_reg[g_i][j-1];
                            y_reg[g_i][j] <= y_reg[g_i][j-1];
                        end
                    end
                end
            end
            always_ff @(posedge clk or negedge rst_n) begin
                if (!rst_n) begin
                    sum_reg[g_i] <= '0;
                end
                else if (zeroize) begin
                    sum_reg[g_i] <= '0;
                end
                else begin
                    for (int j = g_i; j < WIDTH; j = j + 1) begin
                        if (j == g_i && g_i == WIDTH-1) begin
                            sum_reg[g_i][j] <= the_last_sum;
                        end
                        else if (j == g_i) begin
                            sum_reg[g_i][j] <= sum[g_i];
                        end
                        else begin
                            sum_reg[g_i][j] <= sum_reg[g_i][j-1];
                        end
                    end
                end
            end
            if (g_i<(WIDTH-1)) begin : gen_masked_full_adder
                abr_masked_full_adder u_abr_masked_full_adder (
                    .clk(clk),               
                    .rst_n(rst_n),           
                    .zeroize(zeroize),       
                    .x(x_reg[g_i][g_i]),         
                    .y(y_reg[g_i][g_i]),         
                    .c_in(carry[g_i]),         
                    .rnd(rnd[g_i]),            
                    .s(sum[g_i]),              
                    .c_out(carry[g_i+1])       
                );
            end
        end
    endgenerate
    always_ff @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            the_last_sum    <= 2'b00;
        end
        else if (zeroize) begin
            the_last_sum    <= 2'b00;
        end
        else begin
            the_last_sum <= x_reg[WIDTH-1][WIDTH-1] ^ y_reg[WIDTH-1][WIDTH-1] ^ carry[WIDTH-1];
        end
    end
    always_comb begin
        for (int i =0; i<WIDTH; i++) begin
            s[i] = sum_reg[i][WIDTH-1];
        end
    end
endmodule : abr_masked_N_bit_Boolean_sub
`begin_keywords "1800-2023"
 module abr_masked_full_adder (
    input wire clk,              
    input wire rst_n,            
    input wire zeroize,          
    input wire [1:0] x,          
    input wire [1:0] y,          
    input wire [1:0] c_in,       
    input wire rnd,              
    output logic [1:0] s,        
    output logic [1:0] c_out     
);
    logic [1:0] sum_comb;
    logic [1:0] and_opr1;
    logic [1:0] and_opr2;
    logic [1:0] and_out;
    always_comb begin : calculate_sum
        for (int i = 0; i < 2; i++) begin
            and_opr1[i] = x[i] ^ y[i];
            and_opr2[i] = x[i] ^ c_in[i];
            sum_comb[i] = and_opr1[i] ^ c_in[i];
        end
    end
    abr_masked_AND u_abr_masked_AND (
        .clk(clk),         
        .rst_n(rst_n),     
        .zeroize(zeroize), 
        .x(and_opr1),      
        .y(and_opr2),      
        .rnd(rnd),         
        .c(and_out)        
    );
    logic [1:0] buffered_x;
    logic [1:0] buffered_sum;
    always_ff @(posedge clk or negedge rst_n) begin : pipeline_inputs
        if (!rst_n) begin
            for (int i = 0; i < 2; i++) begin
                buffered_x[i] <= 1'b0;
                buffered_sum[i] <= 1'b0;
            end
        end
        else if (zeroize) begin
            for (int i = 0; i < 2; i++) begin
                buffered_x[i] <= 1'b0;
                buffered_sum[i] <= 1'b0;
            end
        end
        else begin
            for (int i = 0; i < 2; i++) begin
                buffered_x[i] <= x[i];
                buffered_sum[i] <= sum_comb[i];
            end
        end
    end
    always_comb begin : calculate_carry
        for (int i = 0; i < 2; i++) begin
            s[i] = buffered_sum[i];
            c_out[i] = buffered_x[i] ^ and_out[i];
        end
    end
endmodule : abr_masked_full_adder
`begin_keywords "1800-2023"
 module abr_masked_A2B_conv #(
    parameter WIDTH = 8  
)(
    input wire clk,                                  
    input wire rst_n,                                
    input wire zeroize,                              
    input wire [1:0] x [WIDTH-1:0],                  
    input wire [WIDTH-1:0] rnd,                      
    input wire [WIDTH-1:0] rnd_for_Boolean0,         
    input wire [WIDTH-1:0] rnd_for_Boolean1,         
    output logic [1:0] s [WIDTH-1:0]
);
    logic  [WIDTH:0] [1:0] carry;  
    logic  [WIDTH-1:0] [1:0] sum;  
    logic  [WIDTH-1:0][WIDTH-1:0][1:0] x_reg;  
    logic  [WIDTH-1:0][WIDTH-1:0][1:0] y_reg;  
    logic  [WIDTH-1:0][WIDTH-1:0][1:0] sum_reg;  
    logic [1:0] the_last_sum;
    assign carry[0] = 2'b00;
    genvar g_i;
    generate
        for (g_i = 0; g_i < WIDTH; g_i = g_i + 1) begin : gen_full_adders
            always_ff @(posedge clk or negedge rst_n) begin
                if (!rst_n) begin
                    x_reg[g_i] <= '0;
                    y_reg[g_i] <= '0;
                end
                else if (zeroize) begin
                    x_reg[g_i] <= '0;
                    y_reg[g_i] <= '0;
                end
                else begin
                    for (int j = 0; j < WIDTH; j = j + 1) begin
                        if (j == 0) begin
                            x_reg[g_i][j] <= {rnd_for_Boolean0[g_i], (x[g_i][0] ^ rnd_for_Boolean0[g_i])};
                            y_reg[g_i][j] <= {rnd_for_Boolean1[g_i], (x[g_i][1] ^ rnd_for_Boolean1[g_i])};
                        end
                        else begin
                            x_reg[g_i][j] <= x_reg[g_i][j-1];
                            y_reg[g_i][j] <= y_reg[g_i][j-1];
                        end
                    end
                end
            end
            always_ff @(posedge clk or negedge rst_n) begin
                if (!rst_n) begin
                    sum_reg[g_i] <= '0;
                end
                else if (zeroize) begin
                    sum_reg[g_i] <= '0;
                end
                else begin
                    for (int j = g_i; j < WIDTH; j = j + 1) begin
                        if (j == g_i && g_i == WIDTH-1) begin
                            sum_reg[g_i][j] <= the_last_sum;
                        end
                        else if (j == g_i) begin
                            sum_reg[g_i][j] <= sum[g_i];
                        end
                        else begin
                            sum_reg[g_i][j] <= sum_reg[g_i][j-1];
                        end
                    end
                end
            end
            if (g_i<(WIDTH-1)) begin : gen_masked_full_adder
                abr_masked_full_adder u_abr_masked_full_adder (
                    .clk(clk),               
                    .rst_n(rst_n),           
                    .zeroize(zeroize),       
                    .x(x_reg[g_i][g_i]),         
                    .y(y_reg[g_i][g_i]),         
                    .c_in(carry[g_i]),         
                    .rnd(rnd[g_i]),            
                    .s(sum[g_i]),              
                    .c_out(carry[g_i+1])       
                );
            end
        end
    endgenerate
    always_ff @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            the_last_sum    <= 2'b00;
        end
        else if (zeroize) begin
            the_last_sum    <= 2'b00;
        end
        else begin
            the_last_sum <= x_reg[WIDTH-1][WIDTH-1] ^ y_reg[WIDTH-1][WIDTH-1] ^ carry[WIDTH-1];
        end
    end
    always_comb begin
        for (int i =0; i<WIDTH; i++) begin
            s[i] = sum_reg[i][WIDTH-1];
        end
    end
endmodule : abr_masked_A2B_conv
`begin_keywords "1800-2023"
 module abr_masked_N_bit_Boolean_adder #(
    parameter WIDTH = 8  
)(
    input wire clk,                     
    input wire rst_n,                   
    input wire zeroize,                 
    input wire [1:0] x [WIDTH-1:0],     
    input wire [1:0] y [WIDTH-1:0],     
    input wire [WIDTH-1:0] rnd,         
    output logic [1:0] s [WIDTH-1:0]
);
    logic  [WIDTH:0] [1:0] carry;  
    logic  [WIDTH-1:0] [1:0] sum;  
    logic  [WIDTH-1:0][WIDTH-1:0][1:0] x_reg;  
    logic  [WIDTH-1:0][WIDTH-1:0][1:0] y_reg;  
    logic  [WIDTH-1:0][WIDTH-1:0][1:0] sum_reg;  
    logic [1:0] the_last_sum;
    assign carry[0] = 2'b00;
    genvar g_i;
    generate
        for (g_i = 0; g_i < WIDTH; g_i = g_i + 1) begin : gen_full_adders
            always_ff @(posedge clk or negedge rst_n) begin
                if (!rst_n) begin
                    x_reg[g_i] <= '0;
                    y_reg[g_i] <= '0;
                end
                else if (zeroize) begin
                    x_reg[g_i] <= '0;
                    y_reg[g_i] <= '0;
                end
                else begin
                    for (int j = 0; j < WIDTH; j = j + 1) begin
                        if (j == 0) begin
                            x_reg[g_i][j] <= x[g_i];
                            y_reg[g_i][j] <= y[g_i];
                        end
                        else begin
                            x_reg[g_i][j] <= x_reg[g_i][j-1];
                            y_reg[g_i][j] <= y_reg[g_i][j-1];
                        end
                    end
                end
            end
            always_ff @(posedge clk or negedge rst_n) begin
                if (!rst_n) begin
                    sum_reg[g_i] <= '0;
                end
                else if (zeroize) begin
                    sum_reg[g_i] <= '0;
                end
                else begin
                    for (int j = g_i; j < WIDTH; j = j + 1) begin
                        if (j == g_i && g_i == WIDTH-1) begin
                            sum_reg[g_i][j] <= the_last_sum;
                        end
                        else if (j == g_i) begin
                            sum_reg[g_i][j] <= sum[g_i];
                        end
                        else begin
                            sum_reg[g_i][j] <= sum_reg[g_i][j-1];
                        end
                    end
                end
            end
            if (g_i<(WIDTH-1)) begin : gen_masked_full_adder
                abr_masked_full_adder u_abr_masked_full_adder (
                    .clk(clk),               
                    .rst_n(rst_n),           
                    .zeroize(zeroize),       
                    .x(x_reg[g_i][g_i]),         
                    .y(y_reg[g_i][g_i]),         
                    .c_in(carry[g_i]),         
                    .rnd(rnd[g_i]),            
                    .s(sum[g_i]),              
                    .c_out(carry[g_i+1])       
                );
            end
        end
    endgenerate
    always_ff @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            the_last_sum    <= 2'b00;
        end
        else if (zeroize) begin
            the_last_sum    <= 2'b00;
        end
        else begin
            the_last_sum <= x_reg[WIDTH-1][WIDTH-1] ^ y_reg[WIDTH-1][WIDTH-1] ^ carry[WIDTH-1];
        end
    end
    always_comb begin
        for (int i =0; i<WIDTH; i++) begin
            s[i] = sum_reg[i][WIDTH-1];
        end
    end
endmodule : abr_masked_N_bit_Boolean_adder
`begin_keywords "1800-2023"
 module abr_masked_N_bit_Arith_adder #(
    parameter WIDTH = 8  
)(
    input wire clk,                     
    input wire rst_n,                   
    input wire zeroize,                 
    input wire [1:0][WIDTH-1:0] x,      
    input wire [1:0][WIDTH-1:0] y,      
    output logic [1:0][WIDTH-1:0] s 
);
    logic [1:0][WIDTH-1:0] add_res;
    logic [1:0] s_reg [WIDTH-1:0];
    always_comb begin
        add_res[0] = x[0] + y[0];
        add_res[1] = x[1] + y[1];
    end
    always_ff @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            s <= 'h0;
        end
        else if (zeroize) begin
            s <= 'h0;
        end
        else begin
            s <= add_res;
        end
    end
endmodule : abr_masked_N_bit_Arith_adder
`begin_keywords "1800-2023"
 module abr_masked_B2A_conv #(
    parameter WIDTH = 8  
)(
    input wire               clk,
    input wire               rst_n,
    input wire               zeroize,
    input wire [WIDTH-1:0]   rnd,
    input wire [1:0]         x_boolean [WIDTH-1:0],  
    output logic [1:0]       x_arith [WIDTH-1:0]   
);
    logic unsigned [WIDTH-1:0] T0, T1, T2, A0, A1, A2, Gamma_reg, Gamma_reg2, x0, x1;
    logic unsigned [1:0]       x_arith_next [WIDTH-1:0];
    wire [WIDTH-1:0]   Gamma;
    assign Gamma = rnd;
    always_ff @ (posedge clk or negedge rst_n) begin            
        if (!rst_n) begin
            for (int i = 0; i < WIDTH; i++) begin
                Gamma_reg[i]    <= 'h0;
                x0[i]           <= 'h0;
                x1[i]           <= 'h0;
                x_arith[i]      <= 'h0;
            end
        end
        else if (zeroize) begin
            for (int i = 0; i < WIDTH; i++) begin
                Gamma_reg[i]    <= 'h0;
                x0[i]           <= 'h0;
                x1[i]           <= 'h0;
                x_arith[i]      <= 'h0;
            end
        end
        else begin
            for (int i = 0; i < WIDTH; i++) begin
                Gamma_reg[i]    <= Gamma[i];
                x0[i]           <= x_boolean[i][0];
                x1[i]           <= x_boolean[i][1];
                x_arith[i]      <= x_arith_next[i];
            end
        end
    end
    always_comb begin
            T0               = x0 ^ Gamma_reg;               
            T1               = T0 - Gamma_reg;               
            T2               = T1 ^ x0;                      
            Gamma_reg2       = Gamma_reg ^ x1;               
            A0               = x0 ^ Gamma_reg2;              
            A1               = A0 - Gamma_reg2;              
            A2               = A1 ^ T2;                      
        for (int i = 0; i < WIDTH; i++) begin
            x_arith_next[i][0]  = A2[i];                     
            x_arith_next[i][1]  = x1[i];                     
        end
    end
endmodule
`begin_keywords "1800-2023"
 module abr_masked_N_bit_mult
    #(parameter WIDTH = 8, parameter HALF_WIDTH = WIDTH/2)   
    (
        input wire clk,                       
        input wire rst_n,                     
        input wire zeroize,                   
        input wire [1:0] x [WIDTH-1:0],       
        input wire [HALF_WIDTH-1:0] y ,       
        output logic [1:0] z [WIDTH-1:0]      
    );
    logic  [WIDTH-1:0] calculation [1:0];
    logic [WIDTH-1:0] x0, x1;
    always_comb begin
        for (int i = 0; i < WIDTH; i++) begin
            x0[i] = x[i][0];
            x1[i] = x[i][1];
        end
    end
    always_comb begin
        calculation[0] = x0 * y;  
        calculation[1] = x1 * y;  
    end
    always_ff @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            for (int i = 0; i < WIDTH; i++) begin
                z[i] <= 2'b0;
            end
        end
        else if (zeroize) begin
            for (int i = 0; i < WIDTH; i++) begin
                z[i] <= 2'b0;
            end
        end
        else begin
            for (int i = 0; i < WIDTH; i++) begin
                z[i][0] <= calculation[0][i];  
                z[i][1] <= calculation[1][i];  
            end
        end
    end
endmodule: abr_masked_N_bit_mult
`begin_keywords "1800-2023"
 module abr_masked_N_bit_mult_two_share
    #(parameter WIDTH = 8)   
    (
        input wire clk,                          
        input wire rst_n,                        
        input wire zeroize,                      
        input wire        [WIDTH-1:0] random,    
        input wire   [1:0][WIDTH-1:0] x,         
        input wire   [1:0][WIDTH-1:0] y,         
        output logic [1:0] z [WIDTH-1:0]         
    );
    logic [WIDTH-1:0] calculation [3:0];
    logic [WIDTH-1:0] calculation_reg [1:0];
    logic [WIDTH-1:0] calculation_rand [1:0];
    logic [WIDTH-1:0] final_res [1:0];
    logic [WIDTH-1:0] x0, x1, y0, y1;
    always_comb begin
        calculation[0] = WIDTH'(x[0] * y[0]);  
        calculation[1] = WIDTH'(x[1] * y[0]);  
        calculation[2] = WIDTH'(x[0] * y[1]);  
        calculation[3] = WIDTH'(x[1] * y[1]);  
    end
    always_ff @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            for (int i = 0; i < 2; i++) begin
                calculation_rand[i] <= 'h0;
                calculation_reg[i] <= 'h0;
            end
        end
        else if (zeroize) begin
            for (int i = 0; i < 2; i++) begin
                calculation_rand[i] <= 'h0;
                calculation_reg[i] <= 'h0;
            end
        end
        else begin
            calculation_rand[0] <= calculation[2] + random;
            calculation_rand[1] <= calculation[1] - random;
            calculation_reg[0]  <= calculation[0];
            calculation_reg[1]  <= calculation[3];
        end
    end
    always_comb begin
        final_res[0] = calculation_reg[0] + calculation_rand[0];
        final_res[1] = calculation_reg[1] + calculation_rand[1];
    end
    always_ff @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            for (int i = 0; i < WIDTH; i++)
                z[i] <= 2'h0;
        end
        else if (zeroize) begin
            for (int i = 0; i < WIDTH; i++)
                z[i] <= 2'h0;
        end
        else begin
            for (int i = 0; i < WIDTH; i++) begin
                z[i][0] <= final_res[0][i];
                z[i][1] <= final_res[1][i];
            end
        end
    end
 endmodule: abr_masked_N_bit_mult_two_share
`begin_keywords "1800-2023"
module abr_adder #(
    parameter RADIX          = 8
)
(
    input  wire [RADIX-1:0]  a_i,
    input  wire [RADIX-1:0]  b_i,
    input  wire              cin_i,
    output wire [RADIX-1:0]  s_o,
    output wire              cout_o
);
    logic [RADIX : 0]   s_full;
    always_comb begin
        s_full = a_i + b_i + cin_i;
    end
    assign s_o = s_full[RADIX-1 : 0];
    assign cout_o = s_full[RADIX];
endmodule
`begin_keywords "1800-2023"
module abr_add_sub_mod #(
    parameter REG_SIZE      = 384
    )
    (
    input wire           clk,
    input wire           reset_n,
    input wire           zeroize,
    input  wire                 add_en_i,
    input  wire                 sub_i,
    input  wire  [REG_SIZE-1:0] opa_i,
    input  wire  [REG_SIZE-1:0] opb_i,
    input  wire  [REG_SIZE-1:0] prime_i,
    output logic [REG_SIZE-1:0] res_o,
    output logic                ready_o
);
    logic [REG_SIZE-1 : 0] opb0;
    logic [REG_SIZE-1 : 0] opb1;
    logic [REG_SIZE-1 : 0] r0;
    logic [REG_SIZE-1 : 0] r1;
    logic                  carry0; 
    logic                  sub_n;
    logic [REG_SIZE-1 : 0] r0_reg;
    logic                  carry0_reg;
    logic                  carry1;
    logic [1 : 0]          push_result_reg;
    abr_adder #(
        .RADIX(REG_SIZE)
        ) 
        adder_inst_0(
        .a_i(opa_i),
        .b_i(opb0),
        .cin_i(sub_i),
        .s_o(r0),
        .cout_o(carry0)
    );
    abr_adder #(
        .RADIX(REG_SIZE)
        ) 
        adder_inst_1(
        .a_i(r0_reg),
        .b_i(opb1),
        .cin_i(sub_n),
        .s_o(r1),
        .cout_o(carry1)
    );
    assign opb0 = sub_i ? ~opb_i : opb_i;
    always_ff @(posedge clk or negedge reset_n) 
    begin
        if(!reset_n) begin
            r0_reg <= '0;
            carry0_reg <= '0;
            sub_n <= '0;
            opb1 <= '0;
        end
        else if (zeroize) begin
            r0_reg <= '0;
            carry0_reg <= '0;
            sub_n <= '0;
            opb1 <= '0;
        end
        else if (add_en_i) begin 
            r0_reg <= r0;
            carry0_reg <= carry0;
            sub_n <= !sub_i;
            if (sub_i)
                opb1 <= prime_i;
            else
                opb1 <= ~prime_i;
        end
    end
    always_ff @(posedge clk or negedge reset_n) begin
        if (!reset_n)
            push_result_reg <= 2'b0;
        else if (zeroize)
            push_result_reg <= 2'b0;
        else if (add_en_i)
            push_result_reg <= 2'b10;
        else  
            push_result_reg <= 2'(push_result_reg >> 1);
    end
    assign ready_o = push_result_reg[0];
    assign res_o = sub_n ? (carry0_reg ^ carry1)? r1 : r0_reg : (carry0_reg) ? r0_reg : r1;
endmodule
`begin_keywords "1800-2023"
module abr_ntt_add_sub_mod 
    import abr_params_pkg::*;
    #(
    parameter REG_SIZE      = 384
    )
    (
    input wire           clk,
    input wire           reset_n,
    input wire           zeroize,
    input  wire                 add_en_i,
    input  wire                 sub_i,
    input  wire  [REG_SIZE-1:0] opa_i,
    input  wire  [REG_SIZE-1:0] opb_i,
    input  wire  [REG_SIZE-1:0] prime_i,
    input  wire                 mlkem,
    output logic [REG_SIZE-1:0] res_o,
    output logic                ready_o
);
    logic [REG_SIZE-1 : 0] opb0;
    logic [REG_SIZE-1 : 0] opb1;
    logic [REG_SIZE-1 : 0] r0;
    logic [REG_SIZE-1 : 0] r1;
    logic                  carry0; 
    logic                  carry0_int; 
    logic                  sub_n;
    logic [REG_SIZE-1 : 0] r0_reg;
    logic                  carry0_reg;
    logic                  carry1;
    logic                  carry1_int;
    logic [1 : 0]          push_result_reg;
    abr_adder #(
        .RADIX(REG_SIZE)
        ) 
        adder_inst_0(
        .a_i(opa_i),
        .b_i(mlkem ? {{(REG_SIZE-MLKEM_REG_SIZE){1'b0}}, opb0[MLKEM_REG_SIZE-1:0]} : opb0),
        .cin_i(sub_i),
        .s_o(r0),
        .cout_o(carry0_int)
    );
    abr_adder #(
        .RADIX(REG_SIZE)
        ) 
        adder_inst_1(
        .a_i(mlkem ? {{(REG_SIZE-MLKEM_REG_SIZE){1'b0}}, r0_reg[MLKEM_REG_SIZE-1:0]} : r0_reg),  
        .b_i(mlkem ? {{(REG_SIZE-MLKEM_REG_SIZE){1'b0}}, opb1[MLKEM_REG_SIZE-1:0]} : opb1),
        .cin_i(sub_n),
        .s_o(r1),
        .cout_o(carry1_int)
    );
    assign carry0 = mlkem ? r0[MLKEM_REG_SIZE] : carry0_int;
    assign carry1 = mlkem ? r1[MLKEM_REG_SIZE] : carry1_int;
    assign opb0 = sub_i ? ~opb_i : opb_i;
    always_ff @(posedge clk or negedge reset_n) 
    begin
        if(!reset_n) begin
            r0_reg <= '0;
            carry0_reg <= '0;
            sub_n <= '0;
            opb1 <= '0;
        end
        else if (zeroize) begin
            r0_reg <= '0;
            carry0_reg <= '0;
            sub_n <= '0;
            opb1 <= '0;
        end
        else if (add_en_i) begin 
            r0_reg <= r0;
            carry0_reg <= carry0;
            sub_n <= !sub_i;
            if (sub_i)
                opb1 <= prime_i;
            else
                opb1 <= ~prime_i;
        end
    end
    always_ff @(posedge clk or negedge reset_n) begin
        if (!reset_n)
            push_result_reg <= 2'b0;
        else if (zeroize)
            push_result_reg <= 2'b0;
        else if (add_en_i)
            push_result_reg <= 2'b10;
        else  
            push_result_reg <= 2'(push_result_reg >> 1);
    end
    assign ready_o = push_result_reg[0];
    always_comb begin
        if (mlkem)
            res_o = sub_n ? (carry0_reg ^ carry1)? {{(REG_SIZE-MLKEM_REG_SIZE){1'b0}}, r1[MLKEM_REG_SIZE-1:0]} : {{(REG_SIZE-MLKEM_REG_SIZE){1'b0}}, r0_reg[MLKEM_REG_SIZE-1:0]} : (carry0_reg) ? {{(REG_SIZE-MLKEM_REG_SIZE){1'b0}}, r0_reg[MLKEM_REG_SIZE-1:0]} : {{(REG_SIZE-MLKEM_REG_SIZE){1'b0}}, r1[MLKEM_REG_SIZE-1:0]};
        else
            res_o = sub_n ? (carry0_reg ^ carry1)? r1 : r0_reg : (carry0_reg) ? r0_reg : r1;
    end
endmodule
