package doe_defines_pkg;
  import kv_defines_pkg::*;
  localparam DOE_CORE_NAME        = 64'h20202020_73206165;  
  localparam DOE_CORE_VERSION     = 64'h00000000_3630302e;  
typedef enum logic [3:0] {
    DOE_NOP     = 4'b0000,
    DOE_UDS     = 4'b0001,
    DOE_FE      = 4'b0010,
    DOE_CLEAR   = 4'b0011,
    DOE_HEK     = 4'b0100,
    DOE_INV0    = 4'b0101,  
    DOE_INV1    = 4'b0110,  
    DOE_INV2    = 4'b0111,  
    DOE_RSVD0   = 4'b1000,  
    DOE_INV3    = 4'b1001,  
    DOE_INV4    = 4'b1010,  
    DOE_INV5    = 4'b1011,  
    DOE_RSVD1   = 4'b1100,  
    DOE_INV6    = 4'b1101,  
    DOE_INV7    = 4'b1110,  
    DOE_INV8    = 4'b1111   
} doe_cmd_e;
typedef struct packed {
