        assign write_fill_data[i]        =   bus_ifu_wr_en & (  (pt.IFU_BUS_TAG)'(i)  == ifu_bus_rsp_tag[pt.IFU_BUS_TAG-1:0]);
        rvdffe #(32) byp_data_0_ff (.*,
                                    .en (write_fill_data[i]),
