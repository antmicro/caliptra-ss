`begin_keywords "1800-2023"
module caliptra_axi_sram #(
    parameter AW = 32,
    parameter DW = 64,
              BC = DW/8,        
              BW = $clog2(BC),  
    parameter UW = 32,          
    parameter IW = 1,           
              ID_NUM = 1 << IW,  
    parameter EX_EN = 0     
)
(
    input clk,
    input rst_n,
    axi_if.w_sub s_axi_w_if,
    axi_if.r_sub s_axi_r_if
);
logic          dv;
logic [AW-1:0] addr;  
logic          write;
logic [DW-1:0] wdata;  
logic [DW-1:0] rdata;  
logic          hold;
logic          rd_error;
logic          wr_error;
axi_sub #(
    .AW   (AW   ),
    .DW   (DW   ),
    .UW   (UW   ),
    .IW   (IW   ),
    .EX_EN(EX_EN),
    .C_LAT(1    )
) i_axi_sub (
    .clk  (clk     ),
    .rst_n(rst_n   ),
    .s_axi_w_if(s_axi_w_if),
    .s_axi_r_if(s_axi_r_if),
    .dv      (dv      ),
    .addr    (addr    ),  
    .write   (write   ),
    .user    (        ),
    .id      (        ),
    .wdata   (wdata   ),
    .wstrb   (        ),
    .rdata   (rdata   ),
    .last    (        ),
    .size    (        ),
    .hld     (hold    ),
    .rd_err  (rd_error),
    .wr_err  (wr_error)
);
assign hold = 1'b0;
assign rd_error = 1'b0;
assign wr_error = 1'b0;
caliptra_sram #(
    .DEPTH     (1 << (AW - BW)),  
    .DATA_WIDTH(DW)
) i_sram (
    .clk_i   (clk   ),
    .cs_i    (dv   ),
    .we_i    (write),
    .addr_i  (addr[AW-1:BW]),
    .wdata_i (wdata),
    .rdata_o (rdata)
);
endmodule
