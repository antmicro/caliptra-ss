      {(2*2+2){InvalidTokenIdx}},
        {2{ZeroTokenIdx}},           
        {ProdExitProdEndTokenIdx},       
        {DevExitProdTokenIdx},          
        {TestExitDevTokenIdx},       
        {(7-2){InvalidTokenIdx,    
                 ZeroTokenIdx}},     
        {(2*2+2){InvalidTokenIdx}},
      ZeroTokenIdx,                
